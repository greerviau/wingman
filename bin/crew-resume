#!/usr/bin/env bash
# crew-resume - relaunch a died crew member with `claude --resume <session-id>`,
# preserving its prior conversation, session id, and place in the org tree (the
# roster record is reused as-is, so `parent` never changes and no crew-add /
# tree surgery is needed). The bulk remedy for a mass crew-death event (#22): a
# tmux/host crash takes every session in it down at once, and each one is
# otherwise only recoverable by hand via bin/crew-takeover.
#
# Idempotent: a member that is not currently `died` is skipped, and two
# concurrent or retried resumes of the same id never both relaunch it - an
# mkdir-based atomic claim per id (tmux does not enforce unique window names,
# so a plain check-then-`new-window` would race) makes the loser skip instead.
# Running `--all-died` twice is then naturally a no-op the second time.
#
# Verified, not optimistic: after relaunching, this polls until a wall-clock
# deadline measured from the moment the window was created
# (WM_RESUME_VERIFY_WINDOW, default 20s - an integer) before committing status
# to `working`, not a single fixed-latency sample. tmux destroys a window when
# its pane's process exits (no remain-on-exit), so a `--resume` that fails -
# whether fast (a stale/invalid session id) or only after a delay (a
# slow-settling permission dialog, a delayed API round-trip, or host
# contention from resuming several members at once) - manifests as the window
# vanishing at any point before that deadline, a real, observable signal. On
# that path status is left `died` and nothing is auto-retried; the existing
# manual path (bin/crew-takeover / bin/crew-standdown) is printed instead.
#
# This is a tool wingman/a lead invokes deliberately, never something
# bin/watch-fleet auto-fires: relaunching a session spends real compute (the
# same "spawning is the expensive act" cost-discipline guardrail CLAUDE.md
# already states for a fresh spawn), so the decision to resume stays with
# whoever is supervising, not the watcher loop.
#
# Usage:
#   crew-resume <id> [<id2> ...]             resume the named died member(s)
#   crew-resume --all-died [--owner <id>]    resume every currently-died member
#                                             (optionally scoped to one owner's
#                                             team)
#   --force    proceed even while the fleet outage-state reads "active" (see
#              below) - never inferred, mirrors --force-during-outage on
#              bin/spawn-crew.
#
# Outage-timing guard (issue #23, item 3): refuses (with --force required to
# override) while $WM_HOME/api-outage-state.json reads "active" - resuming
# while 529s are still bursting risks the freshly-relaunched session dying
# again immediately, the exact risk issue #23's own comment names. This is
# defense in depth for a HUMAN running this by hand; the automated path
# (wingman itself, on an outage-cleared fire) only ever runs this once the
# state has already flipped back to "clear", so the guard is a no-op there.
# A missing/unreadable state file reads as "clear" (fail open), matching
# wm_state outage-update's own default for a fresh install.
#
# Review-signing token regeneration (issue #135, reviewer type only): a
# resumed reviewer's WM_REVIEW_TOKEN cannot be recovered from the crashed
# process, so this mints a fresh one and calls `wm_state crew-set --id <id>
# --regenerate-review-token <token>` before relaunching - see
# bin/lib/wm-state.py's _apply_review_token. Invalidates any pre-crash
# comment-fallback verdict until the resumed reviewer re-affirms it with the
# new token (the resume nudge says so); fails closed, never open.
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"
. "$(dirname "$0")/lib/agent.sh"

ALL_DIED=0
OWNER_ARG=""
FORCE=0
IDS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all-died) ALL_DIED=1; shift ;;
    --owner)    OWNER_ARG="$2"; shift 2 ;;
    --force)    FORCE=1; shift ;;
    -h|--help)  sed -n '2,50p' "$0"; exit 0 ;;
    -*)         wm_die "unknown arg: $1" ;;
    *)          IDS="$IDS $1"; shift ;;
  esac
done

if [ "$ALL_DIED" = 1 ]; then
  [ -z "$IDS" ] || wm_die "pass either --all-died or explicit ids, not both"
else
  [ -z "$OWNER_ARG" ] || wm_die "--owner only applies to --all-died"
  [ -n "$IDS" ] || wm_die "usage: crew-resume <id> [<id2> ...]  |  crew-resume --all-died [--owner <id>]"
fi

if [ "$FORCE" != 1 ]; then
  _outage_state="$(wm_py -c '
import json, sys
try:
    with open(sys.argv[1]) as fh:
        state = json.load(fh)
except Exception:
    state = {}
print(state.get("state", "clear") if isinstance(state, dict) else "clear")
' "$WM_HOME/api-outage-state.json" 2>/dev/null)"
  if [ "$_outage_state" = active ]; then
    wm_die "a fleet-wide API outage is currently active ($WM_HOME/api-outage-state.json) - resuming now risks the relaunched session dying again immediately into the same burst. Wait for it to clear (the watcher's own outage-cleared fire is the normal trigger for this), or pass --force to proceed anyway."
  fi
fi

# --- preflight: the resolved adapter's own gates (issue #16, #241, #25) ------
# Was a single hoisted-above-the-loop sync-user-hooks.py call (the third
# session-creation choke point alongside bin/wingman and bin/spawn-crew - a
# resumed session otherwise bypasses spawn-crew's preflight entirely and
# binds whatever settings.json happens to exist, exactly the recovery window
# - a pre-authorized --all-died after a mass-death event - where an
# unguarded agent is most likely to do damage). Now per-member instead
# (resume_one, below), via the resolved adapter's own WM_AGENT_PREFLIGHT -
# claude's wraps workspace-trust and Bypass-Permissions acceptance too, per
# the same relocation bin/spawn-crew's own preflight went through (issue
# #25), not just hook-sync. Per-member is required because trust is
# genuinely per-repo and different members in one --all-died batch can be in
# different repos or even on different adapters (each record carries its own
# `agent` field) - but the net effect for hook-sync itself (repo-independent)
# is unchanged: a broken hooks manifest fails identically for every member's
# own check, so a --all-died batch still refuses as a whole in practice, just
# via N independent failures instead of one hoisted one.
#
# Same model/effort/permission-mode resolution convention as bin/spawn-crew: no
# CLI flags here (a resumed session has no per-call --model/--effort of its
# own), just the same env-var defaults.
PERM_MODE="${WM_PERMISSION_MODE-bypassPermissions}"
MODEL="${WM_MODEL:-}"
EFFORT="${WM_EFFORT:-}"

# Set by resume_one() for its caller to tally: "resumed" or "skip: <reason>".
RESUME_RESULT=""

# wm_crew_relaunch_note <cwd> <artifact> <artifact-url> <delivery> \
#   <allow-merge:true|false> <review-gate-waived:true|false> \
#   <constraints-newline-separated> <spawned-at> <summary> <objective> <input>
#
# Prints the relaunch progress note (plan §4.8, issue #25) an adapter with no
# WM_AGENT_RESUME_FLAG gets in place of a true --resume: this member's prior
# conversation is gone, so what it starts cold with has to be durable,
# structured facts, not just a compressed status line - starting with what
# the assignment even IS, since a genuinely fresh session cannot be expected
# to infer that from the progress facts alone (PR #335 review round 1,
# finding 2: an earlier version of this function dropped the objective
# entirely, leaving a relaunched no-resume-flag member with a full account of
# what it had already done and nothing telling it what it was doing it for).
# Layer 0 (the objective/input handoff, unchanged since spawn) comes first;
# layer 1 (durably recorded structured fields) and layer 2 (worktree git
# state) come next and are framed as ground truth; layer 3 (the free-text
# `summary`) is explicitly last and explicitly NOT the source of truth - it
# is the one part of this note that was not mechanically derived from
# durable state and can be stale or incomplete (see the plan's own reasoning
# for this ordering).
wm_crew_relaunch_note() {
  _wcrn_cwd="$1"; _wcrn_artifact="$2"; _wcrn_artifact_url="$3"; _wcrn_delivery="$4"
  _wcrn_allow_merge="$5"; _wcrn_review_gate_waived="$6"; _wcrn_constraints="$7"
  _wcrn_spawned_at="$8"; _wcrn_summary="$9"; _wcrn_objective="${10}"; _wcrn_input="${11}"
  printf 'You are being **relaunched after an interruption, not a first assignment**. Your prior conversation context is NOT available - do not assume any of your own past reasoning is still valid. Treat the facts below as ground truth, and verify current state (a worktree diff, the roster fields below, any PR'"'"'s actual review status) before taking any further action, mirroring the status contract'"'"'s own "your checkout is a claim, not verified truth" discipline, applied here to your own prior work.\n\n'
  printf '## Your assignment (unchanged since spawn)\n\n%s\n' "${_wcrn_objective:-(no objective was recorded at spawn)}"
  if [ -n "$_wcrn_input" ]; then
    printf '\nInput handoff: read the plan/spec at `%s` and follow it (the worktree state below shows how far you already got).\n' "$_wcrn_input"
  fi
  printf '\n## What is already durably recorded (grants and deliverables)\n\n'
  _wcrn_any=0
  if [ -n "$_wcrn_artifact" ]; then
    if [ -n "$_wcrn_artifact_url" ]; then
      printf -- '- A deliverable was already produced: `%s` (published: %s)\n' "$_wcrn_artifact" "$_wcrn_artifact_url"
    else
      printf -- '- A deliverable was already produced: `%s`\n' "$_wcrn_artifact"
    fi
    _wcrn_any=1
  fi
  if [ -n "$_wcrn_delivery" ]; then
    printf -- '- A branch/PR was already opened: %s\n' "$_wcrn_delivery"
    _wcrn_any=1
  fi
  if [ "$_wcrn_allow_merge" = true ]; then
    printf -- '- Merge autonomy (--allow-merge) is already granted for this effort.\n'
    _wcrn_any=1
  fi
  if [ "$_wcrn_review_gate_waived" = true ]; then
    printf -- '- The review gate is already waived for this effort.\n'
    _wcrn_any=1
  fi
  if [ -n "$_wcrn_constraints" ]; then
    printf -- '- Standing pilot constraints already captured (repeated from above - do not re-derive or re-ask for these):\n'
    while IFS= read -r _wcrn_cl; do
      [ -n "$_wcrn_cl" ] && printf '  - %s\n' "$_wcrn_cl"
    done <<<"$_wcrn_constraints"
    _wcrn_any=1
  fi
  [ "$_wcrn_any" = 0 ] && printf -- '- (none recorded yet)\n'
  printf '\n## Worktree state as of relaunch\n\n'
  if [ -n "$_wcrn_cwd" ] && [ -d "$_wcrn_cwd" ] && git -C "$_wcrn_cwd" rev-parse --show-toplevel >/dev/null 2>&1; then
    printf '```\n$ git log --oneline --since=%s\n' "$_wcrn_spawned_at"
    git -C "$_wcrn_cwd" log --oneline --since="$_wcrn_spawned_at" 2>/dev/null
    printf '\n$ git status\n'
    git -C "$_wcrn_cwd" status 2>/dev/null
    printf '```\n\n'
  else
    printf '(not a git checkout, or no longer present at relaunch time - nothing to show)\n\n'
  fi
  printf '## Your own last reported summary (context only - the facts above are the source of truth, not this)\n\n%s\n' "${_wcrn_summary:-(none recorded)}"
  unset _wcrn_cwd _wcrn_artifact _wcrn_artifact_url _wcrn_delivery _wcrn_allow_merge \
    _wcrn_review_gate_waived _wcrn_constraints _wcrn_spawned_at _wcrn_summary _wcrn_any _wcrn_cl \
    _wcrn_objective _wcrn_input
}

resume_one() {
  _rid="$1"
  _info="$(wm_state crew-get --id "$_rid" 2>/dev/null)" || {
    wm_warn "'$_rid': no such crew member"
    RESUME_RESULT="skip: no such member"
    return
  }
  # One field per line (never tab-joined): a tab is IFS whitespace, so an empty
  # field (worktree is commonly empty) would collapse two adjacent delimiters
  # into one and silently shift every field after it.
  # is_git/has_remote are real JSON booleans (or None), not strings like the rest
  # of these fields - `d.get(k) or ""` would collapse a confirmed `False` and an
  # absent/None field to the identical empty string, silently destroying exactly
  # the false/unset distinction the git/PR workflow depends on. Printed
  # separately, preserving all three states as "true"/"false"/"".
  #
  # scope/objective/input/summary/artifact/artifact_url/delivery/spawned_at
  # (issue #25, plan §4.8): the relaunch mode's rebuilt brief and progress
  # note are built from these - a single-line field is flattened (embedded
  # newlines replaced with a literal "\n" marker) so the fixed-field read
  # below can never desync on a multi-line summary/objective.
  _lines="$(printf '%s' "$_info" | wm_py -c '
import sys, json
d = json.load(sys.stdin)
def flat(v):
    return (v or "").replace("\n", "\\n")
for k in ("repo", "session_id", "window", "worktree", "status", "type", "scope", "agent"):
    print(d.get(k) or "")
for k in ("is_git", "has_remote"):
    v = d.get(k)
    print("" if v is None else ("true" if v else "false"))
for k in ("objective", "input", "summary", "artifact", "artifact_url", "delivery", "spawned_at"):
    print(flat(d.get(k)))
for k in ("allow_merge", "review_gate_waived"):
    print("true" if d.get(k) else "false")')"
  {
    read -r _repo; read -r _sid; read -r _window; read -r _worktree; read -r _status; read -r _type
    read -r _scope; read -r _agent; read -r _is_git; read -r _has_remote
    read -r _objective; read -r _input; read -r _summary; read -r _artifact; read -r _artifact_url; read -r _delivery; read -r _spawned_at
    read -r _allow_merge; read -r _review_gate_waived
  } <<EOF
$_lines
EOF
  # Constraints (list of {text, set_at}) are variable-length, so extracted
  # separately - one "text" value per line, matching bin/spawn-crew's own
  # $CONSTRAINTS shape exactly (newline-separated raw text, no "- " prefix),
  # so it can be handed straight to wm_compose_crew_sysprompt.
  _constraints="$(printf '%s' "$_info" | wm_py -c '
import sys, json
d = json.load(sys.stdin)
for c in (d.get("constraints") or []):
    print((c.get("text") or "").replace("\n", " "))')"

  # Idempotency guard 1: only a currently-died member is a resume target.
  if [ "$_status" != "died" ]; then
    wm_info "'$_rid': not died (status=$_status), nothing to resume"
    RESUME_RESULT="skip: not died"
    return
  fi
  # Idempotency guard 2: an atomic per-id claim, not a check-then-act. tmux
  # does not enforce unique window names - `new-window -n X` happily creates a
  # second X rather than failing or deduping against an existing one - so a
  # `grep` of the window list before `new-window` leaves a TOCTOU gap two
  # concurrent/retried callers can both pass, each then launching its own
  # `claude --resume` against the identical session id. mkdir is the atomic
  # claim primitive instead (same pattern as the watcher's own singleton arm:
  # a write-then-read-back verification, with the cleanup trap registered the
  # instant mkdir succeeds so this process's own dir is never left behind even
  # if it turns out to have lost that internal race).
  _claim="$WM_HOME/crew/$_rid.resuming"
  # A single release point, called from every exit path once the claim is
  # held: --all-died calls resume_one once per id in the same process,
  # reassigning $_claim each time, so an inline release duplicated at each
  # return site is exactly the kind of thing that's easy to miss at one of
  # them (as happened here) - one helper closes the whole class of bug.
  release_claim() { rm -f "$_claim/owner" 2>/dev/null; rmdir "$_claim" 2>/dev/null; trap - EXIT; }
  _claim_owned=0
  _claim_tries=0
  while :; do
    if mkdir "$_claim" 2>/dev/null; then
      trap release_claim EXIT
      echo "$$" > "$_claim/owner" 2>/dev/null
      sleep 0.1
      if [ "$(cat "$_claim/owner" 2>/dev/null)" = "$$" ]; then _claim_owned=1; break; fi
      trap - EXIT   # lost the internal race; the presumed winner's own trap cleans up
    fi
    _claim_tries=$((_claim_tries+1))
    [ "$_claim_tries" -ge 20 ] && break
    sleep 0.1
  done
  if [ "$_claim_owned" != 1 ]; then
    wm_warn "'$_rid': could not claim the resume lock - another crew-resume may be relaunching it right now, or a stale claim was left by a crashed run (remove $_claim by hand if none is running). Not relaunching."
    RESUME_RESULT="skip: could not claim resume lock"
    return
  fi
  # Now that concurrent creators are excluded, a window already at this name
  # means a previous resume already relaunched it (or left a stray window) -
  # still worth skipping, but no longer the thing that closes the race.
  if wm_tmux_windows | grep -qx "$_window"; then
    wm_info "'$_rid': window '$_window' already exists, not relaunching"
    RESUME_RESULT="skip: window already exists"
    release_claim
    return
  fi

  # #221: a recorded worktree that's since been removed (this repo's own
  # dev-workflow practice tears one down once its PR merges - routine, not
  # exceptional) must not be an uninformative hard failure. Mirrors
  # _anchor_died_worktree's own precedent for a missing worktree
  # (bin/lib/wm-state.py: "if not worktree or not os.path.isdir(worktree):
  # return None, None") by falling back to the repo root instead. Reset on
  # every entry, not just $_cwd: resume_one() runs once per id in the same
  # process for --all-died, so without this reset a fallback on one member
  # would leave _worktree_fallback=1 for the rest of the batch, wrongly
  # telling a healthy member with a live worktree to abandon it (see the
  # nudge text below) - the same per-batch-reset discipline _review_token and
  # release_claim's own comment already follow in this function.
  _cwd="$_repo"
  _worktree_fallback=0
  if [ -n "$_worktree" ] && [ -d "$_worktree" ]; then
    _cwd="$_worktree"
  elif [ -n "$_worktree" ]; then
    wm_info "'$_rid': recorded worktree '$_worktree' no longer exists (likely cleaned up after its PR merged); resuming into the repo root '$_repo' instead"
    wm_state crew-set --id "$_rid" --worktree "" >/dev/null
    _worktree_fallback=1
  fi

  # --- resolve the agent CLI adapter and run its preflight (issue #25) -------
  # This member's OWN recorded adapter, not $WM_AGENT/the caller's own
  # environment - a --all-died batch can span members on different adapters,
  # and the resolution has to be per-member for exactly that reason (unlike
  # the process-global PERM_MODE above). Empty/absent `agent` means "claude"
  # (see wm-state.py's crew-add --agent comment).
  _resolved_agent_name="${_agent:-claude}"
  wm_agent_resolve "$_resolved_agent_name"
  # Subshelled (never called directly): claude_preflight's own gates call
  # wm_die on failure, which would otherwise kill this WHOLE crew-resume
  # process - including every member still waiting in a --all-died batch -
  # rather than just skipping this one. A subshell's exit/wm_die only ends
  # the subshell; its own stderr (the actual failure message) still reaches
  # the caller normally, since a subshell shares stdout/stderr with its
  # parent unless redirected.
  if [ -n "$WM_AGENT_PREFLIGHT" ] && ! ( "$WM_AGENT_PREFLIGHT" "$_repo" "$PERM_MODE" resume ); then
    wm_warn "'$_rid': agent preflight failed - not relaunching (see the message above)."
    RESUME_RESULT="skip: preflight failed"
    release_claim
    return
  fi

  # --- regenerate the review-signing token (reviewer type only, issue #135) --
  # WM_REVIEW_TOKEN is never persisted anywhere except the crashed process's
  # own (now-gone) environment - it cannot be recovered, so a resumed
  # reviewer needs a genuinely fresh one, exactly as bin/spawn-crew mints at
  # first spawn. This also invalidates any pre-crash comment-fallback verdict
  # (its proof no longer matches the regenerated commitment on record) until
  # the resumed reviewer re-affirms it - an availability cost, never a
  # security hole (fails closed). Stdout is redirected: the caller running
  # this script has no legitimate need to see the raw token, and printing it
  # would put it in that orchestrator session's own transcript for no reason.
  # Match the bare role name so a category-namespaced reviewer
  # (e.g. software-development/reviewer) regenerates its token too (issue #166).
  _review_token=""
  if [ "${_type##*/}" = reviewer ]; then
    _review_token="$(wm_py -c 'import secrets; print(secrets.token_hex(32))')"
    wm_state crew-set --id "$_rid" --regenerate-review-token "$_review_token" >/dev/null
  fi

  # --- relaunch mode: re-compose the brief + progress note (plan §4.8) -------
  # Only when the resolved adapter has no WM_AGENT_RESUME_FLAG - computed
  # here, before the launch script is written, so the exec-composition block
  # below can just deliver it via wm_agent_emit_sysprompt like any other
  # descriptor-driven field. wm_resolve_playbook/ROLE_NAME/INCLUDE_PR_DELIVERY
  # mirror bin/spawn-crew's own resolution exactly (wm_compose_crew_sysprompt
  # is the shared function both call), re-derived from the roster record
  # since crew-resume never persisted them itself.
  _relaunch_sysprompt=""
  _relaunch_note=""
  if [ -z "$WM_AGENT_RESUME_FLAG" ]; then
    _rl_sysprompt_path="$WM_HOME/crew/$_rid.sysprompt.md"
    # Subshelled (never called directly, same reasoning and pattern as the
    # agent preflight above - PR #335 review round 2, nice-to-have):
    # wm_resolve_playbook calls wm_die on an unresolvable/ambiguous type,
    # which would otherwise kill this WHOLE crew-resume process - including
    # every member still waiting in a --all-died batch - rather than just
    # skipping this one. wm_compose_crew_sysprompt's file write survives the
    # subshell exiting (only shell variables are subshell-scoped, not file
    # writes); the composed note text is captured back via stdout, the one
    # value from inside the subshell the parent shell still needs.
    if _relaunch_note="$(
      wm_resolve_playbook "$_type"
      _rl_role_name="$(basename "$PLAYBOOK")"
      case "$_rl_role_name" in
        *.local.md) _rl_role_name="${_rl_role_name%.local.md}" ;;
        *.md)       _rl_role_name="${_rl_role_name%.md}" ;;
      esac
      _rl_include_pr_delivery=0
      case " developer ml-engineer data-engineer " in
        *" $_rl_role_name "*) _rl_include_pr_delivery=1 ;;
      esac
      _rl_target_is_wm_repo=0
      [ "$_scope" = repo ] && [ "$_repo" = "$WM_REPO" ] && _rl_target_is_wm_repo=1
      # "$_input" (not ""): the original --input plan/report pointer, now
      # durably recorded on the roster record itself (PR #335 review round 1,
      # finding 3) - rebuilding this file with a hardcoded "" here would
      # silently erase the only durable record of that handoff the first
      # time a no-resume-flag member is relaunched.
      wm_compose_crew_sysprompt "$_rl_sysprompt_path" "$_rid" "$_type" "$_repo" "$_scope" \
        "$_constraints" "$_rl_target_is_wm_repo" "$_input" "$PLAYBOOK" "$_rl_include_pr_delivery"
      wm_crew_relaunch_note "$_cwd" "$_artifact" "$_artifact_url" "$_delivery" \
        "$_allow_merge" "$_review_gate_waived" "$_constraints" "$_spawned_at" "$_summary" \
        "$_objective" "$_input"
    )"; then
      _relaunch_sysprompt="$_rl_sysprompt_path"
    else
      wm_warn "'$_rid': could not compose the relaunch brief - no playbook resolved for type '$_type' (see the message above); not relaunching."
      RESUME_RESULT="skip: preflight failed"
      release_claim
      return
    fi
  fi

  # --- write the resume launch script (avoids all in-tmux quoting) -----------
  # #221 part 2: capture the script's stderr to a durable per-member file,
  # bounded, so a fast crash (a bad `cd`, an invalid session id) leaves
  # something readable behind after the window - and its pane's stderr -
  # is already gone. Every line is still forwarded to the pane's own stderr
  # unconditionally, so nothing currently visible via bin/crew-takeover is
  # lost; the file is purely an additional copy. Bounded at 200 lines and
  # 2000 bytes/line via awk (never tee, which would grow this file forever,
  # since `exec claude ...` below inherits fd 2 for the entire life of a
  # successfully resumed session, not just the few seconds this function
  # watches) - the per-line cap keeps a single unterminated line (a
  # \r-driven progress stream with no newline) from defeating the line
  # count. awk's reader never exits early the way `head` would, so the
  # agent's later stderr writes never hit SIGPIPE/EPIPE against a reader
  # that's gone.
  _launch="$WM_HOME/crew/$_rid.resume.sh"
  _stderr_file="$WM_HOME/crew/$_rid.resume.stderr"
  : > "$_stderr_file" 2>/dev/null
  {
    echo '#!/usr/bin/env bash'
    # setsid: without it, awk is still a member of the pane's own process
    # group, and tmux signals that whole group (SIGHUP) the instant the
    # pane's foreground process (the resumed agent, or a fast-crashing stub)
    # exits - killing awk before it gets scheduled to drain and flush
    # whatever is still buffered in the pipe, discarding it outright. The
    # same mechanism bin/wingman's own guardian launch already documents and
    # works around for the tracked tmux server (cgroup isolation alone does
    # nothing here - cgroups and terminal sessions are unrelated kernel
    # concepts; only setsid detaches the latter). Reproduced directly: under
    # even moderate host contention this loses the capture the large
    # majority of the time, and no amount of extra waiting in the failure
    # branch below helps, since awk is already dead by the time that wait
    # begins - setsid detaches it into its own session so the pane's
    # teardown signal never reaches it, and it exits only once it has
    # genuinely finished (EOF on its own stdin).
    echo "exec 2> >(setsid awk -v f=$(quote "$_stderr_file") 'NR<=200 { print substr(\$0,1,2000) >> f; fflush(f) } { print > \"/dev/stderr\" }')"
    echo "cd $(quote "$_cwd") || exit 1"
    echo "export WINGMAN_HOME=$(quote "$WM_HOME")"
    # Defeat the CLI's own "resume from summary?" interactive prompt (issue
    # #30): past a token/age threshold, `claude --resume` shows an Ink menu
    # ("Resume from summary (recommended)" / "Resume full session as-is" /
    # "Don't ask me again") that nothing answers in an unattended relaunch,
    # hanging the session forever. Both env vars gate that prompt's size/age
    # check unconditionally (confirmed in the shipped CLI binary - see
    # docs/plans/2026-07-15-issue-30-resume-hang-recovery-plan.md); set
    # absurdly high here, the gate can never be satisfied regardless of
    # transcript size or session age. Scoped to this one resumed process only
    # (never written to the shared ~/.claude.json), so it has no effect on the
    # human's own everyday interactive sessions. Claude-specific (issue #25
    # review round 1/2 nice-to-have): a claude-only env var leaking into every
    # other adapter's own process is harmless today (nothing reads it) but
    # wrong to export unconditionally - gated the same way crew-takeover's
    # identical block already is.
    if [ "$_resolved_agent_name" = claude ]; then
      echo "export CLAUDE_CODE_RESUME_TOKEN_THRESHOLD=${WM_RESUME_TOKEN_THRESHOLD:-999999999}"
      echo "export CLAUDE_CODE_RESUME_THRESHOLD_MINUTES=${WM_RESUME_THRESHOLD_MINUTES:-999999999}"
    fi
    # The resuming session's own run id, exactly as spawn-crew captures it at
    # spawn time: a resume is an action of the CURRENT wingman sit-down, so the
    # preferences answered for that sit-down govern the resumed member (the
    # artifact-link-guard's pref-get and the status contract's condition B both
    # key off it). Empty when the resume happens outside a wingman run.
    echo "export WINGMAN_RUN_ID=$(quote "${WINGMAN_RUN_ID:-}")"
    echo "export WINGMAN_CREW_ID=$(quote "$_rid")"
    # The crew type from the member's own roster record, so a resumed lead
    # keeps its orchestrator-role hooks (no-direct-edit-guard.sh keys off
    # WINGMAN_CREW_TYPE=lead) exactly like a freshly-spawned one.
    echo "export WINGMAN_CREW_TYPE=$(quote "$_type")"
    echo "export WINGMAN_STATE=$(quote "$WM_UV $WM_STATE_PY")"
    echo "export WINGMAN_BIN=$(quote "$WM_BIN")"
    # Tracks the same fallback condition as $_cwd above, not the raw presence
    # of $_worktree - otherwise a resumed session would be told (via this env
    # var) that it's worktree-scoped while actually running from the repo root.
    [ -n "$_worktree" ] && [ -d "$_worktree" ] && echo "export WINGMAN_WORKTREE=$(quote "$_worktree")"
    # Carry the original spawn's git-detection result forward rather than
    # discarding it: empty (the None/absent case - global scope, or a pre-change
    # record) means neither line is written, leaving the resumed session in the
    # same "unset, detect it yourself" state every branching playbook already
    # handles.
    [ -n "$_is_git" ] && echo "export WINGMAN_IS_GIT=$_is_git"
    [ -n "$_has_remote" ] && echo "export WINGMAN_HAS_REMOTE=$_has_remote"
    # The freshly regenerated review-signing token (reviewer type only),
    # exactly like a fresh spawn - see the regeneration block above.
    [ -n "$_review_token" ] && echo "export WM_REVIEW_TOKEN=$(quote "$_review_token")"
    # The resolved agent CLI drives everything from here on (issue #25),
    # exactly like bin/spawn-crew's own launch composition -
    # wm_agent_resolve already applied WM_AGENT_BIN_OVERRIDE to WM_AGENT_BIN,
    # so this needs no separate fallback of its own.
    #
    # WM_AGENT_ENV_PREFIX before the literal `exec` word, not after - see
    # bin/spawn-crew's own identical comment (round-2 review of PR #350):
    # `exec VAR=val cmd` does not treat VAR=val as an env-prefix (exec is
    # the command name there; VAR=val becomes its first argument, a
    # literal program name bash then fails to find, rc 127) - only a bare
    # `VAR=val cmd`, with no leading `exec`, gets that treatment.
    wm_guard_test_fixture_agent "$WM_AGENT_BIN"
    [ -n "$WM_AGENT_ENV_UNSET" ] && echo "unset $WM_AGENT_ENV_UNSET"
    [ -n "$WM_AGENT_ENV_PREFIX" ] && printf '%s ' "$WM_AGENT_ENV_PREFIX"
    printf 'exec '
    printf '%s' "$WM_AGENT_BIN"
    if [ -n "$WM_AGENT_RESUME_FLAG" ]; then
      # A true resume: the CLI's own resume flag restores full conversation
      # context, so no system-prompt re-delivery is needed at all - unchanged
      # from claude's original behavior, the only adapter with this flag
      # populated today.
      wm_agent_emit_flag "$WM_AGENT_RESUME_FLAG" "$_sid"
    fi
    [ -n "$PERM_MODE" ] && wm_agent_emit_flag "$WM_AGENT_BYPASS_FLAG" "$PERM_MODE"
    # --add-dir/--settings: claude-specific, no descriptor field of their own
    # yet - see bin/spawn-crew's identical gate and comment (issue #25; the
    # adapter contract, plan §4.3, has no equivalent for any other CLI).
    if [ "$_resolved_agent_name" = claude ]; then
      printf ' --add-dir %s' "$(quote "$WM_HOME")"
      printf ' --add-dir %s' "$(quote "$_repo")"
      printf ' --settings %s' "$(quote "$(wm_claude_md_excludes)")"
    fi
    [ -n "$MODEL" ]  && wm_agent_emit_flag "$WM_AGENT_MODEL_FLAG"  "$MODEL"
    [ -n "$EFFORT" ] && wm_agent_emit_flag "$WM_AGENT_EFFORT_FLAG" "$EFFORT"
    if [ -z "$WM_AGENT_RESUME_FLAG" ]; then
      # Relaunch mode (plan §4.8): no session to resume, so this is a fresh
      # session under the SAME crew id/window/worktree instead, delivering
      # the re-composed brief plus the three-layer progress note - computed
      # just above this block - in place of a resume flag with no id to fill.
      wm_agent_emit_sysprompt "$_relaunch_sysprompt" "$_relaunch_note"
    else
      WM_AGENT_OPENING_DELIVERED_AT_LAUNCH=0
    fi
    printf '\n'
  } > "$_launch"
  chmod +x "$_launch"

  # --- relaunch the window -----------------------------------------------------
  wm_tmux_ensure_session
  # -PF prints the replacement window's id (@N); re-registered in the roster so
  # stray-window adoption keeps an exact identity to match on.
  _window_id="$(wm_tmux new-window -d -PF '#{window_id}' -t "$WM_TMUX_TARGET:" -n "$_window" "bash $(quote "$_launch")")"
  _new_window_rc=$?
  if [ "$_new_window_rc" -ne 0 ] || [ -z "$_window_id" ]; then
    wm_warn "'$_rid': tmux new-window failed (exit $_new_window_rc) - no window was created; status left 'died'. Inspect with 'bin/crew-takeover $_rid', or discard with 'bin/crew-standdown $_rid'."
    RESUME_RESULT="skip: resume failed"
    release_claim
    return
  fi
  # Captured right after the window exists, well before the nudge is even
  # sent, so the #220 verify deadline below measures from the window's true
  # birth, not from whatever point this function happens to reach it.
  _window_t0="$(date +%s)"
  wm_state crew-set --id "$_rid" --window-id "$_window_id" --silent >/dev/null 2>&1 || true
  # --resume reopens the conversation but, in this unattended setup, does not
  # itself decide to keep working - it needs the same kind of opening nudge a
  # fresh spawn gets. A freshly resumed window can land back on a startup gate
  # (workspace-trust/Bypass) rather than an idle chat prompt; wm_tmux_send_message
  # then refuses (rc 2) rather than risk the nudge's Enter being consumed as an
  # answer to that dialog. Non-fatal here - the window and roster record are
  # already in place - but the nudge was NOT delivered, so it is surfaced rather
  # than silently assumed to have landed.
  # Skipped entirely when the launch itself already delivered the full brief
  # + progress note (relaunch mode's flag/positional/prompt-flag sysprompt
  # modes, plan §4.8, §4.5) - only a genuine post-launch delivery still needs
  # to happen: a true --resume (unchanged), or the reserved
  # pointer-after-ready mode no current adapter uses, which gets the full
  # relaunch note here instead of the short nudge below.
  if [ "$WM_AGENT_OPENING_DELIVERED_AT_LAUNCH" != 1 ]; then
  if [ -n "$_relaunch_note" ]; then
    _resume_nudge="$_relaunch_note"
  else
    _resume_nudge="Your previous window was interrupted (likely a tmux/host crash); this is a resumed session continuing your prior work. Check bin/crew-list/your own last status, re-arm any watcher you had running, and continue."
  fi
  # issue #135: a resumed reviewer's review-signing token was just
  # regenerated above, invalidating any pre-crash comment-fallback proof.
  [ "${_type##*/}" = reviewer ] && _resume_nudge="$_resume_nudge Your review-signing token was regenerated on resume (issue #135) - if you had already posted a comment-fallback verdict on a PR, re-post it now so its proof matches the new token before a merge can rely on it."
  # #221: tell the resumed session itself, not just the operator console
  # (the wm_info line above only reaches whoever ran crew-resume). Left
  # unannounced, a resumed developer either hits confusing failures on every
  # remembered $WINGMAN_WORKTREE-prefixed path, or - worse - starts editing
  # and committing in the shared repo root on whatever branch it's parked on,
  # since no-direct-edit-guard.sh only gates a lead, not a developer.
  [ "${_worktree_fallback:-0}" = 1 ] && _resume_nudge="$_resume_nudge Your recorded worktree no longer exists (likely cleaned up after its PR merged), so this session started in the shared repo root '$_repo' instead of an isolated worktree - re-isolate into a fresh worktree per your playbook's own step before touching any file."
  # WM_CLEAR_KEYS="" (issue #157): same reasoning as bin/spawn-crew's own opening
  # delivery - this window was just relaunched, so there is no pre-existing
  # composed text to clear, and it can still be mid-startup here even after
  # wm_tmux_pane_ready settles stable (a splash screen can sit static for a
  # beat before the CLI claims raw-mode input handling). Skip the defensive
  # Ctrl-C, which would otherwise risk killing a not-yet-raw-mode process
  # outright instead of clearing anything it hasn't composed yet.
  WM_CLEAR_KEYS="" wm_tmux_send_message "$(wm_tmux_win_target "$_window")" "$_resume_nudge" "$_resolved_agent_name"
  _resume_nudge_rc=$?
  # Every documented wm_tmux_send_message rc gets matched wording (bin/lib/common.sh:1034-1056
  # for the canonical list), mirroring bin/crew-say:100-107 - previously only rc 2 and rc 6
  # were named here; 3/4/5/7/8 fell through silently to the generic "QUEUED" line below with
  # no diagnosis of why (issue #173).
  case "$_resume_nudge_rc" in
    0) ;;
    2) wm_warn "'$_rid': resume nudge NOT delivered - its pane looks like a permission/trust dialog, not the chat input (see: bin/crew-takeover $_rid)" ;;
    3) wm_warn "'$_rid': resume nudge NOT delivered - it was typed into the pane but the submit never visibly registered; treat it as not delivered." ;;
    4) wm_warn "'$_rid': resume nudge NOT delivered - another delivery is holding the pane's send lock." ;;
    5) wm_warn "'$_rid': resume nudge NOT delivered - it was typed into the pane but the submit never visibly registered, and the pane was busy (still repainting on its own clock) - likely queued behind its current turn rather than lost outright." ;;
    6) wm_warn "'$_rid': resume nudge NOT delivered - its pane is mid-turn with a composer already holding text, so nothing was typed." ;;
    7) wm_warn "'$_rid': resume nudge NOT delivered - the send-lock helper for the pane failed unexpectedly (a broken local 'uv'/python 'fcntl' toolchain, not contention) - nothing was typed. Worth investigating directly: an ordinary contention refusal would clear on its own; a broken helper will not." ;;
    8) wm_warn "'$_rid': resume nudge NOT delivered - an internal bug attempted a reentrant send-lock acquisition for the pane - nothing was typed. This indicates a programming error, not ordinary contention - please report it." ;;
    *) wm_warn "'$_rid': resume nudge NOT delivered (unrecognized rc $_resume_nudge_rc from wm_tmux_send_message)." ;;
  esac
  # Any nonzero rc means the nudge did not confirm delivered (issue #214): a
  # resumed session that misses this nudge otherwise silently gets nothing -
  # no re-arm reminder, no "you were resumed" context - since crew-resume
  # itself never retries. Queue it the same way crew-say does so the watcher's
  # own outbox retry picks it up once the pane clears.
  if [ "$_resume_nudge_rc" -ne 0 ]; then
    mkdir -p "$WM_HOME/outbox/$_rid" "$WM_HOME/outbox-meta/$_rid"
    _resume_qfile="$WM_HOME/outbox/$_rid/$(date +%s)-$$.msg"
    printf '%s\n' "${WINGMAN_CREW_ID:-}" > "$WM_HOME/outbox-meta/$_rid/$(basename "$_resume_qfile")"
    printf '%s\n' "$_resume_nudge" > "$_resume_qfile"
    wm_warn "'$_rid': the resume nudge is QUEUED at $_resume_qfile; the watcher will retry it automatically."
  fi
  fi

  # --- verify the resume actually took -----------------------------------------
  # A wall-clock deadline, not a single fixed-latency sample (#220). The first
  # check below is unchanged and costs nothing extra: by the time we get here,
  # the preceding wm_tmux_send_message call has already spent WM_SUBMIT_DELAY
  # plus (on failure to detect a change) up to WM_SUBMIT_TRIES x WM_SUBMIT_POLL,
  # so a --resume that fails fast (a stale/invalid session id, see
  # docs/plans/2026-07-11-watch-fleet-reliability-track-b-design.md) has
  # already had that window to manifest as the just-created window vanishing.
  # But a crash that lands after that single check - a slow-settling
  # permission dialog, a delayed --resume API round-trip, or host contention
  # from resuming several members at once (precisely what a mass-death
  # recovery produces) - would otherwise go unnoticed forever, since nothing
  # else ever re-checks a member once it's marked `working`. So when the
  # single check finds the window still alive, keep polling until
  # WM_RESUME_VERIFY_WINDOW seconds (default 20, must be an integer - the
  # `-lt` comparison below errors, silently skipping the loop body, on a
  # fractional value) have elapsed since $_window_t0. This makes the
  # guarantee a single stated property - no resume is committed to `working`
  # until at least WM_RESUME_VERIFY_WINDOW seconds after its window was
  # created - independent of which nudge-delivery path was taken, rather than
  # an unbounded "one more fixed batch of polls on top of an already-variable
  # base." The cost is real: a genuinely healthy resume still waits out the
  # full window rather than exiting early, since a session observed alive for
  # a few polls is not evidence against a crash later in the window.
  if wm_tmux_windows | grep -qx "$_window"; then _alive=1; else _alive=0; fi

  if [ "$_alive" = 1 ]; then
    _rv_window="${WM_RESUME_VERIFY_WINDOW:-20}"
    _rv_poll="${WM_RESUME_VERIFY_POLL:-1}"
    while [ "$(( $(date +%s) - _window_t0 ))" -lt "$_rv_window" ]; do
      sleep "$_rv_poll"
      if ! wm_tmux_windows | grep -qx "$_window"; then
        _alive=0
        break
      fi
    done
  fi

  if [ "$_alive" = 1 ]; then
    # --clear-wip-anchor (issue #251, review round 1, nice-to-have 3): the
    # death this resume just recovered from is over, so its WIP-anchor
    # pointer/error (if any) no longer describes anything current - a live
    # `working` member should not keep rendering `wip-ref: refs/wip/<id>
    # (<sha>)` in crew-list/the tree view for a crash that's now resolved.
    wm_state crew-set --id "$_rid" --status working --clear-wip-anchor \
      --summary "resumed after an interruption (was died); continuing prior session" >/dev/null
    wm_ok "'$_rid': resumed in window '$_window'"
    RESUME_RESULT="resumed"
  else
    # #221 part 2: fold the captured stderr's last line into the warning, so
    # the real cause (a bad `cd`, an invalid session id) is surfaced instead
    # of only this generic message. The awk capture process is independent of
    # the pane's own lifecycle, so its final flush can trail the window's
    # death by a beat - wait briefly (setsid above is what makes this wait
    # actually sufficient: without it, awk is killed alongside the pane and
    # no amount of waiting here would find anything; with it, awk reliably
    # runs to completion, and this is only covering the ordinary scheduling
    # delay until it does).
    _stderr_tail=""
    _st_i=0
    while [ "$_st_i" -lt 20 ] && [ ! -s "$_stderr_file" ]; do
      sleep 0.1
      _st_i=$((_st_i+1))
    done
    if [ -s "$_stderr_file" ]; then
      _stderr_line="$(tail -n1 "$_stderr_file" 2>/dev/null | tr -d '\000-\037' | cut -c1-200)"
      [ -n "$_stderr_line" ] && _stderr_tail=" Last captured stderr line: $_stderr_line"
    fi
    wm_warn "'$_rid': --resume exited immediately (window vanished); status left 'died'.${_stderr_tail} Inspect with 'bin/crew-takeover $_rid', or discard with 'bin/crew-standdown $_rid'."
    RESUME_RESULT="skip: resume failed"
  fi
  release_claim
}

# --- resolve targets ----------------------------------------------------------
if [ "$ALL_DIED" = 1 ]; then
  if [ -n "$OWNER_ARG" ]; then
    TARGETS="$(wm_state crew-list --status died --owner "$OWNER_ARG" --json 2>/dev/null | wm_py -c '
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
for r in data:
    print(r.get("id", ""))
')"
  else
    TARGETS="$(wm_state crew-list --status died --json 2>/dev/null | wm_py -c '
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
for r in data:
    print(r.get("id", ""))
')"
  fi
else
  TARGETS="$(printf '%s\n' $IDS)"
fi

# --- run, sequentially (a shared tmux server makes concurrency risky and of no
# benefit for a handful of window creations) -----------------------------------
resumed=0
skipped=0
skip_notes=""
# A preflight failure (issue #25, #241) is an environmental/configuration
# problem, not a routine "nothing to do" skip like "not died" or "window
# already exists" - it means this session's guards could not be wired at
# all, and the caller needs a non-zero exit to notice, exactly like the
# hard wm_die this replaced (a single hoisted check, pre-#25) always gave.
# Other skip reasons keep the script's long-standing exit-0 behavior:
# nothing before this port ever made THOSE contribute to the exit status,
# and no test relies on them doing so now.
preflight_failures=0
for _t in $TARGETS; do
  [ -n "$_t" ] || continue
  resume_one "$_t"
  case "$RESUME_RESULT" in
    resumed) resumed=$((resumed+1)) ;;
    "skip: preflight failed") skipped=$((skipped+1)); skip_notes="$skip_notes; $_t ($RESUME_RESULT)"; preflight_failures=$((preflight_failures+1)) ;;
    *) skipped=$((skipped+1)); skip_notes="$skip_notes; $_t ($RESUME_RESULT)" ;;
  esac
done

wm_info "$resumed resumed, $skipped skipped${skip_notes:+: ${skip_notes#; }}"
[ "$preflight_failures" -eq 0 ] || exit 1
