#!/usr/bin/env bash
# doctor - dependency preflight for wingman.
# Checks each dependency, registers wingman's user- and project-scope Claude Code
# hooks and statusline, validates config.local.toml, and prints a platform-aware
# report, offering to install or register anything missing.
# Run on first launch (CLAUDE.md wires this) and any time.
#
# Exit 0 when every required dependency is present AND config.local.toml parses,
# 1 otherwise.
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"
# WM_CONTINUITY_TIMEOUT_MIN (issue #231) - the single source of truth for the
# registered `timeout` the fleet-continuity Stop hooks below must carry.
. "$WM_REPO/hooks/lib/watcher-liveness.sh"
# wm_agent_resolve/wm_guard_transport_sync - the orchestrator's own guard-
# transport reconcile+self-test (docs/analysis/2026-08-18-remove-bin-
# wingman-launcher-spec.md, §4.5), below.
. "$WM_LIB/agent.sh"
. "$WM_LIB/guard-transport.sh"

AUTO_YES=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) AUTO_YES=1 ;;
    -h|--help) echo "usage: doctor [-y]"; exit 0 ;;
  esac
done

MISSING_REQUIRED=0
INSTALL_QUEUE=""   # space-separated brew/apt package names

# check <binary> <required|optional> <pkg> [note]
check() {
  bin="$1"; level="$2"; pkg="$3"; note="${4:-}"
  if wm_have "$bin"; then
    wm_ok "$bin$([ -n "$note" ] && echo " ($note)")"
    return
  fi
  cmd="$(wm_install_cmd "$pkg")"
  if [ "$level" = required ]; then
    wm_err "$bin MISSING (required) ${note:+- $note}"
    MISSING_REQUIRED=1
  else
    wm_warn "$bin missing (optional) ${note:+- $note}"
  fi
  if [ -n "$cmd" ]; then
    printf '    install: %s\n' "$cmd"
    INSTALL_QUEUE="$INSTALL_QUEUE $pkg"
  else
    printf '    install: see your package manager for %s\n' "$pkg"
  fi
}

wm_info "wingman doctor - platform: $(wm_platform)"
echo

# --- surface a durable launch-failure sink, if one is present (issue #241) --
# $WM_HOME/last-launch-failure is written by bin/lib/orchestrator-
# bootstrap.sh (docs/analysis/2026-08-18-remove-bin-wingman-launcher-
# spec.md, §4.5) when it could not reconcile a guard transport and the
# orchestrator's own session is denied every tool call over it - the one
# case under systemd where a plain stderr message reaches nobody (see
# wm_launch_failure's own comment in bin/lib/common.sh). Never deleted here:
# only a subsequent successful bootstrap clears it, so a pilot who ran
# doctor cannot mistake that for "the orchestrator's guards are wired now".
if [ -f "$WM_HOME/last-launch-failure" ]; then
  # Parsed with bash parameter expansion rather than `sed ... \t`, whose `\t`
  # is a GNU extension - BSD/macOS sed treats it as a literal "t", silently
  # emptying both fields there. tail (not `sed -n '2p'`) captures the WHOLE
  # reason: the reconciler prints one "error:" line per broken script, so a
  # checkout missing several would otherwise only ever surface the first.
  _llf_line1="$(head -n1 "$WM_HOME/last-launch-failure" 2>/dev/null)"
  _llf_tab="$(printf '\t')"
  _llf_ts="${_llf_line1%%"$_llf_tab"*}"
  _llf_component="${_llf_line1#*"$_llf_tab"}"
  _llf_reason="$(tail -n +2 "$WM_HOME/last-launch-failure" 2>/dev/null)"
  wm_err "the most recent session launch refused to start ($_llf_ts, $_llf_component): $_llf_reason"
  printf '    fix the problem above, then start wingman again - this file is not cleared\n'
  printf '    until a launch actually succeeds: %s\n' "$WM_HOME/last-launch-failure"
  echo
fi

# Irreducible core: must already exist, we do not offer to install these.
if wm_have claude; then wm_ok "claude"; else wm_err "claude MISSING - install Claude Code first: https://claude.com/claude-code"; MISSING_REQUIRED=1; fi
if wm_have git;    then wm_ok "git";    else wm_err "git MISSING - install git first"; MISSING_REQUIRED=1; fi

# Core runtime deps doctor can install with consent.
check tmux     required tmux
check uuidgen  required util-linux "session-id generation"

# uv runs the state engine and manages the Python interpreter itself.
if wm_have uv; then
  wm_ok "uv (runs the state engine; manages Python)"
else
  wm_err "uv MISSING (required) - runs the state engine and manages Python"
  MISSING_REQUIRED=1
  case "$(wm_platform)" in
    macos) printf '    install: brew install uv\n'; INSTALL_QUEUE="$INSTALL_QUEUE uv" ;;
    *)     printf '    install: curl -LsSf https://astral.sh/uv/install.sh | sh\n' ;;
  esac
fi

# Optional / nice-to-have. python3 is not required: uv provides an interpreter.
check python3  optional python3 "optional; uv provides the interpreter"
check jq       optional jq "optional; the state engine handles JSON"

# Soft: only flag gh if the ACTIVE developer brief references it. The role
# playbook itself is now a slim purpose prompt; the gh/PR mechanics live in
# the shared _delivery.md fragment appended to it (and any developer.local.md
# override still gets that fragment), so check both - either referencing gh
# means the default delivery flow can use it.
dev_playbook="$WM_REPO/playbooks/software-development/developer.md"
[ -f "$WM_REPO/playbooks/software-development/developer.local.md" ] && dev_playbook="$WM_REPO/playbooks/software-development/developer.local.md"
if { [ -f "$dev_playbook" ] && grep -q '\bgh\b' "$dev_playbook" 2>/dev/null; } \
   || grep -q '\bgh\b' "$WM_REPO/playbooks/_delivery.md" 2>/dev/null; then
  check gh optional gh "used by the active developer playbook for PRs (run 'gh auth login')"
fi

# Optional: gitleaks powers bin/lib/artifact-scan.sh, the pre-publish content
# scan gating ask 3a's Artifact-publish path (docs/plans/2026-07-12-remote-
# control-visibility-and-auto-reconnect-design.md). Without it the scan fails
# closed (treats "cannot verify" as "do not publish"), so a crew member can
# still surface deliverables by local path exactly as before this feature -
# missing gitleaks only means Artifact-publishing itself stays unavailable.
check gitleaks optional gitleaks "secret-scanning for the Artifact-publish content-scan gate; without it, that gate always fails closed"

echo
# Offer to install queued packages.
INSTALL_QUEUE="$(echo "$INSTALL_QUEUE" | sed 's/^ *//;s/ *$//')"
if [ -n "$INSTALL_QUEUE" ]; then
  pm=""
  case "$(wm_platform)" in
    macos) wm_have brew && pm="brew install" ;;
    linux)
      if wm_have apt-get; then pm="sudo apt-get install -y"
      elif wm_have dnf; then pm="sudo dnf install -y"
      elif wm_have pacman; then pm="sudo pacman -S --noconfirm"; fi ;;
  esac
  if [ -z "$pm" ]; then
    wm_warn "no known package manager detected; install manually: $INSTALL_QUEUE"
  else
    full="$pm $INSTALL_QUEUE"
    do_it=0
    if [ "$AUTO_YES" = 1 ]; then
      do_it=1
    elif [ -t 0 ]; then
      printf 'Install missing packages now? [%s] (y/N) ' "$full"
      read ans
      case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
    else
      wm_warn "non-interactive; run: $full"
    fi
    if [ "$do_it" = 1 ]; then
      wm_info "running: $full"
      # shellcheck disable=SC2086
      if $full; then wm_ok "install complete"; else wm_err "install failed; run manually: $full"; fi
    fi
  fi
fi

# --- delegation guard hook (issue #17), user scope --------------------------
# Registers hooks/no-direct-edit-guard.sh in user-level Claude Code settings
# (~/.claude/settings.json by default) so it fires for wingman's own top-level
# session and any lead regardless of which repo it launches in - a project-
# level entry never loads for a session whose project root is elsewhere.
# Overridable so tests never touch a real developer machine's dotfile.
GUARD_HOOK="$WM_REPO/hooks/no-direct-edit-guard.sh"
GUARD_SETTINGS="${WM_CLAUDE_USER_SETTINGS:-$HOME/.claude/settings.json}"

# --- Bypass-Permissions mode acceptance (issue #16), user scope -------------
# Every crew session launches with --permission-mode bypassPermissions by
# default (bin/spawn-crew), so the very first crew spawn anywhere freezes on
# Claude Code's one-time Bypass-Permissions acceptance dialog unless it has
# already been accepted once, machine-wide. skipDangerousModePermissionPrompt
# in this same user settings file (GUARD_SETTINGS) is the persisted signal;
# bin/spawn-crew also re-checks it immediately before every spawn, as a
# safety net for a spawn that runs before this doctor check ever did.
if uv run --no-project --quiet "$WM_LIB/claude-gate-check.py" bypass-status --settings "$GUARD_SETTINGS"; then
  wm_ok "Bypass-Permissions mode already accepted ($GUARD_SETTINGS)"
else
  wm_warn "Bypass-Permissions mode not yet accepted ($GUARD_SETTINGS)"
  printf '    every crew session launches with --permission-mode bypassPermissions;\n'
  printf '    the very first crew spawn anywhere will otherwise freeze on this dialog\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Accept it now (write skipDangerousModePermissionPrompt: true)? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/claude-gate-check.py bypass-set --settings $GUARD_SETTINGS"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/claude-gate-check.py" bypass-set --settings "$GUARD_SETTINGS"; then
      wm_ok "accepted Bypass-Permissions mode"
    else
      wm_err "failed to accept Bypass-Permissions mode"
    fi
  fi
fi

if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$GUARD_HOOK" --check >/dev/null 2>&1; then
  wm_ok "delegation guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "delegation guard hook not registered in $GUARD_SETTINGS"
  printf '    blocks direct Edit/Write/test-runner calls at wingman'"'"'s top-level\n'
  printf '    session and any lead, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $GUARD_HOOK"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$GUARD_HOOK"; then
      wm_ok "registered delegation guard hook"
    else
      wm_err "failed to register delegation guard hook"
    fi
  fi
fi

# --- Artifact-publish contract hooks (crew sessions, any repo), user scope --
# hooks/artifact-publish-tracker.sh (PostToolUse + PostToolUseFailure) records
# Artifact publishes/failures and artifact-scan.sh fail-verdicts as markers;
# hooks/artifact-link-guard.sh (PreToolUse) gates a crew member's `crew-set
# --status review|done` on those markers (the status contract's condition B).
# Both must fire inside crew sessions whose project root is some other repo
# entirely, so like the delegation guard they need user-level registration - a
# project-level entry in this repo's settings never loads there. (The
# onboarding-preferences trio is the opposite case: wingman's own top-level
# session only, shipped via this repo's checked-in .claude/settings.json, no
# doctor step at all.)
artifact_hook_specs() {
  cat <<EOF
$WM_REPO/hooks/artifact-publish-tracker.sh PostToolUse Artifact|Bash
$WM_REPO/hooks/artifact-publish-tracker.sh PostToolUseFailure Artifact|Bash
$WM_REPO/hooks/artifact-link-guard.sh PreToolUse Bash
EOF
}
artifact_hooks_missing=0
while read -r _h _e _m; do
  [ -n "$_h" ] || continue
  uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
      --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --check >/dev/null 2>&1 \
    || artifact_hooks_missing=1
done <<EOF
$(artifact_hook_specs)
EOF
if [ "$artifact_hooks_missing" = 0 ]; then
  wm_ok "Artifact-publish contract hooks registered ($GUARD_SETTINGS)"
else
  wm_warn "Artifact-publish contract hooks not registered in $GUARD_SETTINGS"
  printf '    records Artifact publishes and gates crew deliverable reports on them,\n'
  printf '    for crew sessions in any repo, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register them now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; re-run bin/doctor -y to register them"
  fi
  if [ "$do_it" = 1 ]; then
    artifact_install_failed=0
    while read -r _h _e _m; do
      [ -n "$_h" ] || continue
      uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
          --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --matcher "$_m" >/dev/null \
        || artifact_install_failed=1
    done <<EOF
$(artifact_hook_specs)
EOF
    if [ "$artifact_install_failed" = 0 ]; then
      wm_ok "registered Artifact-publish contract hooks"
    else
      wm_err "failed to register Artifact-publish contract hooks"
    fi
  fi
fi

# --- Merge-authorization contract hooks (crew sessions, any repo), user scope
# hooks/no-merge-guard.sh (PreToolUse) denies gh pr merge/gh api merge-endpoint
# calls/a direct push to the default branch from a crew session absent an
# explicit, per-effort allow_merge grant (issue #46); hooks/merge-attribution-
# tracker.sh (PostToolUse) posts a PR comment identifying the crew member
# whenever an authorized merge does succeed, since crew act under the pilot's
# own GitHub credentials and mergedBy/author alone can never distinguish the
# two (issue #50). Both must fire inside crew sessions whose project root is
# some other repo entirely, so like the other crew-facing hooks they need
# user-level registration - a project-level entry in this repo's settings
# never loads there.
merge_hook_specs() {
  cat <<EOF
$WM_REPO/hooks/no-merge-guard.sh PreToolUse Bash
$WM_REPO/hooks/merge-attribution-tracker.sh PostToolUse Bash
EOF
}
merge_hooks_missing=0
while read -r _h _e _m; do
  [ -n "$_h" ] || continue
  uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
      --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --check >/dev/null 2>&1 \
    || merge_hooks_missing=1
done <<EOF
$(merge_hook_specs)
EOF
if [ "$merge_hooks_missing" = 0 ]; then
  wm_ok "merge-authorization contract hooks registered ($GUARD_SETTINGS)"
else
  wm_warn "merge-authorization contract hooks not registered in $GUARD_SETTINGS"
  printf '    denies crew-session merges by default and attributes any authorized one,\n'
  printf '    for crew sessions in any repo, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register them now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; re-run bin/doctor -y to register them"
  fi
  if [ "$do_it" = 1 ]; then
    merge_install_failed=0
    while read -r _h _e _m; do
      [ -n "$_h" ] || continue
      uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
          --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --matcher "$_m" >/dev/null \
        || merge_install_failed=1
    done <<EOF
$(merge_hook_specs)
EOF
    if [ "$merge_install_failed" = 0 ]; then
      wm_ok "registered merge-authorization contract hooks"
    else
      wm_err "failed to register merge-authorization contract hooks"
    fi
  fi
fi

# --- PR-open attribution marker hook (crew sessions, any repo), user scope --
# hooks/pr-open-marker-tracker.sh (PostToolUse) closes issue #50's remaining
# "beyond merges" gap: it prepends the same `<!-- wingman-crew:<id> -->`
# marker the merge-attribution comment and pr-watch's self-filter (issue
# #118) already use to every PR body a crew member opens via `gh pr create`,
# so a crew-authored PR is no longer indistinguishable from one the human
# wrote by hand. Must fire inside crew sessions whose project root is some
# other repo entirely, so like the other crew-facing hooks it needs
# user-level registration - a project-level entry in this repo's settings
# never loads there.
pr_open_marker_hook_specs() {
  cat <<EOF
$WM_REPO/hooks/pr-open-marker-tracker.sh PostToolUse Bash
EOF
}
pr_open_marker_hooks_missing=0
while read -r _h _e _m; do
  [ -n "$_h" ] || continue
  uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
      --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --check >/dev/null 2>&1 \
    || pr_open_marker_hooks_missing=1
done <<EOF
$(pr_open_marker_hook_specs)
EOF
if [ "$pr_open_marker_hooks_missing" = 0 ]; then
  wm_ok "PR-open attribution marker hook registered ($GUARD_SETTINGS)"
else
  wm_warn "PR-open attribution marker hook not registered in $GUARD_SETTINGS"
  printf '    marks every PR a crew member opens with the same attribution marker,\n'
  printf '    for crew sessions in any repo, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; re-run bin/doctor -y to register it"
  fi
  if [ "$do_it" = 1 ]; then
    pr_open_marker_install_failed=0
    while read -r _h _e _m; do
      [ -n "$_h" ] || continue
      uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
          --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --matcher "$_m" >/dev/null \
        || pr_open_marker_install_failed=1
    done <<EOF
$(pr_open_marker_hook_specs)
EOF
    if [ "$pr_open_marker_install_failed" = 0 ]; then
      wm_ok "registered PR-open attribution marker hook"
    else
      wm_err "failed to register PR-open attribution marker hook"
    fi
  fi
fi

# --- Watcher-protection guard (any session, any repo), user scope -----------
# hooks/no-watcher-kill-guard.sh (PreToolUse) denies a kill/pkill/tmux
# kill-window/tmux kill-session command whose target resolves to a currently
# live bin/watch-fleet cycle (issue #64 / #12: a live watcher's liveness is
# the only channel that lets a wake reach an idle orchestrator, and it has
# been killed by mistake before). Unlike the merge-authorization pair (crew
# sessions only) or the delegation guard (a lead or the wingman repo), there
# is no session type for which killing the watcher is ever legitimate - not
# the human's own top-level session, not a lead, not any other crew member -
# so this is registered unconditionally, with no crew-type gating at all.
WATCHER_KILL_HOOK="$WM_REPO/hooks/no-watcher-kill-guard.sh"
if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$WATCHER_KILL_HOOK" --event PreToolUse --matcher Bash --check >/dev/null 2>&1; then
  wm_ok "watcher-protection guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "watcher-protection guard hook not registered in $GUARD_SETTINGS"
  printf '    denies killing a live watch-fleet cycle from any session, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $WATCHER_KILL_HOOK --matcher Bash"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$WATCHER_KILL_HOOK" --event PreToolUse --matcher Bash; then
      wm_ok "registered watcher-protection guard hook"
    else
      wm_err "failed to register watcher-protection guard hook"
    fi
  fi
fi

# --- Foreground-watcher guard (any session, any repo), user scope ----------
# hooks/no-foreground-watcher-guard.sh (PreToolUse) denies an arming
# bin/watch-fleet/bin/pr-watch Bash call that is not `run_in_background:
# true`, and every detached form (nohup, setsid, a trailing `&`) even with
# it (issue #202: a delegate ran its own watcher in the foreground of a Bash
# tool call and sat wedged for 5h27m, invisible to the stall detector, since
# both scripts block until an event fires - that is their entire wake
# mechanism). Like the watcher-protection guard just above, there is no
# session type for which a foreground/detached arm is ever legitimate, so
# this is registered unconditionally, with no crew-type gating at all.
FOREGROUND_WATCHER_HOOK="$WM_REPO/hooks/no-foreground-watcher-guard.sh"
if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$FOREGROUND_WATCHER_HOOK" --event PreToolUse --matcher Bash --check >/dev/null 2>&1; then
  wm_ok "foreground-watcher guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "foreground-watcher guard hook not registered in $GUARD_SETTINGS"
  printf '    denies a foreground or detached watch-fleet/pr-watch arm from any session, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $FOREGROUND_WATCHER_HOOK --matcher Bash"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$FOREGROUND_WATCHER_HOOK" --event PreToolUse --matcher Bash; then
      wm_ok "registered foreground-watcher guard hook"
    else
      wm_err "failed to register foreground-watcher guard hook"
    fi
  fi
fi

# --- Foreground-poll-loop guard (any session, any repo), user scope --------
# hooks/no-foreground-poll-loop-guard.sh (PreToolUse) denies a Bash command
# containing an unbounded while/until loop with a sleep invocation anywhere
# in it, unless `run_in_background: true` (issue #268: two crew sessions
# hand-rolled a shell polling loop to wait on a long-running command and
# hard-deadlocked - one on a `pgrep -f` self-match, the other on a sentinel
# file a different process never wrote - costing roughly four hours
# combined, since neither could read incoming messages or self-diagnose
# while blocked inside the foreground tool call). Like the foreground-
# watcher guard just above, there is no session type for which a foreground
# hand-rolled polling loop is ever legitimate, so this is registered
# unconditionally, with no crew-type gating at all.
FOREGROUND_POLL_LOOP_HOOK="$WM_REPO/hooks/no-foreground-poll-loop-guard.sh"
if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$FOREGROUND_POLL_LOOP_HOOK" --event PreToolUse --matcher Bash --check >/dev/null 2>&1; then
  wm_ok "foreground-poll-loop guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "foreground-poll-loop guard hook not registered in $GUARD_SETTINGS"
  printf '    denies a foreground while/until+sleep polling loop from any session, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $FOREGROUND_POLL_LOOP_HOOK --matcher Bash"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$FOREGROUND_POLL_LOOP_HOOK" --event PreToolUse --matcher Bash; then
      wm_ok "registered foreground-poll-loop guard hook"
    else
      wm_err "failed to register foreground-poll-loop guard hook"
    fi
  fi
fi

# --- Interactive-prompt guard (crew sessions, any repo), user scope ---------
# hooks/no-interactive-prompt-guard.sh (PreToolUse) denies AskUserQuestion,
# EnterPlanMode, and ExitPlanMode outright for every crew session (issue
# #155): only the top-level wingman session is ever actually watched by a
# human in real time, so a worker or lead calling one of these would hang
# waiting for a choice nobody is present to make - or worse, have a
# later-arriving keystroke misread as input to an unrelated pending dialog.
# Must fire inside crew sessions whose project root is some other repo
# entirely, so like the other crew-facing hooks it needs user-level
# registration - a project-level entry in this repo's settings never loads
# there.
INTERACTIVE_PROMPT_HOOK="$WM_REPO/hooks/no-interactive-prompt-guard.sh"
INTERACTIVE_PROMPT_MATCHER="AskUserQuestion|EnterPlanMode|ExitPlanMode"
if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$INTERACTIVE_PROMPT_HOOK" --event PreToolUse --matcher "$INTERACTIVE_PROMPT_MATCHER" --check >/dev/null 2>&1; then
  wm_ok "interactive-prompt guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "interactive-prompt guard hook not registered in $GUARD_SETTINGS"
  printf '    denies AskUserQuestion/EnterPlanMode/ExitPlanMode from every crew session,\n'
  printf '    for crew sessions in any repo, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $INTERACTIVE_PROMPT_HOOK --matcher '$INTERACTIVE_PROMPT_MATCHER'"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$INTERACTIVE_PROMPT_HOOK" --event PreToolUse --matcher "$INTERACTIVE_PROMPT_MATCHER"; then
      wm_ok "registered interactive-prompt guard hook"
    else
      wm_err "failed to register interactive-prompt guard hook"
    fi
  fi
fi

# --- Outage-detection guard hook (crew sessions, any repo), user scope ------
# hooks/api-outage-spawn-guard.sh (PreToolUse) denies bin/spawn-crew while the
# fleet outage-state ($WM_HOME/api-outage-state.json) reads "active" (issue
# #23), so wingman and every lead stop adding load into a live Anthropic API
# outage; already-running crew are never touched. Must fire inside crew
# sessions whose project root is some other repo entirely, so like the other
# crew-facing hooks it needs user-level registration - a project-level entry
# in this repo's settings never loads there.
outage_hook_specs() {
  cat <<EOF
$WM_REPO/hooks/api-outage-spawn-guard.sh PreToolUse Bash
EOF
}
outage_hooks_missing=0
while read -r _h _e _m; do
  [ -n "$_h" ] || continue
  uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
      --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --check >/dev/null 2>&1 \
    || outage_hooks_missing=1
done <<EOF
$(outage_hook_specs)
EOF
if [ "$outage_hooks_missing" = 0 ]; then
  wm_ok "outage-detection guard hook registered ($GUARD_SETTINGS)"
else
  wm_warn "outage-detection guard hook not registered in $GUARD_SETTINGS"
  printf '    pauses new bin/spawn-crew calls while a fleet-wide API outage is active,\n'
  printf '    for crew sessions in any repo, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; re-run bin/doctor -y to register it"
  fi
  if [ "$do_it" = 1 ]; then
    outage_install_failed=0
    while read -r _h _e _m; do
      [ -n "$_h" ] || continue
      uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
          --settings "$GUARD_SETTINGS" --hook "$_h" --event "$_e" --matcher "$_m" >/dev/null \
        || outage_install_failed=1
    done <<EOF
$(outage_hook_specs)
EOF
    if [ "$outage_install_failed" = 0 ]; then
      wm_ok "registered outage-detection guard hook"
    else
      wm_err "failed to register outage-detection guard hook"
    fi
  fi
fi

# --- Usage-limit-quota detection (statusline + spawn guard), user scope ----
# bin/lib/usage-statusline.py is registered as the user-level `statusLine`
# command: it captures the Claude Code CLI's own proactive rate_limits
# signal (issue #24) from every session under this login, chaining to any
# statusline the pilot already configured so nothing visible changes.
# hooks/usage-limit-spawn-guard.sh (PreToolUse) denies bin/spawn-crew while
# the aggregated fleet-wide usage-quota state reads "approaching"/"paused" -
# the same shape as the outage-detection guard above, sharing its machinery
# (hooks/lib/spawn_pause_guard.py). Both need user-level registration for
# the same reason as every other crew-facing hook: a crew session's project
# root is some other repo entirely, where this repo's own project settings
# never load.
USAGE_STATUSLINE_SCRIPT="$WM_LIB/usage-statusline.py"
USAGE_GUARD_HOOK="$WM_REPO/hooks/usage-limit-spawn-guard.sh"

usage_statusline_registered() {
  uv run --no-project --quiet "$WM_LIB/install-user-statusline.py" \
      --settings "$GUARD_SETTINGS" --script "$USAGE_STATUSLINE_SCRIPT" --check >/dev/null 2>&1
}
usage_guard_registered() {
  uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
      --settings "$GUARD_SETTINGS" --hook "$USAGE_GUARD_HOOK" --event PreToolUse --check >/dev/null 2>&1
}

if usage_statusline_registered && usage_guard_registered; then
  wm_ok "usage-limit detection (statusline + spawn guard) registered ($GUARD_SETTINGS)"
else
  wm_warn "usage-limit detection not fully registered in $GUARD_SETTINGS"
  printf '    captures the CLI'"'"'s own proactive usage-quota signal and pauses new\n'
  printf '    bin/spawn-crew calls while a usage-limit window is approaching, machine-wide\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; re-run bin/doctor -y to register it"
  fi
  if [ "$do_it" = 1 ]; then
    usage_install_failed=0
    uv run --no-project --quiet "$WM_LIB/install-user-statusline.py" \
        --settings "$GUARD_SETTINGS" --script "$USAGE_STATUSLINE_SCRIPT" >/dev/null \
      || usage_install_failed=1
    uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
        --settings "$GUARD_SETTINGS" --hook "$USAGE_GUARD_HOOK" --event PreToolUse --matcher Bash >/dev/null \
      || usage_install_failed=1
    if [ "$usage_install_failed" = 0 ]; then
      wm_ok "registered usage-limit detection (statusline + spawn guard)"
    else
      wm_err "failed to register usage-limit detection"
    fi
  fi
fi

