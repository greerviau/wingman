# --- orchestrator guard-transport reconcile, non-Claude descriptors, user
# scope (docs/analysis/2026-08-18-remove-bin-wingman-launcher-spec.md, §4.5)
# --------------------------------------------------------------------------
# claude's own guard transport is registered above (the delegation/artifact/
# merge/etc. hooks, all via $WM_LIB/install-user-hook.py) and, separately,
# ships project-scoped with this repo's own .claude/settings.json (hooks/
# session-init.sh, hooks/orchestrator-guard-sync-gate.sh) - no action needed
# here for claude. codex, grok, opencode, and pi have never had ANY
# reconcile path reach a real machine before this migration: bin/lib/guard-
# transport.sh's own wm_guard_transport_sync existed, but its only caller was
# bin/wingman's orchestrator launch, itself gated behind a continuity-
# transport refusal that ran BEFORE the guard-transport install for every
# non-claude agent - so the install code was live but unreachable in
# practice (confirmed: no other caller exists anywhere in this codebase,
# crew-side included). This is the fix: the SAME reconcile+self-test every
# non-Claude orchestrator's own bootstrap (bin/lib/orchestrator-bootstrap.sh)
# performs on its own first tool call, offered here too as the interactive,
# no-tool-call-needed path bin/doctor already provides for every other guard
# hook - the acceptance bar the migration's own design (§4.5) is built
# around ("no manual setup beyond whatever bin/doctor already offers to do
# interactively from inside the session").
#
# Unconditional per descriptor (matching the crew-command-vocabulary check's
# own precedent below, which never gates on whether the CLI is even
# installed): a machine with no codex/grok/opencode/pi binary on PATH simply
# gets wm_guard_transport_sync's own "not on PATH" message as a warning, the
# same as any other missing-optional-dependency finding in this script -
# never a hard failure (these four are optional orchestrator choices, not
# required dependencies of using wingman on claude).
_wm_gt_check() {
  _wgtc_agent="$1"
  ( wm_agent_resolve "$_wgtc_agent" 2>/dev/null ) >/dev/null 2>&1 || {
    wm_warn "$_wgtc_agent: no agent descriptor found (bin/lib/agents/$_wgtc_agent.sh) - skipping"
    return
  }
  # wm_agent_resolve sets shell variables in the CALLING shell, so this
  # cannot run inside the subshell used for the existence probe above -
  # resolve for real, here, in this function's own scope.
  wm_agent_resolve "$_wgtc_agent"
  # wm_guard_transport_sync is itself both the reconcile AND the verify step
  # (every branch installs/writes THEN self-tests, unconditionally, every
  # call - unlike claude's own sections above, which have a genuinely
  # separate --check probe before deciding whether to install anything) - so
  # a fresh, never-configured machine already succeeds on this FIRST call,
  # having just installed everything it needed to. The "not installed"
  # branch below is therefore reached only by a problem retrying the
  # identical operation will not fix on its own (a missing binary, a broken
  # hook script, grok's own env-var precondition) - offered anyway, since
  # the operator may fix the underlying cause and want to retry without
  # re-running doctor from scratch.
  if _wgtc_out="$(wm_guard_transport_sync "$WM_AGENT_GUARD_TRANSPORT" "$WM_REPO" 2>&1)"; then
    wm_ok "$_wgtc_agent's guard transport ($WM_AGENT_GUARD_TRANSPORT) is installed and self-tests correctly"
    # A stale "fail" cache entry from an earlier, broken bootstrap attempt
    # could still be sitting under $WM_HOME/orchestrator-bootstrap/ (the
    # orchestrator's own PreToolUse gate, hooks/lib/guard_dispatch.py's own
    # _orchestrator_bootstrap_gate, reads that cache before ever calling
    # this function again) even though THIS check just confirmed everything
    # is fine now - clear it unconditionally on success (not just after a
    # retry that needed one) so the very next tool call re-bootstraps clean
    # rather than replaying a now-stale failure.
    rm -rf "$WM_HOME/orchestrator-bootstrap" 2>/dev/null
    unset _wgtc_agent _wgtc_out
    return
  fi
  wm_warn "$_wgtc_agent's guard transport ($WM_AGENT_GUARD_TRANSPORT) is not installed/verified: $_wgtc_out"
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_REPO/bin/lib/orchestrator-bootstrap.sh --agent $_wgtc_agent --repo $WM_REPO"
  fi
  if [ "$do_it" = 1 ]; then
    if _wgtc_out2="$(wm_guard_transport_sync "$WM_AGENT_GUARD_TRANSPORT" "$WM_REPO" 2>&1)"; then
      wm_ok "registered and verified $_wgtc_agent's guard transport"
      rm -rf "$WM_HOME/orchestrator-bootstrap" 2>/dev/null
    else
      wm_err "still could not register $_wgtc_agent's guard transport: $_wgtc_out2"
    fi
    unset _wgtc_out2
  fi
  unset _wgtc_agent _wgtc_out
}
# WM_DOCTOR_SKIP_ORCH_GUARD_TRANSPORTS=1 skips this whole block - a test-only
# escape hatch (tests/doctor.test.sh calls `bin/doctor -y` many times to
# exercise OTHER, unrelated sections; each of these four checks pays a real
# self-test subprocess per transport, which adds up fast across repeated
# calls - see tests/doctor-orchestrator-guard-transports.test.sh for the
# dedicated coverage of this block itself, unskipped). Never set this in
# real use: skipping it is exactly skipping the self-heal this block exists
# to provide.
if [ "${WM_DOCTOR_SKIP_ORCH_GUARD_TRANSPORTS:-0}" != 1 ]; then
  for _wgtc_name in codex grok opencode pi; do
    _wm_gt_check "$_wgtc_name"
  done
  unset _wgtc_name
fi

# --- the portable crew command vocabulary, user scope -----------------------
# codex and grok have no per-launch flag for an arbitrary skills directory
# (pi does; opencode's own OPENCODE_CONFIG_DIR route is per-launch too and
# needs no install here), so each is served by a small, idempotent symlink
# set into its own user-level skills directory, reconciled against this
# repo's own canonical .agents/skills/ tree. Preflight (bin/lib/agents/
# {codex,grok}.sh) is the primary reconcile path, on every spawn/resume;
# this is the secondary, inspectable/repairable path for checking or fixing
# the installed state outside of a spawn. Overridable target directories
# mirror every other user-scope check above, for tests.
#
# _wm_sync_vocab_check <adapter> <target> <mode> - <mode> MUST be the exact
# value that adapter's own preflight function would pass (WM_CODEX_SKILLS_
# SYNC_MODE / WM_GROK_SKILLS_SYNC_MODE, defaulting to symlink like each
# preflight does) - never a bare default here. Passing a different mode
# than preflight uses would make this "repair" path actively destructive:
# a correct copy-mode install (the documented fallback for an adapter that
# does not follow a symlinked skill directory) would read as "not fully
# installed" under the wrong mode and get silently replaced with symlinks.
_wm_sync_vocab_check() {
  _svc_adapter="$1"; _svc_target="$2"; _svc_mode="$3"
  if uv run --no-project --quiet "$WM_LIB/sync-user-skills.py" --target "$_svc_target" --repo "$WM_REPO" --mode "$_svc_mode" --check >/dev/null 2>&1; then
    wm_ok "$_svc_adapter's crew command vocabulary is installed ($_svc_target, $_svc_mode mode)"
    return
  fi
  wm_warn "$_svc_adapter's crew command vocabulary is not fully installed ($_svc_target, $_svc_mode mode)"
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Install it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/sync-user-skills.py --target $_svc_target --repo $WM_REPO --mode $_svc_mode"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/sync-user-skills.py" --target "$_svc_target" --repo "$WM_REPO" --mode "$_svc_mode" >/dev/null 2>&1; then
      wm_ok "installed $_svc_adapter's crew command vocabulary"
    else
      wm_err "failed to install $_svc_adapter's crew command vocabulary"
    fi
  fi
}
_wm_sync_vocab_check codex "${WM_CODEX_USER_SKILLS_DIR:-$HOME/.agents/skills}" "${WM_CODEX_SKILLS_SYNC_MODE:-symlink}"
_wm_sync_vocab_check grok "${WM_GROK_USER_SKILLS_DIR:-$HOME/.grok/skills}" "${WM_GROK_SKILLS_SYNC_MODE:-symlink}"
unset _svc_adapter _svc_target _svc_mode

# --- the settings file ------------------------------------------------------
# A hand-edited config.local.toml is the one part of an install a pull cannot
# keep correct, and a typo there fails quietly by nature: an unknown key simply
# never applies, so a pilot who set `verbostiy = "detailed"` believes it is in
# force and only ever sees the default. Doctor is where that surfaces. It is a
# hard failure, not a warning: `bin/config --check` exits non-zero, and a
# settings file wingman is silently ignoring is not a green install.
echo
wm_info "settings file"
if [ ! -f "$WM_CONFIG_TOML" ]; then
  wm_ok "no config.local.toml - every setting is on its default (see config.example.toml)"
elif "$WM_BIN/config" --check >/dev/null 2>&1; then
  wm_ok "config.local.toml is valid"
else
  "$WM_BIN/config" --check || true
  wm_err "fix the settings file above (or delete it), then re-run: bin/doctor"
  MISSING_REQUIRED=1
fi

echo
if [ "$MISSING_REQUIRED" = 0 ]; then
  wm_ok "all required dependencies present"
  # Make sure the state home exists once we're green.
  wm_state init >/dev/null
  exit 0
else
  # Deliberately not "required dependencies missing": an invalid settings file
  # trips this same exit with every dependency present.
  wm_err "wingman is not ready - resolve the items above, then re-run: bin/doctor"
  exit 1
fi
