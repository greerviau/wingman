# --- fleet-continuity Stop hooks (issue #185), project scope ----------------
# hooks/stop-guard.sh and hooks/stop-continuity.sh are wired only for wingman's
# own top-level session, via THIS repo's own checked-in .claude/settings.json
# (not GUARD_SETTINGS, which is user scope) - this repo's first project-level
# doctor check (until now there was none at all, per the onboarding-
# preferences trio's own comment above). Report-only: the settings file is
# version-controlled, so a failure here means a stale or broken checkout, not
# something to auto-install - the remedy is re-checking the checkout or
# `chmod +x`, never an installer run.
# Overridable so tests can point this at a fixture instead of mutating the
# real checkout's own settings.json/hooks - the same pattern
# WM_CLAUDE_USER_SETTINGS already uses for GUARD_SETTINGS above.
PROJECT_SETTINGS="${WM_PROJECT_SETTINGS:-$WM_REPO/.claude/settings.json}"
STOP_GUARD_SCRIPT="${WM_STOP_GUARD_SCRIPT:-$WM_REPO/hooks/stop-guard.sh}"
STOP_CONTINUITY_SCRIPT="${WM_STOP_CONTINUITY_SCRIPT:-$WM_REPO/hooks/stop-continuity.sh}"
continuity_hooks_ok=1
if ! wm_py -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
min_timeout = int(sys.argv[2])
stops = d.get("hooks", {}).get("Stop", [])
guard_ok = False
continuity_ok = False
for entry in stops:
    for h in entry.get("hooks", []):
        cmd = h.get("command", "")
        if "stop-guard.sh" in cmd:
            guard_ok = True
        if "stop-continuity.sh" in cmd and h.get("asyncRewake") is True \
                and isinstance(h.get("timeout"), int) and h["timeout"] >= min_timeout:
            continuity_ok = True
sys.exit(0 if (guard_ok and continuity_ok) else 1)
' "$PROJECT_SETTINGS" "$WM_CONTINUITY_TIMEOUT_MIN" >/dev/null 2>&1; then
  continuity_hooks_ok=0
fi
if [ ! -x "$STOP_GUARD_SCRIPT" ] || [ ! -x "$STOP_CONTINUITY_SCRIPT" ]; then
  continuity_hooks_ok=0
fi
if [ "$continuity_hooks_ok" = 1 ]; then
  wm_ok "fleet-continuity Stop hooks registered ($PROJECT_SETTINGS)"
else
  wm_warn "fleet-continuity Stop hooks not registered/executable in $PROJECT_SETTINGS"
  printf '    expected a Stop entry referencing hooks/stop-guard.sh and one referencing\n'
  printf '    hooks/stop-continuity.sh with "asyncRewake": true and "timeout" >= %s, both\n' "$WM_CONTINUITY_TIMEOUT_MIN"
  printf '    scripts executable - this file is version-controlled, so the remedy is\n'
  printf '    re-checking the checkout or chmod +x, never an install\n'
fi

# --- fleet-continuity Stop hooks (issue #199), crew sessions, user scope ----
# hooks/stop-guard-crew.sh and hooks/stop-continuity-crew.sh extend the #185
# fleet-continuity Stop hooks above to crew sessions (a lead's own session, or
# any worker) whose project root is some other repo, where this repo's own
# project-scoped .claude/settings.json never loads - same rationale as the
# interactive-prompt guard block above. Each wrapper no-ops for wingman's own
# top-level session (WINGMAN_CREW_ID unset) and exec's into the identical,
# unmodified hooks/stop-guard.sh / hooks/stop-continuity.sh for a crew
# session; see the wrapper files themselves for why the gate must live there
# rather than in the real scripts.
# Overridable so tests can point these at a throwaway fixture instead of the
# real checked-in wrapper files, the same pattern STOP_GUARD_SCRIPT/
# STOP_CONTINUITY_SCRIPT already use above for the project-scope check.
STOP_GUARD_CREW_HOOK="${WM_STOP_GUARD_CREW_SCRIPT:-$WM_REPO/hooks/stop-guard-crew.sh}"
STOP_CONTINUITY_CREW_HOOK="${WM_STOP_CONTINUITY_CREW_SCRIPT:-$WM_REPO/hooks/stop-continuity-crew.sh}"
STOP_CONTINUITY_CREW_SUMMARY="Wingman fleet continuity (crew)"
continuity_crew_hooks_ok=1
if ! uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$STOP_GUARD_CREW_HOOK" --event Stop --check >/dev/null 2>&1; then
  continuity_crew_hooks_ok=0
fi
if ! uv run --no-project --quiet "$WM_LIB/install-user-hook.py" \
    --settings "$GUARD_SETTINGS" --hook "$STOP_CONTINUITY_CREW_HOOK" --event Stop \
    --async-rewake --timeout "$WM_CONTINUITY_TIMEOUT_MIN" --rewake-summary "$STOP_CONTINUITY_CREW_SUMMARY" --check >/dev/null 2>&1; then
  continuity_crew_hooks_ok=0
fi
if [ ! -x "$STOP_GUARD_CREW_HOOK" ] || [ ! -x "$STOP_CONTINUITY_CREW_HOOK" ]; then
  continuity_crew_hooks_ok=0
fi
if [ "$continuity_crew_hooks_ok" = 1 ]; then
  wm_ok "fleet-continuity Stop hooks (crew) registered ($GUARD_SETTINGS)"
else
  wm_warn "fleet-continuity Stop hooks (crew) not registered/executable in $GUARD_SETTINGS"
  printf '    extends the project-scope fleet-continuity constraint to crew sessions in any repo,\n'
  printf '    machine-wide (a lead'"'"'s own session gets the same no-idle-blind guarantee)\n'
  do_it=0
  if [ "$AUTO_YES" = 1 ]; then
    do_it=1
  elif [ -t 0 ]; then
    printf 'Register it now? (y/N) '
    read ans
    case "$ans" in y|Y|yes|YES) do_it=1 ;; esac
  else
    wm_warn "non-interactive; run: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $STOP_GUARD_CREW_HOOK --event Stop"
    wm_warn "            and: uv run --no-project $WM_LIB/install-user-hook.py --settings $GUARD_SETTINGS --hook $STOP_CONTINUITY_CREW_HOOK --event Stop --async-rewake --timeout $WM_CONTINUITY_TIMEOUT_MIN --rewake-summary '$STOP_CONTINUITY_CREW_SUMMARY'"
  fi
  if [ "$do_it" = 1 ]; then
    if uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$STOP_GUARD_CREW_HOOK" --event Stop >/dev/null \
        && uv run --no-project --quiet "$WM_LIB/install-user-hook.py" --settings "$GUARD_SETTINGS" --hook "$STOP_CONTINUITY_CREW_HOOK" --event Stop --async-rewake --timeout "$WM_CONTINUITY_TIMEOUT_MIN" --rewake-summary "$STOP_CONTINUITY_CREW_SUMMARY" >/dev/null; then
      wm_ok "registered fleet-continuity Stop hooks (crew)"
    else
      wm_err "failed to register fleet-continuity Stop hooks (crew)"
    fi
  fi
fi

