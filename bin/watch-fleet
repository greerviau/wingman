#!/usr/bin/env bash
# watch-fleet - the zero-token supervisor, armed as a harness-tracked background
# task - NEVER in the foreground of the arming Bash call, and never a detached
# daemon (nohup/setsid/a trailing &). This script BLOCKS until an event fires -
# that is its entire wake mechanism - so a foreground arm wedges the calling
# session indefinitely (issue #202) and a detached one exits where nothing is
# tracking it to notice. If you cannot arm it as a harness-tracked background
# task, arm nothing: no watcher at all is strictly better than a foreground
# one, because a missing watcher is recoverable and a wedged session is not.
# hooks/no-foreground-watcher-guard.sh mechanically enforces this at the
# tool-call boundary. One "cycle" is a single run of this script: wingman
# starts it in the background, it BLOCKS - watching crew status files and
# tmux window liveness, absorbing benign "still working" updates - and only EXITS
# the moment a crew member flips to an attention state (blocked/review/done/died/
# stalled) or freezes on a prompt. Because it is a task the agent harness tracks,
# that exit is the wake: the harness re-invokes wingman, which handles the event
# and arms exactly one fresh cycle. A file on disk cannot rouse an idle session,
# so the exit-of-a-tracked-task is the only reliable wake channel; this script
# therefore never tries to inject keystrokes into wingman's terminal.
#
# The pane backstop covers the failure shapes the status files cannot see: a
# member frozen on an interactive permission/trust prompt (flipped to blocked);
# and a member silently stalled - no pane output, no status update, and an
# execution probe finding nothing running in its pane's process tree. A stall
# candidate always gets one check-in nudge first (a plain message into its pane -
# the API/connectivity-error-specific wording if the pane tail matches that
# signature, a generic "checking in" message otherwise), then a full cooldown
# window of continued silence before wm-state stall-check actually flips it to
# stalled; a member that resumes on its own or in response to the nudge never
# flips at all. This keeps a transient spend-limit episode, network blip, or
# brief Anthropic-side outage from escalating straight to the pilot before the
# member has had a chance to recover unassisted. The nudge also stamps
# nudged_at onto the member's own status JSON (#155), so a still-'working'
# member mid-self-heal is visibly distinguishable in crew-list/board.md from
# one that is simply healthy and busy, instead of looking identical to both a
# human and to the owning lead's own watcher.
#
# Fleet-wide outage detection (#23): wingman's own top-level cycle (owner "")
# also tracks a persisted outage-state machine ($WM_HOME/api-outage-state.json,
# see wm_state outage-update) from the SAME per-member API-error signal plus
# how many members die each poll with an API-error pane tail on record
# (wm_state reconcile's death_cause tagging). Crossing the fleet-wide mass
# threshold (the same thresholds group-attention already applies to a single
# poll's batch) fires an outage-detected event; a quiet period after that
# fires outage-cleared. hooks/api-outage-spawn-guard.sh reads this state to
# pause new bin/spawn-crew calls while active - already-running crew are
# never touched.
#
# Proactive usage-limit-quota detection (#24): the SAME owner-"" cycle also
# aggregates every $WM_HOME/usage/<session-id>.json (written by the
# installed statusLine command, bin/lib/usage-statusline.py, from the
# Claude Code CLI's own rate_limits statusline signal) into a persisted
# usage-quota-approach state machine ($WM_HOME/usage-limit-state.json, see
# wm_state usage-update). Crossing the warn threshold fires
# usage-limit-approaching; the window resetting fires usage-limit-reset.
# hooks/usage-limit-spawn-guard.sh reads this state to pause new
# bin/spawn-crew calls while unresolved (approaching) or while the pilot
# chose to wait (paused) - already-running crew are never touched, and this
# does not checkpoint or park in-flight work (see docs/architecture.md's
# "Fleet-wide usage-limit-quota detection" section for the rationale). Unlike
# #23, this decision needs the pilot's explicit wait-vs-continue answer
# (wm_state usage-decide), so wingman's own
# CLAUDE.md tells it what to do on this fire. The same aggregation pass also
# sweeps any usage/*.json file whose captured_at is older than
# WM_USAGE_SWEEP_SECS (default 24h), since its owning session has long since
# ended (#125).
#
# Outbox abandonment (#169): bin/crew-say/crew-ask/spawn-crew each queue a
# message under outbox/<id>/ when a delivery cannot be confirmed. Every
# cycle - regardless of owner scope - also runs a generic scan that sweeps
# any such message whose target has since gone stood-down/died/done-with-no-
# live-window: the payload is archived under outbox-abandoned/<id>/, logged
# to outbox-abandoned.log, and a notice is queued to the sender (or, if the
# sender is itself unreachable, routed up the parent chain into
# pending-notices[-<owner>], folded into this cycle's own wake file the next
# time it fires) - unless the sender is itself notice-routing-terminal too,
# in which case the archive and log line are still written but no notice is
# queued at all: nobody involved could act on it, so it must not be able to
# fire a full attention wake on its own (issue #230). Wingman's own top-level
# cycle additionally runs a
# whole-fleet backstop over every OTHER pending outbox with a live window, so
# a still-reachable nested member is not left waiting solely on its own
# lead's watcher. See lib/common.sh's wm_outbox_* helpers for the mechanism.
#
# On fire, stdout carries the reason lines plus a directive to report the full
# roster; the wake file carries the new events plus the owner-scoped roster
# snapshot to report from.
#
# Benign wakes are absorbed for free: a crew member merely refreshing its
# "working" summary never appears in `needs-attention`, so the loop keeps blocking
# and no wingman turn is spent. Only an actionable event ends the cycle.
#
# At-least-once delivery: the loop checks `needs-attention` at the TOP of each
# iteration (before sleeping), so if something is already pending the instant a
# fresh cycle is armed, it fires immediately. That covers the gap between one
# cycle firing and wingman arming the next - a second crew member finishing in
# that window is surfaced by the next arm, not lost.
#
# Singleton: a genuinely live cycle (identity-verified pid+start-time match,
# not a beacon-freshness proxy - issue #237) makes a second arm print `watcher:
# healthy` and exit without starting a rival loop, so wingman can re-arm
# defensively without spawning duplicates. A cycle that holds the lock but has
# gone quiet for WM_WATCH_HARD_GRACE (default 300s) is wedged, not healthy -
# the next arm takes it over (SIGTERM, then SIGKILL if that doesn't reap it)
# rather than reporting it healthy forever. Read the printed status line -
# `armed`, `healthy`, or a `blocked:/review:/done:/died:/stalled:` reason - as
# the source of truth. `healthy` is run-scoped (#162): each cycle stamps its
# arming session's $WINGMAN_RUN_ID, and an arm from a different run replaces a
# live foreign cycle (an orphan from a prior, ended run cannot wake the
# current session) instead of adopting it - it prints `armed`, never
# `healthy`, in that case. Only when the arming session has no run id at all
# is a live cycle accepted as healthy without an ownership check.
#
# Owner scope: each cycle watches exactly one owner's direct reports. Wingman arms
# its own cycle (--owner "" - it has no $WINGMAN_CREW_ID) and never sees a lead's
# workers; a lead arms its own (--owner <lead-id>, the default from its
# $WINGMAN_CREW_ID) and sees only its crew. The pidfile/beacon/wake are keyed by
# owner so wingman's watcher and each lead's watcher coexist without contending.
#
# Usage:
#   watch-fleet            arm one cycle for the caller's own crew: block until an
#                          actionable event, then exit with the reason. Run as a
#                          harness-tracked background task (e.g. Bash
#                          run_in_background), never bundled onto another command.
#   watch-fleet --owner <id>  watch a specific owner's crew ("" = top level).
#                          Defaults to $WINGMAN_CREW_ID, so wingman and a lead each
#                          arm a bare `watch-fleet` and it self-scopes.
#   watch-fleet --status   report whether a live cycle exists (pid + beacon).
#   watch-fleet --stop      stop the current cycle (manual/testing).
#   watch-fleet --start    deprecated alias for arming; warns, then blocks.
#   watch-fleet --classify [--owner <id>]
#                          classify the just-completed cycle's exit with no
#                          stdin: reads (and consumes) the exit-record this
#                          script itself wrote at its own exit point, or, if
#                          none is present, checks whether a fresh cycle is
#                          already live. Prints exactly one of six outcomes on
#                          stdout - `healthy`, `fire`, `remote-control-dropped`,
#                          `stopped` (bare tokens), or `spurious <count> <hint>` /
#                          `spurious-repeated <count> <hint>` (a consecutive-
#                          failure count and a forensic hint) - and exits 0.
#                          `stopped` means the last cycle ended via a deliberate
#                          `--stop`, not a failure - never auto-re-arm on this
#                          alone. Dispatched before claim-lock acquisition:
#                          never creates the claim lock, never mutates
#                          $PIDFILE/$BEATFILE/$OWNERLOCK (it legitimately
#                          reads all three via the cycle_healthy check).
#                          Intended caller: the `/watch` skill, immediately
#                          after its armed cycle exits.
#   watch-fleet --clear-standdown [--owner <id>]
#                          lift a tripped spurious-repeated failure-budget
#                          standdown (issue #198): removes $SUPPRESSEDFILE and
#                          exits 0. Does NOT arm a cycle - fleet continuity
#                          (hooks/stop-continuity.sh) does that on the next
#                          Stop event, which is the only path that produces a
#                          genuinely supervised cycle. A no-op, exit 0, if no
#                          standdown is in force. The explicit, pilot-directed
#                          way out of a standdown; hooks/no-foreground-
#                          watcher-guard.sh denies every other arm attempt
#                          while one holds.
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"

# Resolved once, at startup (issue #237, part 1): the worktree-removal
# self-check below tests this directory's continued existence every poll. A
# cycle armed from a worktree that is later removed (a developer's tree
# deleted at merge/close time) has nothing left to watch from - resolving
# this once, up front, means the check itself costs one plain directory test,
# no subprocess.
SELF_BIN_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# Immunize the wake loop against SIGURG (signal 16). This script is armed as a
# harness-tracked background task, and its exit is the only channel that wakes an
# idle managing session; a stray SIGURG that reaches it terminates the process
# (exit 144 = 128+16) and silently ends that session's turn. SIGURG's default
# disposition is "ignore", but the background-launch environment can hand the
# process a non-default disposition, and the per-poll subprocess churn (pane
# capture, `ps` scan, the stall probe's blocking child) widens the window for one
# to land fatally. Setting it to SIG_IGN here is unconditional and inherited by
# every child spawned below, so neither the loop nor its probes can be killed by a
# signal that carries no meaning for this tool.
trap '' URG

wm_state init >/dev/null

# --- parse owner scope + mode -----------------------------------------------
# The owner this cycle watches defaults to the caller's own crew id ("" = wingman,
# the top orchestrator). --owner overrides it.
OWNER="${WINGMAN_CREW_ID:-}"
MODE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --owner) OWNER="${2:-}"; shift 2 ;;
    --status|--stop|--start|--classify|--clear-standdown|arm|__loop) MODE="$1"; shift ;;
    "") shift ;;
    -h|--help) sed -n '2,155p' "$0"; exit 0 ;;
    *) wm_die "unknown arg: $1" ;;
  esac
done

# Key the singleton files by owner so per-owner watchers never contend. Owner ""
# (wingman) keeps the legacy filenames so its references and the Stop hook are
# unchanged; a non-empty owner is sanitized into a filesystem-safe suffix.
if [ -n "$OWNER" ]; then
  _key="$(printf '%s' "$OWNER" | tr -c 'A-Za-z0-9._-' '_')"
  PIDFILE="$WM_HOME/watch-$_key.pid"
  WAKEFILE="$WM_HOME/wake-$_key"
  BEATFILE="$WM_HOME/watch-$_key.beat"
  EXITFILE="$WM_HOME/watch-exit-$_key"
  SPURCOUNTFILE="$WM_HOME/watch-spurious-count-$_key"
  RUNFILE="$WM_HOME/watch-$_key.run"
  # The pending-notice channel the outbox scan's `wake` mode writes into
  # (issue #169), keyed identically to the files above - a lead's own cycle
  # reads its own notices here.
  NOTICEFILE="$WM_HOME/pending-notices-$_key"
  # The three markers hooks/stop-continuity.sh reads/writes for tokenless
  # auto-arm (issue #185), cleared unconditionally at the claim point below.
  # Re-derived independently in hooks/lib/watcher-liveness.sh's own
  # wm_owner_paths - a known, accepted duplication (see the plan's "Files
  # touched" section) - a cross-derivation regression test asserts the two
  # derivations agree.
  STOPFILE="$WM_HOME/watch-$_key.stopped"
  SUPPRESSEDFILE="$WM_HOME/watch-$_key.suppressed"
  CLAIMFAILFILE="$WM_HOME/stop-continuity-$_key.claimfail"
  # Fix 2b's per-owner debounce counter (issue #237, part 1): consecutive
  # ambiguous crew-get reads before the owner-status self-check treats the
  # owner as genuinely gone. Owner-keyed exactly like the files above.
  OWNERCHECKFILE="$WM_HOME/watch-$_key.ownercheck"
else
  PIDFILE="$WM_HOME/watch.pid"
  WAKEFILE="$WM_HOME/wake"
  BEATFILE="$WM_HOME/watch.beat"
  EXITFILE="$WM_HOME/watch-exit"
  SPURCOUNTFILE="$WM_HOME/watch-spurious-count"
  RUNFILE="$WM_HOME/watch.run"
  NOTICEFILE="$WM_HOME/pending-notices"
  STOPFILE="$WM_HOME/watch.stopped"
  SUPPRESSEDFILE="$WM_HOME/watch.suppressed"
  CLAIMFAILFILE="$WM_HOME/stop-continuity.claimfail"
  # Unused - Fix 2b is skipped for owner="" - kept only for naming symmetry
  # with the rest of this block, matching how STOPFILE/SUPPRESSEDFILE both
  # keep a legacy unscoped name here too.
  OWNERCHECKFILE="$WM_HOME/watch.ownercheck"
fi
# The claim-lock path is needed both by --classify's stale-claim-lock check
# (dispatched before claim-lock acquisition) and by the claim loop itself
# further below, so it is defined once, here, ahead of both.
CLAIMLOCK="$PIDFILE.lock"
# The true singleton-lifetime lock (issue #237, part 2): unlike $CLAIMLOCK
# (held only across the sub-second check-then-claim), $OWNERLOCK is held for
# the cycle's entire lifetime and is what the singleton guard trusts for "is
# anything holding this at all" - see owner_lock_alive() below.
OWNERLOCK="$PIDFILE.owner"
# One shared forensic log across every owner (never owner-keyed): each line
# carries its own owner column, so a human reading it after the fact sees the
# whole fleet's history in one place rather than needing to know which
# per-owner file to open.
SPURLOG="$WM_HOME/watch-spurious.log"
spurlog() {
  # timestamp \t owner \t kind \t detail
  printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${OWNER:-<top>}" "$1" "$2" >> "$SPURLOG"
}
INTERVAL="${WM_WATCH_INTERVAL:-5}"
# Hard-staleness threshold (issue #237, part 2): far above any ordinary
# stall, so it can never fire on one - only a cycle that has produced zero
# beacon progress for this long is treated as wedged. The singleton guard
# (owner_lock_alive()/cycle_healthy() below) trusts identity, not beacon
# freshness, for ordinary "is this claimed at all" liveness; this threshold's
# only job is bounding recovery from a genuine wedge, never exclusivity - a
# cycle stalled for anywhere under this is never stolen from. 10x the former
# WM_WATCH_GRACE default (30s) by default.
WM_WATCH_HARD_GRACE="${WM_WATCH_HARD_GRACE:-300}"
# Silent-stall detection. STALL_IDLE seconds of BOTH pane-output silence AND
# status-file staleness nominates a 'working' member; it is flagged stalled only if
# the execution probe (see wm-state stall-check) then finds no late-started
# descendant process and no CPU activity in its pane's process tree.
STALL_IDLE="${WM_STALL_IDLE:-180}"
STALL_ROOT_GRACE="${WM_STALL_ROOT_GRACE:-30}"
STALL_PROBE_GAP="${WM_STALL_PROBE_GAP:-10}"
STALL_CPU_EPS="${WM_STALL_CPU_EPS:-0.5}"
# Stalled re-evaluation (issue #235): consecutive CONTRADICTING polls (see
# wm_state stall-recheck) required before a 'stalled' record is auto-reverted.
# Hard-floored to 2 in code regardless of this value - a watcher's first poll
# for any member always reads PANE_STABLE=0 (no prior hash), which reads as
# 'pane changed', so a value of 1 here would let every watcher restart clear
# every liveness stall on the spot.
WM_STALL_RECHECK_CONFIRMS="${WM_STALL_RECHECK_CONFIRMS:-2}"
# Consecutive polls a check-in nudge can go undelivered (rc 2 dialog-shaped, 4
# lock-contended, 6 busy-with-pending-composer - issue #214) before the escape
# hatch fires, so an unreachable member still eventually flips 'stalled'
# instead of being exempt from escalation forever. See the stall-nudge block
# below and wm-state.py's cmd_stall_check.
WM_NUDGE_REFUSED_MAX="${WM_NUDGE_REFUSED_MAX:-3}"
# Bounded retry for the stall self-heal nudge (issue #236). TRIES counts only
# attempts that left text in the target's composer (wm_tmux_send_message rc
# 3/5); a refusal that typed nothing (rc 2/4/6 - the WM_NUDGE_REFUSED_MAX
# escape hatch above is what bounds THAT case) is retried next poll and never
# burns this budget. TTL bounds a marker's life so a concluded episode's
# marker can never gate a later one - it must stay comfortably above
# STALL_IDLE or the flip window collapses (the #101 failure mode), hence the
# floor.
WM_STALL_NUDGE_TRIES="${WM_STALL_NUDGE_TRIES:-2}"
WM_STALL_NUDGE_TTL="${WM_STALL_NUDGE_TTL:-$(( STALL_IDLE * (WM_STALL_NUDGE_TRIES + 2) ))}"
if [ "$WM_STALL_NUDGE_TTL" -lt $(( STALL_IDLE * 2 )) ]; then
  wm_warn "WM_STALL_NUDGE_TTL ($WM_STALL_NUDGE_TTL) is below 2x WM_STALL_IDLE; clamping to $(( STALL_IDLE * 2 ))"
  WM_STALL_NUDGE_TTL=$(( STALL_IDLE * 2 ))
fi
# Foreground-watcher wedge detection (issue #202, layer B - wm-state
# wedge-check). WM_WEDGE_SECS is the continuous-liveness window (30 min,
# matching WM_FORWARD_MOTION_SECS); WM_WEDGE_PANE_GAP is the pane silence
# that resets the continuity anchor - measured at ~30x below the healthy
# ceiling (docs/analysis/2026-08-03-issue-202-wedge-measurement.md). The two
# are not independent: a healthy pane's longest live run saturates just past
# WM_WEDGE_PANE_GAP by construction, so the real safety margin is the ratio
# WM_WEDGE_SECS / WM_WEDGE_PANE_GAP (30x at these defaults) - retune together
# to preserve that ratio, not either value alone.
WM_WEDGE_SECS="${WM_WEDGE_SECS:-1800}"        # 30 min
WM_WEDGE_PANE_GAP="${WM_WEDGE_PANE_GAP:-60}"  # pane silence that resets the anchor
# WM_LONG_SHELL_WARN (#155 fix 2, seconds, default 1200 = 20 minutes) is not
# read here at all - it is a render-time-only ceiling `wm-state.py`'s own
# rendering reads straight from the environment (inherited by every `wm_state`
# subprocess this script spawns) the moment it annotates a roster row, so
# retuning it needs no watcher restart. See _long_shell_warn_seconds() in
# bin/lib/wm-state.py.
# Fleet-wide correlated event grouping (wm_state group-attention, #22/#23): a
# batch collapses into one bullet only at or above this count AND this ratio of
# the relevant live population - see group-attention's own docstring for the
# denominator rules. A lone death/stall is always routine, never a "batch".
MASS_MIN_COUNT="${WM_MASS_MIN_COUNT:-2}"
MASS_MIN_RATIO="${WM_MASS_MIN_RATIO:-0.5}"
# Bounded resurface for a `review` member with no live dependency watcher
# (issue #187): one reminder per window, only when nothing is polling on the
# member's behalf. Cadence in hours, deliberately independent of
# WM_WATCH_INTERVAL - see bin/lib/wm-state.py's review-resurface-check.
WM_REVIEW_RESURFACE_SECS="${WM_REVIEW_RESURFACE_SECS:-21600}"   # 6h, generous default
WM_REVIEW_WAKER_GRACE="${WM_REVIEW_WAKER_GRACE:-120}"           # > pr-watch's own 30s default poll interval
# Structural forward-motion / logical-stall detection (issue #199, Gap B): a
# WORKING member with active reports (a lead) flips to 'stalled' once its own
# roster-shape signature has shown no change for this window, even with a
# fully healthy, armed watcher cycle - see bin/lib/wm-state.py's
# forward-motion-check.
WM_FORWARD_MOTION_SECS="${WM_FORWARD_MOTION_SECS:-1800}"   # 30 min default
# API/connectivity-error pane signature (#23): a member showing one of these and
# then going quiet is a likely local network blip or Anthropic-side outage, not a
# broken agent, so its check-in nudge (see #61 below) uses this wording instead of
# the generic one. Purely cosmetic - it changes which nudge message is sent and
# which reason template stall-check uses if the nudge doesn't clear it, never the
# gates or the wait itself.
#
# Deliberately portable ERE (#52): GNU grep's \b word-boundary escape combined
# with a {n} interval is rejected outright by BSD grep -E ("invalid repetition
# count(s)"), which makes grep -qE exit 2 (error) rather than 1 (no-match) -
# silently disabling this whole detector on macOS while spamming stderr every
# cycle. `(^|[^0-9A-Za-z_])...([^0-9A-Za-z_]|$)` emulates \b's actual word/
# non-word transition (word chars are `[A-Za-z0-9_]`, so the neighbor must be
# excluded from that whole class, not just digits - excluding only digits, as
# an earlier version of this fix did, lets identifier-shaped text like
# `abc429def` or `sess_429` spuriously match on every platform, not just BSD)
# using only grouping and anchors (both plain ERE, portable), and `5[0-9][0-9]`
# avoids the `{2}` interval entirely.
# "usage limit reached"/"credit balance too low" (issue #24) are two of the
# CLI's own recognized Anthropic-API-error shapes (confirmed in its embedded
# source string list) that this regex did not previously match verbatim -
# `rate.limit` matches "rate limited" but neither of these two phrases. A
# one-line strengthening of the existing reactive fallback: closing this gap
# means a genuine quota exhaustion, once it trips the mass-correlation path,
# surfaces labeled as a likely "API outage" rather than being missed
# entirely - an accepted, known mislabel (the remedy - pause and wait - is
# correct either way), not a distinct quota-exhaustion classification.
WM_APIERR_RE="${WM_APIERR_RE:-rate.limit|rate_limit|(^|[^0-9A-Za-z_])429([^0-9A-Za-z_]|$)|(^|[^0-9A-Za-z_])5[0-9][0-9] [Ee]rror|overloaded_error|Internal Server Error|ECONNRESET|ETIMEDOUT|ENOTFOUND|[Nn]etwork error|[Cc]onnection error|Connection refused|fetch failed|socket hang up|Service Unavailable|Bad Gateway|Gateway Timeout|usage limit reached|credit balance too low}"
WM_APIERR_TAIL="${WM_APIERR_TAIL:-15}"
# Stall self-heal nudge (#61): every stall-idle, pane-stable candidate - not only
# an api-error match - gets exactly one check-in nudge per stall episode (gated
# on the marker file's existence, never re-sent once it exists), and wm-state
# stall-check will not flip a member to 'stalled' until that marker is at least
# STALL_IDLE seconds old (i.e. the nudge has had a full window to work) - see
# the nudge block below and cmd_stall_check's --nudge-age gate. There is
# deliberately no separate cooldown constant here: a second knob governing only
# the resend decision let the shell's resend gate and stall-check's flip gate
# drift apart (#101), so the wait-after-nudge is driven by STALL_IDLE alone.

# Persisted fleet-wide outage-state machine (#23, item 0): active -> clear
# requires this many quiet seconds (zero fresh signal) after the last poll
# that saw one. Defaults to 3 poll intervals - comfortably past one flaky
# poll, matching the API-error nudge cooldown's own "several polls" order of
# magnitude. See wm_state outage-update for the full state machine; this
# value is passed straight through to it as --quiet-seconds.
WM_OUTAGE_QUIET="${WM_OUTAGE_QUIET:-$(( INTERVAL * 3 ))}"

# Proactive usage-limit-quota detection (#24). A window's used_percentage
# crossing this threshold (default 80%) is "approaching" and triggers the
# pause-and-ask flow - see wm_state usage-update. A $WM_HOME/usage/*.json
# reading older than this many seconds is no longer treated as a live
# source (the session that wrote it hasn't produced a fresh statusline tick
# in the last few polls); this is deliberately independent of, and stricter
# than, the resets_at-in-the-future check applied in the same aggregation
# pass - see wm_state usage-update's own docstring for why a single
# staleness bound cannot substitute for both.
WM_USAGE_WARN_THRESHOLD="${WM_USAGE_WARN_THRESHOLD:-80}"
WM_USAGE_STALE_SECS="${WM_USAGE_STALE_SECS:-900}"
WM_USAGE_SWEEP_SECS="${WM_USAGE_SWEEP_SECS:-86400}"

# Remote Control disconnect signature (design: docs/plans/2026-07-12-remote-
# control-visibility-and-auto-reconnect-design.md, ask 2): the CLI's own
# disconnect banner, confirmed exact substrings it emits once its bounded
# reconnect budget is exhausted. Crew-side, a settled sighting gets an automatic
# `/remote-control` retry (the existing wm_tmux_send_message primitive, aimed at
# a pane it already has a target for); wingman-side (its own pane, registered at
# startup in $WM_HOME/self-pane), it is detect-only - never injected into - and
# instead fires the ordinary wake so wingman's own next turn tells the pilot.
WM_RC_DROPPED_RE="${WM_RC_DROPPED_RE:-Remote Control disconnected|Transport closed|Transport recovery exhausted}"
WM_RC_DROPPED_TAIL="${WM_RC_DROPPED_TAIL:-15}"
# At most one /remote-control retry per this many seconds per crew member, so a
# connection that will not recover from a slash command alone (e.g. the account
# itself lost its subscription) is not retried every single cycle.
RC_DROPPED_COOLDOWN="${WM_RC_DROPPED_COOLDOWN:-180}"

# Deliberately not given prompt_freeze_check's full UI-shape/adjacency precision:
# there is no equivalent stable "shape" for an error banner the way a numbered-
# options dialog has one, and this check does not need it. Its match never
# mutates state by itself - it only decides whether to attempt a nudge (cheap and
# reversible even if wrong) and which reason stall-check uses if and only if
# stall-check's own independently-gated flip to stalled was going to happen
# anyway. Reads $PANE_TEXT, set for this poll by wm_pane_snapshot.
api_error_check() {
  printf '%s\n' "$PANE_TEXT" | tail -n "$WM_APIERR_TAIL" | grep -qE "$WM_APIERR_RE"
}

# True iff this poll's pane capture (reads $PANE_TEXT, set by wm_pane_snapshot
# like the checks above) carries the Remote Control disconnect signature in its
# tail. Callers additionally require $PANE_STABLE (two identical consecutive
# polls) before acting on a hit - the same "one more poll before acting" rule
# prompt_freeze_check and the API-error nudge both use - so a banner merely
# scrolling transiently through a member's own transcript (e.g. while it reads
# or greps this very detector's strings, which this repo's own source now
# contains) is never mistaken for a live drop: real disconnect banners persist
# on screen, static, until something acts on them.
remote_control_dropped_check() {
  printf '%s\n' "$PANE_TEXT" | tail -n "$WM_RC_DROPPED_TAIL" | grep -qE "$WM_RC_DROPPED_RE"
}

# Wingman's own Remote Control disconnect: read-only detection, never injection.
# `bin/watch-fleet` has always deliberately never sent keystrokes into wingman's
# own pane (see the file header): the only way to act on the disconnect is to
# type `/remote-control` into the very pane wingman's own turn is running in,
# which cannot be done reliably from outside while that turn is mid-render of
# the tool call doing the sending. So this half of ask 2 detects and wakes only;
# the pilot supplies the one keystroke.
#
# Scoped to the owner "" cycle only (wingman's own watcher; a lead's cycle has no
# such pane to watch). $WM_HOME/self-pane is written once at wingman startup
# (bin/wingman, best-effort, only if $TMUX_PANE was set) and names a tmux pane
# id/target directly, independent of $WM_TMUX_SESSION - wingman's own session
# need not run inside the crew tmux session at all.
#
# Fires (returns 0) at most once per distinct banner: a hash of the last banner
# text that already fired is kept in $WM_HOME/self-pane.fired, so an unresolved,
# unchanging banner is surfaced once rather than re-waking wingman every cycle
# until the pilot acts; a new, different disconnect (different hash) fires again.
self_pane_check() {
  [ -z "$OWNER" ] || return 1
  [ -f "$WM_HOME/self-pane" ] || return 1
  _sp_target="$(cat "$WM_HOME/self-pane" 2>/dev/null)"
  [ -n "$_sp_target" ] || return 1
  _sp_text="$(wm_tmux_pane_text "$_sp_target")"
  [ -n "$_sp_text" ] || return 1
  _sp_hash="$(printf '%s' "$_sp_text" | cksum)"
  _sp_hashfile="$WM_HOME/self-pane.hash"
  _sp_prev="$(cat "$_sp_hashfile" 2>/dev/null)"
  printf '%s\n' "$_sp_hash" > "$_sp_hashfile"
  [ -n "$_sp_prev" ] && [ "$_sp_hash" = "$_sp_prev" ] || return 1   # not yet settled
  printf '%s\n' "$_sp_text" | tail -n "$WM_RC_DROPPED_TAIL" | grep -qE "$WM_RC_DROPPED_RE" || return 1
  _sp_firedfile="$WM_HOME/self-pane.fired"
  [ "$(cat "$_sp_firedfile" 2>/dev/null)" != "$_sp_hash" ] || return 1   # already fired for this exact banner
  printf '%s\n' "$_sp_hash" > "$_sp_firedfile"
  return 0
}

beat_age() {
  [ -f "$BEATFILE" ] || { echo 999999; return; }
  m="$(wm_py -c 'import os,sys;print(int(os.path.getmtime(sys.argv[1])))' "$BEATFILE" 2>/dev/null)" || { echo 999999; return; }
  echo $(( $(date +%s) - m ))
}

# True singleton-lifetime liveness (issue #237, part 2), identity-verified
# (issue #237 round-1 MF1): a bare pid match is not enough - a reused pid
# after e.g. a host reboot (nothing clears $WM_HOME at run start) would
# otherwise read as the true owner still alive. Stamping pid + process start
# time and requiring both to match closes that without adding any time-since
# term - a stalled-but-alive iteration is still, correctly, alive.
owner_lock_alive() {
  [ -d "$OWNERLOCK" ] || return 1
  _ola_pid="$(sed -n '1p' "$OWNERLOCK/owner" 2>/dev/null)"
  # Validate before kill -0 (issue #237 round-1 MF3): a corrupt/truncated
  # stamp like "0" or "-1" would otherwise read as the caller's own process
  # group and report alive forever. Identical guard to the claim-lock's own
  # owner-pid validation, reused verbatim.
  case "$_ola_pid" in ''|*[!0-9]*|0*) return 1 ;; esac
  kill -0 "$_ola_pid" 2>/dev/null || return 1
  _ola_stamped_start="$(sed -n '2p' "$OWNERLOCK/owner" 2>/dev/null)"
  _ola_cur_start="$(ps -o lstart= -p "$_ola_pid" 2>/dev/null | sed -e 's/^ *//' -e 's/ *$//')"
  [ -n "$_ola_stamped_start" ] && [ "$_ola_stamped_start" = "$_ola_cur_start" ]
}

# True iff a genuinely healthy cycle is live: identity-verified (MF1) AND has
# produced a beacon touch within the hard-grace window. A cycle that holds
# the lock but has gone quiet longer than that is wedged, not healthy -
# callers that would otherwise report "healthy" must not.
cycle_healthy() {
  owner_lock_alive || return 1
  [ "$(beat_age)" -lt "$WM_WATCH_HARD_GRACE" ]
}

# spurious_repeated_reason <count> <hint>
# Composes the standdown's own text - stored verbatim in $SUPPRESSEDFILE and
# re-delivered by both Stop hooks on every subsequent Stop event while the
# standdown holds (issue #198). Split into a pilot-facing diagnosis/remedy and
# a model-facing instruction, deliberately: the root cause of #198 was pilot-
# facing remedy prose lifted verbatim into a Stop-hook `reason`, which reads
# to the model as an instruction to arm - ending with "Resume it by running
# /watch again or arming bin/watch-fleet directly" is a direct order to
# dissolve the very standdown it appears in. This composes the two audiences
# separately instead, and the model-facing half is explicit that arming is
# refused, not merely discouraged.
spurious_repeated_reason() {
  _srr_count="$1"; _srr_hint="$2"
  _srr_body="Fleet supervision is standing down: the watcher for this session has died $_srr_count times in a row with no successful cycle in between (see $SPURLOG); fleet supervision is not being maintained.

YOUR action: report the paragraph above to the pilot, together with the pilot remedy below, then stop. Do NOT arm a watch-fleet cycle and do NOT run /watch in response to this. The standdown is deliberate - a successful claim clears it, which is exactly the re-arm churn the failure budget exists to prevent - and an arm attempt from a tool call is denied outright while it holds."
  # The way out is a shared tail, appended after EVERY hint-selected
  # paragraph - never only on the default hint. A pilot who has just cleared
  # a stale claim lock still needs to be told the standdown itself does not
  # clear on its own; without this tail that branch names no exit at all
  # (issue #198 plan review, MUST-FIX 1).
  _srr_clear="Once the cause of the repeated deaths is understood, lift the standdown with 'bin/watch-fleet --clear-standdown' (or restart wingman, which clears it with the run); fleet continuity re-arms automatically on the next Stop event."
  case "$_srr_hint" in
    stale-claim-lock)
      _srr_remedy="A claim-lock directory ($CLAIMLOCK) is blocking every arm attempt. watch-fleet already self-clears a lock left behind by a killed process once it is old enough and provably ownerless (issue #74) - so a lock that is still here and still causing repeated failures was deliberately left alone: either it is too young to trust as abandoned, or its stamped owner pid is alive and has not yet crossed the hard-stale-age threshold. Recovering means finding that live process, not deleting the directory out from under it: read $CLAIMLOCK/owner for its pid and check whether that process is a genuinely wedged watch-fleet arm (the lock is meant to be held for well under a second) - if so, it needs attention (or killing) before re-arming will succeed. Removing the lock while its owner is still alive risks two watchers racing to write \$PIDFILE at once, which is exactly what this lock exists to prevent. $_srr_clear" ;;
    *)
      _srr_remedy="$_srr_clear" ;;
  esac
  printf '%s\n\nPILOT REMEDY (their action, not yours - relay it): %s' "$_srr_body" "$_srr_remedy"
}

case "$MODE" in
  --classify)
    # Dispatched here, alongside --status/--stop/--start, deliberately BEFORE
    # claim-lock acquisition below: this call must never mkdir "$CLAIMLOCK",
    # never mutate $PIDFILE/$BEATFILE ($OWNERLOCK-based checks legitimately
    # read both), and never enter the blocking loop. Order, exactly as
    # verified correct through seven review rounds: (1) exit-record present -
    # trust it and stop; (2) else cycle_healthy - a genuinely healthy cycle
    # always means healthy, regardless of any leaked lock coexisting with it;
    # only within the "not healthy" branch: (3) a leaked claim-lock; (4) the
    # exhaustive pidfile-residue hints. Checking cycle_healthy before the lock
    # is what keeps a stale, unrelated leaked lock from being misclassified
    # as a live cycle's own failure. A wedged (beyond-hard-grace) cycle
    # deliberately does NOT short-circuit here - it falls through to the
    # hung-or-stale-pidfile hint below, so a sustained wedge correctly
    # consumes the spurious-failure budget over repeated classify calls.
    if [ -f "$EXITFILE" ]; then
      _outcome="$(cat "$EXITFILE" 2>/dev/null)"
      rm -f "$EXITFILE"
      # Rule 2: any non-spurious classify outcome resets the consecutive
      # failure count. All three count-file mutation rules live here, inside
      # --classify, and nowhere else in this script (see the claim-time
      # comment below for why a claim-time reset would silently revert the
      # fix this budget exists to provide).
      printf '0\n' > "$SPURCOUNTFILE"
      printf '%s\n' "$_outcome"
      exit 0
    fi
    if cycle_healthy; then
      printf '0\n' > "$SPURCOUNTFILE"
      printf 'healthy\n'
      exit 0
    fi
    # No record, no live cycle: genuinely spurious. Determine the forensic
    # hint - checked first, before the pidfile-residue branches, because it is
    # the one hint that is actually about the arm whose death is being
    # classified (a leaked lock blocking every subsequent arm attempt),
    # rather than about residue left behind by an entirely different, earlier
    # cycle. A lock left by a kill landing inside the sub-second claim window
    # (below) is the mechanism; a cycle already past that window and into the
    # blocking loop has already released the lock and cannot leak it this way.
    if [ -d "$CLAIMLOCK" ]; then
      _hint="stale-claim-lock"
    elif [ ! -f "$PIDFILE" ]; then
      _hint="clean-exit-or-sigterm"
    else
      _dead_pid="$(cat "$PIDFILE" 2>/dev/null)"
      if [ -n "$_dead_pid" ] && ! kill -0 "$_dead_pid" 2>/dev/null; then
        # A SIGKILL cannot run the INT TERM trap that removes $PIDFILE, so a
        # survived pidfile naming a dead pid is diagnostic of exactly that.
        _hint="sigkill-suspected"
      else
        # pidfile present, pid alive, beacon stale (cycle_healthy already
        # ruled out "and beacon fresh within hard grace") - a wedged process,
        # not a clean death.
        _hint="hung-or-stale-pidfile"
      fi
    fi
    # Pure consecutive count, no wall-clock term anywhere in the trip
    # condition (five review rounds of timing-dependent budgets each found
    # broken in a new way is why this one measures nothing but the sequence
    # of outcomes). A missing or unreadable count file reads as 0 under set
    # -u: the command substitution itself never errors on a missing file (cat
    # fails silently into an empty string), and the case below normalizes
    # both "empty" and "anything non-numeric" to 0 before the arithmetic
    # expansion ever runs, so $((...)) always sees an assigned value.
    _count="$(cat "$SPURCOUNTFILE" 2>/dev/null)"
    case "$_count" in ''|*[!0-9]*) _count=0 ;; esac
    _count=$((_count + 1))
    _budget="${WM_SPURIOUS_BUDGET_COUNT:-3}"
    if [ "$_count" -ge "$_budget" ]; then
      # Rule 3: the trip consumes the budget - reset in the same call that
      # reports it, so a lone stray death long after a genuine recovery is
      # once again absorbed as ordinary `spurious`, not an immediate re-trip.
      spurlog spurious-repeated "$_hint"
      # Record the standdown HERE, wherever the trip is observed - not only
      # when hooks/stop-continuity.sh happens to be the caller (issue #198,
      # R3) - so a model-driven `/watch` classify and a bare diagnostic call
      # both leave the same durable trace. Written before the printed
      # outcome below so a consumer that reacts to it by reading the marker
      # in the same breath always finds it.
      {
        printf '%s\n' "${WINGMAN_RUN_ID:-}"
        spurious_repeated_reason "$_count" "$_hint"
      } > "$SUPPRESSEDFILE"
      printf '0\n' > "$SPURCOUNTFILE"
      printf 'spurious-repeated %s %s\n' "$_count" "$_hint"
    else
      spurlog spurious "$_hint"
      printf '%s\n' "$_count" > "$SPURCOUNTFILE"
      printf 'spurious %s %s\n' "$_count" "$_hint"
    fi
    exit 0
    ;;
  --status)
    # The documented, scriptable liveness check: exit 0 iff a cycle is live, 1
    # otherwise, so a caller can test `bin/watch-fleet --status >/dev/null 2>&1`
    # without parsing text. Three outcomes, not two (issue #237 round-1 MF2):
    # a wedged cycle is reported distinctly from the genuinely-absent case, so
    # a human running this manually is not told "no live cycle" when one
    # actually exists and is merely wedged - actionable, not noise. The
    # exit-code contract is unchanged either way.
    if cycle_healthy; then
      wm_ok "watch-fleet cycle live (pid $(sed -n '1p' "$OWNERLOCK/owner" 2>/dev/null), beacon $(beat_age)s)"; exit 0
    elif owner_lock_alive; then
      wm_warn "watch-fleet cycle held by pid $(sed -n '1p' "$OWNERLOCK/owner" 2>/dev/null) but WEDGED (beacon $(beat_age)s >= hard grace ${WM_WATCH_HARD_GRACE}s) - the next arm will take over"; exit 1
    else
      wm_info "no live watch-fleet cycle"; exit 1
    fi
    ;;
  --stop)
    if [ -f "$PIDFILE" ]; then
      pid="$(cat "$PIDFILE" 2>/dev/null)"
    elif owner_lock_alive; then
      # $PIDFILE can, in principle, go missing while $OWNERLOCK - now the
      # authoritative liveness record (issue #237, part 2) - still names a
      # genuinely live cycle (external interference, a partial failure
      # elsewhere): fall back to the lock's own stamped pid rather than
      # reporting nothing to stop. Cheap, and worth the extra robustness now
      # that bin/crew-standdown calls --stop unconditionally for every id it
      # stands down (Fix 1).
      pid="$(sed -n '1p' "$OWNERLOCK/owner" 2>/dev/null)"
    else
      pid=""
    fi
    printf 'stopped\n' > "$EXITFILE"
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null
      wm_ok "watch-fleet stopped"
    else
      wm_info "no watch-fleet cycle to stop"
    fi
    # Unconditional, not only on the "found a pid to kill" branch: an
    # existing-but-EMPTY $PIDFILE (pid="" from a successful `cat` of nothing)
    # took the "nothing to stop" message above under the old structure, but
    # left the stale (empty) pidfile itself in place - which then classifies
    # as hung-or-stale-pidfile forever, since $PIDFILE existing is exactly
    # what --classify's own hint logic treats as "something to explain".
    rm -f "$PIDFILE" "$RUNFILE"; rm -rf "$OWNERLOCK"
    exit 0 ;;
  --start)
    wm_warn "watch-fleet --start is deprecated: arm 'bin/watch-fleet' as a harness-tracked background task instead. Blocking now."
    ;;
  --clear-standdown)
    # The one explicit, pilot-directed way out of a spurious-repeated
    # standdown (issue #198). Only removes the marker - never arms a cycle
    # itself: fleet continuity (hooks/stop-continuity.sh) does that on the
    # next Stop event, which is the only path that produces a genuinely
    # supervised cycle (a bare arm from a human's own terminal is not
    # harness-tracked and wakes nobody). $SPURCOUNTFILE is left untouched:
    # the trip that led here already reset it to 0 (rule 3 above), so there
    # is nothing to clear, and writing it here would add a fourth count-file
    # writer outside --classify, which the comment at rule 2 above forbids.
    if [ -f "$SUPPRESSEDFILE" ]; then
      rm -f "$SUPPRESSEDFILE"
      wm_ok "standdown lifted; fleet continuity will re-arm on the next Stop event"
    else
      wm_info "no standdown in force"
    fi
    exit 0 ;;
  *) : ;;   # arm/__loop/"" fall through to arm
esac

# --- atomic check-then-claim -------------------------------------------------
# mkdir is documented atomic on every POSIX filesystem (no flock(1) dependency,
# which macOS does not ship), so the check-then-claim below is wrapped in a
# short-lived lock directory: two `watch-fleet` invocations racing in the same
# instant would otherwise both observe no live cycle and both write $PIDFILE,
# the second silently clobbering the first and producing two competing
# blocking loops. The lock is held only across the check+claim (well under a
# second), never across the blocking loop itself, so it adds no contention for
# the common case (one arm at a time). A stuck concurrent arm is bounded at 5s
# rather than hanging forever; a stale lock directory left by a killed process
# is reclaimed automatically by this same invocation once that 5s budget is
# exhausted - but only once the directory is confirmed both old enough and
# provably ownerless (see below). wm_die is reserved for a holder that is
# still genuinely live, too recent to trust as abandoned, or contended again
# within this same invocation.
#
# A `mkdir` "success" is verified, not trusted outright: two near-simultaneous
# claimants have been observed to both see their own `mkdir` report success for
# the identical path (surfaced empirically under this project's own test
# environment - not expected on a well-behaved POSIX filesystem, but cheap to
# defend against regardless of platform). The verification relies on a strictly
# weaker guarantee than `mkdir` atomicity: ordinary sequential writes to one
# small regular file have a well-defined last-writer-wins outcome. Every
# claimant that gets past `mkdir` stamps its own pid into the lock dir, waits
# briefly for any true-concurrent claimant to do the same, then re-reads the
# file - only the single last writer sees its own pid reflected back, so a
# mismatch is treated exactly like a failed `mkdir` (back off and retry).
# ($CLAIMLOCK itself is defined earlier, alongside $PIDFILE, so --classify's
# stale-claim-lock check above can read it without duplicating the path.)
# The lock dir will hold an `owner` file (the verification stamp below), so
# releasing it is always rm -f the file, then rmdir the now-empty dir - a bare
# rmdir would fail (ENOTEMPTY) and leak the lock permanently.
release_claim() { rm -f "$CLAIMLOCK/owner" 2>/dev/null; rmdir "$CLAIMLOCK" 2>/dev/null; }
# CLAIM_STALE_AGE must stay comfortably under the 50-try/0.1s retry budget -
# not equal to it - to absorb whole-second mtime-vs-now truncation while still
# requiring a directory to be many multiples of the sub-second legitimate-
# claim window old before it is even considered for reclaim. (The budget's own
# real floor is 4.9s, not 5.0s: the sleep sits after the increment-and-check,
# so the 50th failed attempt's own sleep never runs before the check fires -
# only 49 sleeps have actually elapsed by then.)
# CLAIM_HARD_STALE_AGE is a second, independent backstop: a directory old
# enough to cross it is reclaimed regardless of what its owner pid looks like,
# closing the case where that pid has been reused by an unrelated process (or
# is simply corrupt). Both are env-overridable so tests can exercise the hard
# override without a real 60-second wait.
CLAIM_STALE_AGE="${WM_CLAIM_STALE_AGE:-4}"
CLAIM_HARD_STALE_AGE="${WM_CLAIM_HARD_STALE_AGE:-60}"
# An overall wall-clock deadline, independent of _claim_reclaimed, bounds the
# "directory vanished/unreadable" retry branches below - those reset the
# 50-try counter on every hit, which is otherwise unbounded against a
# (near-impossible in practice) pathological churn case.
_claim_start="$(date +%s)"
_claim_deadline=30
_claim_tries=0
_claim_reclaimed=0
while :; do
  if mkdir "$CLAIMLOCK" 2>/dev/null; then
    # Registered the instant mkdir succeeds, before the verification below can
    # fail - so this process's own dir is always reclaimed on exit, even if it
    # turns out to have lost the internal write race (never a permanent wedge
    # with no one left to clean it up).
    trap release_claim EXIT
    echo "$$" > "$CLAIMLOCK/owner" 2>/dev/null
    sleep 0.1
    [ "$(cat "$CLAIMLOCK/owner" 2>/dev/null)" = "$$" ] && break
    trap - EXIT   # lost the internal race; the presumed winner's own trap cleans up
  fi
  _claim_tries=$((_claim_tries+1))
  if [ "$_claim_tries" -ge 50 ]; then
    # Re-stat the lock fresh, right now - never act on pid/age information read
    # on an earlier failed attempt (that's exactly the clobber bug this fix
    # closes: acting on stale information about a path can delete a different,
    # live claimant that has since taken over the same path).
    if [ ! -d "$CLAIMLOCK" ]; then
      # Already gone - released or reclaimed by someone else since our last
      # failed mkdir. Nothing to clean up; just retry the mkdir, unless we've
      # been churning on this for so long that something else is clearly wrong.
      [ $(( $(date +%s) - _claim_start )) -ge "$_claim_deadline" ] \
        && wm_die "watcher: could not acquire the claim lock after ${_claim_deadline}s of repeated churn - see $CLAIMLOCK"
      _claim_tries=0
      continue
    fi
    _lock_mtime="$(wm_py -c 'import os,sys;print(int(os.path.getmtime(sys.argv[1])))' "$CLAIMLOCK" 2>/dev/null)"
    if [ -z "$_lock_mtime" ]; then
      # The directory existed a moment ago (the -d check above) but vanished,
      # or became unreadable, before the stat completed - the same benign
      # "someone else already cleaned this up" case as the branch just above,
      # not a reason to fall through to wm_die.
      [ $(( $(date +%s) - _claim_start )) -ge "$_claim_deadline" ] \
        && wm_die "watcher: could not acquire the claim lock after ${_claim_deadline}s of repeated churn - see $CLAIMLOCK"
      _claim_tries=0
      continue
    fi
    _lock_age=$(( $(date +%s) - _lock_mtime ))
    # A directory younger than CLAIM_STALE_AGE cannot be the long-dead lock
    # this fix targets - it is indistinguishable from a legitimate claimant
    # that arrived only moments ago (possibly the very claimant that just
    # replaced a directory we saw fail earlier). Never reclaim on pid liveness
    # alone; fall through to the unchanged wm_die below instead, exactly as
    # before this fix existed.
    if [ "$_lock_age" -ge "$CLAIM_STALE_AGE" ]; then
      _owner_raw="$(cat "$CLAIMLOCK/owner" 2>/dev/null)"
      case "$_owner_raw" in
        # Empty (owner file missing, or never written before its claimant
        # died), not a plain positive integer (a corrupt stamp, or a value
        # like "-1" that `kill -0` would misread as a process-group target),
        # or leading-zero (e.g. "0", which `kill -0` would misread as the
        # caller's own process group and which `echo "$$"` never produces) -
        # all are treated as an unreadable/dead owner, never passed to
        # `kill -0` as-is.
        ''|*[!0-9]*|0*) _owner_dead=1 ;;
        *) if kill -0 "$_owner_raw" 2>/dev/null; then _owner_dead=0; else _owner_dead=1; fi ;;
      esac
      if [ "$_claim_reclaimed" -eq 0 ] \
        && { [ "$_owner_dead" -eq 1 ] || [ "$_lock_age" -ge "$CLAIM_HARD_STALE_AGE" ]; }; then
        wm_warn "watcher: clearing a stale claim lock at $CLAIMLOCK (age ${_lock_age}s, owner pid ${_owner_raw:-unknown})"
        rm -f "$CLAIMLOCK/owner" 2>/dev/null
        rmdir "$CLAIMLOCK" 2>/dev/null
        _claim_reclaimed=1
        _claim_tries=0
        continue
      fi
    fi
    wm_die "watcher: could not acquire the claim lock after 5s (a concurrent arm may be stuck) - see $CLAIMLOCK"
  fi
  sleep 0.1
done

# takeover_kill <pid> <label> - supervised reap: SIGTERM first, escalated to
# SIGKILL after a bounded wait if the pid hasn't exited (issue #237 round-2
# MF-A). A plain SIGTERM alone cannot reliably reap a cycle genuinely wedged
# inside a blocking foreground child (e.g. a hung tmux call, repro 3's
# leading candidate): bash defers running its own TERM trap until that child
# returns, so a wedged cycle's trap-based teardown never actually runs on
# SIGTERM (demonstrated: survives 8s+ of SIGTERM in testing) - without the
# escalation, every takeover attempt against a truly wedged holder degrades
# to the wm_die dead end below, silently removing the one manual `kill`
# remedy that works today. SIGKILL cannot be deferred the same way - the
# kernel tears the process down regardless of what it is blocked in - so it
# is the mechanism that actually recovers a wedge; SIGTERM is tried first
# only to give a non-wedged holder the chance to run its own clean teardown
# (removing $OWNERLOCK etc.) before being killed outright. wm_die fires only
# if even SIGKILL fails to reap it within its own bounded wait - a
# kernel-level uninterruptible-sleep hang, not something this mechanism can
# be expected to recover from on its own.
takeover_kill() {
  _tk_pid="$1"; _tk_label="$2"
  kill "$_tk_pid" 2>/dev/null
  _tk_tries=0
  _tk_escalated=0
  while kill -0 "$_tk_pid" 2>/dev/null; do
    _tk_tries=$((_tk_tries+1))
    if [ "$_tk_tries" -ge 50 ]; then
      if [ "$_tk_escalated" -eq 0 ]; then
        wm_warn "watcher: the $_tk_label cycle (pid $_tk_pid) did not exit within 5s of SIGTERM - escalating to SIGKILL."
        kill -KILL "$_tk_pid" 2>/dev/null
        _tk_escalated=1
        _tk_tries=0
      else
        wm_die "watcher: the $_tk_label cycle (pid $_tk_pid) did not exit within 5s of SIGKILL - it may be stuck in an uninterruptible kernel wait; stop it manually (bin/watch-fleet --stop) and re-arm"
      fi
    fi
    sleep 0.1
  done
}

# --- singleton guard --------------------------------------------------------
# If a genuinely live cycle already holds the lock, do not start a rival loop.
# The reworded line leads with "already armed" (mirroring what the caller just
# attempted) and states explicitly that the pid is never a kill target - a fresh
# arm reporting a bare "healthy pid=N" is what got misread as something to stop
# in the incident this closes. The `watcher: healthy` token prefix is unchanged
# so CLAUDE.md's documented arm-status parsing contract still holds.
#
# Liveness is now identity-verified, not beacon-freshness-proxied (issue #237
# part 2): owner_lock_alive() requires both a live pid AND a matching process
# start time (MF1), so a reused pid after e.g. a host reboot cannot be
# mistaken for the true owner. A cycle merely stalled for anywhere under
# WM_WATCH_HARD_GRACE is never stolen from - only owner_lock_alive() being
# false (the true owner has actually exited), a foreign-run mismatch, or a
# beyond-hard-grace wedge (MF2) reach the claim below.
#
# Run-id ownership check (#162): `healthy` must certify not just "a cycle is
# alive" but "a cycle whose exit can wake THIS session". A cycle armed by a
# previous, now-ended wingman run can outlive its session (a child of
# systemd --user, not of any tracked harness task); adopting it as healthy
# leaves the current run permanently unwakeable while board.md looks fine.
# Each claim below stamps its arming session's $WINGMAN_RUN_ID into $RUNFILE;
# an arm whose own run id differs from the live cycle's stamp is looking at a
# foreign cycle and replaces it via the supervised takeover_kill() above, then
# falls through to claim its own tracked cycle. With no run id on the arming
# side ($WINGMAN_RUN_ID unset - e.g. `claude` started directly, not via
# bin/wingman) ownership cannot be certified either way, so legacy behavior
# stands: a live cycle reads as healthy.
if owner_lock_alive; then
  _lock_pid="$(sed -n '1p' "$OWNERLOCK/owner" 2>/dev/null)"
  if [ -n "${WINGMAN_RUN_ID:-}" ] && [ "$(cat "$RUNFILE" 2>/dev/null)" != "$WINGMAN_RUN_ID" ]; then
    _old_run="$(cat "$RUNFILE" 2>/dev/null)"
    wm_warn "watcher: live cycle (pid $_lock_pid) was armed by run '${_old_run:-unknown}', not this run - its exit cannot wake this session. Replacing it with a cycle this run tracks."
    takeover_kill "$_lock_pid" "foreign"
    # The dead cycle's TERM trap may already have removed $PIDFILE/$OWNERLOCK
    # if it exited cleanly on SIGTERM; sweep the rest of its residue
    # unconditionally so the fresh claim below starts clean regardless of
    # whether SIGTERM or the SIGKILL escalation actually reaped it. Its
    # unclassified death is deliberate replacement, never a spurious failure,
    # so no exit record is written for it.
    rm -f "$PIDFILE" "$BEATFILE" "$RUNFILE"; rm -rf "$OWNERLOCK"
  elif [ "$(beat_age)" -lt "$WM_WATCH_HARD_GRACE" ]; then
    wm_ok "watcher: already armed and healthy - one cycle is live (pid $_lock_pid, beacon $(beat_age)s ago). Nothing to do; this pid is the EXISTING watcher, never a target to stop or kill."
    # Non-clobbering: a `fire`/`remote-control-dropped` record from the live
    # cycle this redundant arm just raced against outranks a `healthy` write -
    # --classify's own cycle_healthy check already derives `healthy`
    # independently from "record absent + a cycle is healthy", so skipping
    # this write when a record already exists costs nothing and protects the
    # one write that cannot be reconstructed after the fact.
    [ -f "$EXITFILE" ] || printf 'healthy\n' > "$EXITFILE"
    release_claim
    exit 0
  else
    # Wedged takeover (issue #237 round-1 MF2): identity-alive, but zero
    # beacon progress for >= WM_WATCH_HARD_GRACE - treat as stuck and take
    # over via the same supervised takeover_kill() as the foreign-run branch
    # above, rather than refusing forever.
    wm_warn "watcher: live cycle (pid $_lock_pid) has not advanced its beacon in $(beat_age)s (>= WM_WATCH_HARD_GRACE ${WM_WATCH_HARD_GRACE}s) - treating as wedged and taking over."
    takeover_kill "$_lock_pid" "wedged"
    rm -f "$PIDFILE" "$BEATFILE" "$RUNFILE"; rm -rf "$OWNERLOCK"
  fi
fi
# Falls through to "claim the cycle" whenever owner_lock_alive was false, or
# any takeover branch above just cleared it.

# --- claim the cycle --------------------------------------------------------
# Computed before the pidfile write below, not alongside the owner-lock
# creation further down where it conceptually belongs: it is a constant for
# this process (its own start time never changes), so there is no correctness
# reason to compute it inside the window between the pidfile write and this
# cycle's own "armed" line - and hooks/stop-continuity.sh:425-432 documents
# that exact window as the one a SIGKILL landing inside it cannot recover
# from cleanly (a dead-owner $CLAIMLOCK left behind that a re-arm must wait
# out CLAIM_STALE_AGE for). Every subprocess fork this claim sequence can
# avoid inside that window narrows it back down.
_ol_start="$(ps -o lstart= -p "$$" 2>/dev/null | sed -e 's/^ *//' -e 's/ *$//')"
echo $$ > "$PIDFILE"
# Stamp the arming session's run id (possibly empty) so a later arm from a
# different run can recognize this cycle as foreign - see the singleton
# guard's run-id ownership check above (#162).
printf '%s\n' "${WINGMAN_RUN_ID:-}" > "$RUNFILE"
# The only way a record can still be present at a fresh claim is that a wake
# was never classified - i.e. the record is the last remaining trace of an
# event `fire()` already acked. For `fire`/`remote-control-dropped` this is a
# genuine, not-yet-relayed event (issue #197): refuse to claim rather than
# silently discard it. Roll back the pidfile/runfile writes just above and
# release the claim lock, leaving $EXITFILE/$WAKEFILE both intact for a
# `--classify` call - the only legitimate consumer - to pick up next. This
# never touches $SPURCOUNTFILE - the count file's only three writers are
# inside --classify (see the comments there).
#
# Any OTHER leftover content never carries an un-relayed event, so it keeps
# the original loud-but-permissive behavior: log it and let the claim
# proceed.
if [ -f "$EXITFILE" ]; then
  _claim_exit="$(cat "$EXITFILE" 2>/dev/null)"
  case "$_claim_exit" in
    fire|remote-control-dropped)
      rm -f "$PIDFILE" "$RUNFILE"
      release_claim
      wm_die "watcher: refusing to arm - an unclassified '$_claim_exit' record is still pending (issue #197: this record was never classified before something tried to arm a fresh cycle). Run 'bin/watch-fleet --classify${OWNER:+ --owner $OWNER}' first, act on its result, THEN arm."
      ;;
    *)
      spurlog dropped-wake "$_claim_exit"
      rm -f "$EXITFILE"
      ;;
  esac
fi
# A successful claim is what actually resolves a stop sanction, a
# spurious-repeated standdown, or a claim-failure backoff (issue #185) - each
# is cleared here, unconditionally, regardless of which (if any) was in
# force. $inflightfile is deliberately not among these: a claim succeeding
# says nothing about whether the specific hook invocation that is claiming
# right now is still in flight, so it is left to age out by its own time
# bound instead (see hooks/stop-continuity.sh).
rm -f "$STOPFILE" "$SUPPRESSEDFILE" "$CLAIMFAILFILE"
# A fresh cycle has observed nothing yet - any leftover debounce streak from
# a previous, crashed cycle must not carry over into this one's owner-status
# self-check (Fix 2b below).
rm -f "$OWNERCHECKFILE"
# Create the true singleton-lifetime lock (issue #237 part 2). Safe to
# attempt unconditionally, with no age check or verification dance (unlike
# $CLAIMLOCK's own claim, which does need one, for a different reason): by
# construction, execution only reaches this point while $CLAIMLOCK is held
# continuously from before the singleton guard's check through here, so no
# rival process can be concurrently touching $OWNERLOCK at this moment. Any
# leftover directory here is guaranteed stale - the guard already
# established owner_lock_alive was false, or a takeover branch just cleared
# it, before this process could have reached this point at all. What must be
# verified is not exclusivity (none is at risk) but that the mkdir/write
# actually succeeded before trusting the lock for the rest of the cycle's
# life - a full disk, a permissions problem, or an rm -rf that didn't
# actually clear a leftover reproduces the original defect with no stall
# required: owner_lock_alive would read false forever for a perfectly
# healthy cycle, so the very next arm would claim the pidfile out from under
# it.
# [ -e ] first (a builtin test, no fork) rather than an unconditional rm -rf:
# in the common case (a healthy fresh claim, no leftover from a takeover or a
# SIGKILL) there is nothing here to remove at all, so this skips the rm(1)
# fork entirely rather than paying for it against an empty path every time.
[ -e "$OWNERLOCK" ] && rm -rf "$OWNERLOCK" 2>/dev/null
_ol_ok=0
if mkdir "$OWNERLOCK" 2>/dev/null; then
  { printf '%s\n' "$$"; printf '%s\n' "$_ol_start"; } > "$OWNERLOCK/owner" 2>/dev/null
  # issue #237 round-2 MF-B: verify the stamp WRITE itself, not just the
  # mkdir - a directory that exists but is not writable, or a disk that fills
  # up mid-write, can make mkdir succeed while the write above silently fails
  # or truncates, leaving $OWNERLOCK/owner absent or wrong even though mkdir
  # alone reported success. Read back what was actually written and compare
  # against what this process intended to write; anything else is treated
  # exactly like a failed mkdir - fatal, never a silently unprotected cycle.
  # A single `read` pair off the file (a shell builtin) rather than two `sed`
  # invocations - one less fork inside the same SIGKILL-sensitive window.
  _ol_readback_pid=""; _ol_readback_start=""
  { IFS= read -r _ol_readback_pid; IFS= read -r _ol_readback_start; } < "$OWNERLOCK/owner" 2>/dev/null
  if [ "$_ol_readback_pid" = "$$" ] && [ "$_ol_readback_start" = "$_ol_start" ]; then
    _ol_ok=1
  fi
fi
if [ "$_ol_ok" -ne 1 ]; then
  # Roll back the pidfile/runfile writes from the top of this section -
  # mirroring the #197 EXITFILE-refusal rollback just above - so a failed
  # claim never leaves a pidfile behind naming a cycle that was never
  # actually protected.
  rm -f "$PIDFILE" "$RUNFILE"
  release_claim
  wm_die "watcher: failed to create the owner lock at $OWNERLOCK - refusing to arm a cycle that could never be protected against a rival claim"
fi
: > "$BEATFILE" || true
release_claim
trap 'rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"; exit 0' INT TERM
wm_ok "watcher: armed pid=$$ (interval ${INTERVAL}s)"
# Forensics only - prevents nothing (issue #202, plan section 2.4: a
# foreground and a `run_in_background: true` Bash call are indistinguishable
# from inside this process, so nothing here can detect or refuse either
# way - only hooks/no-foreground-watcher-guard.sh, at the tool-call boundary,
# can). Written to stderr (wm_warn) so the stdout token contract (armed/
# healthy/<reason>:) stays byte-identical regardless. If you are reading this
# line in a FOREGROUND tool result, this session is ALREADY wedged: this
# script blocks until an event fires, so nothing after this line will ever
# run, and the tool call will never return. Arm it as a harness-tracked
# background task (Bash run_in_background: true) instead - never detached
# (nohup/setsid/a trailing &), and if you cannot arm it as a background
# task, arm nothing: no watcher at all is strictly better than a foreground
# one.
wm_warn "watch-fleet: if you are seeing this line in a FOREGROUND tool result, this session is already wedged (issue #202) - re-arm as a harness-tracked background task (run_in_background: true) instead. This line is forensics only and prevents nothing."

# The prompt-shape detector (prompt_shape_in) and its WM_PERM_PROMPT_RE/
# WM_PERM_OPTION_RE/WM_PERM_MARK_RE/WM_PERM_MIN_OPTS/WM_PERM_TAIL/WM_PERM_ADJ/
# WM_PERM_LEAD_RE config live in lib/common.sh (shared with wm_tmux_send_message,
# which uses the same detector before typing/submitting into a target pane).
#
# Negative-liveness grace: a member whose status file self-reported more recently
# than this is too fresh to be frozen, so the blocked-flip is vetoed. Defaults to
# two poll intervals. The veto applies ONLY once a member has genuinely
# self-reported since spawn (status.updated has advanced past the immutable
# spawned_at stamp), so a member frozen on the one-time startup gate - which never
# runs crew-set, leaving status.updated at the spawn stamp - is never vetoed.
WM_PERM_LIVENESS_GRACE="${WM_PERM_LIVENESS_GRACE:-$(( INTERVAL * 2 ))}"

# Negative-liveness veto: a genuinely frozen session cannot run crew-set, so its
# status file goes stale. Returns 0 (VETO the blocked flip) iff the member has
# genuinely self-reported since spawn (its status.updated has advanced past the
# immutable spawned_at stamp) AND that self-report is fresher than
# WM_PERM_LIVENESS_GRACE - too recent to be frozen. A member still frozen on the
# one-time startup gate never ran crew-set, so status.updated equals spawned_at and
# the veto does not apply (N2): the startup-gate freeze fires normally. This is a
# veto, not a detector - a legitimately busy member may not self-report for many
# minutes, so freshness alone cannot flag, but its recency can safely acquit.
liveness_veto() {
  _lv_age="$(wm_py -c '
import json, os, sys, datetime
cid = sys.argv[1]
home = os.path.expanduser(os.environ.get("WINGMAN_HOME", "~/.wingman"))
def rj(p):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return None
live = rj(os.path.join(home, "crew", cid + ".json")) or {}
roster = rj(os.path.join(home, "crew.json")) or []
spawned_at = None
for r in roster:
    if isinstance(r, dict) and r.get("id") == cid:
        spawned_at = r.get("spawned_at")
        break
upd = live.get("updated")
# Not yet self-reported since spawn (still the spawn stamp, or unknown): no veto.
if not upd or spawned_at is None or upd == spawned_at:
    print(999999); sys.exit(0)
try:
    t = datetime.datetime.strptime(upd, "%Y-%m-%dT%H:%M:%S.%fZ").replace(tzinfo=datetime.timezone.utc)
except Exception:
    print(999999); sys.exit(0)
print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds()))
' "$1" 2>/dev/null)"
  [ -n "$_lv_age" ] || return 1
  [ "$_lv_age" -lt "$WM_PERM_LIVENESS_GRACE" ]
}

# True iff a member's pane is frozen on an interactive prompt. Cumulative
# conditions, each of which alone stops the transcript-content false positive
# (a session that reads, writes, tests, or investigates this detector shows the
# signature strings in its own pane while healthily working):
#   1. the prompt UI shape - question phrase with an options line adjacent -
#      appears within the last WM_PERM_TAIL lines, where a dialog renders;
#   2. the full pane text is byte-identical to the previous poll's capture - a
#      frozen dialog is static (costs one extra INTERVAL of latency on a real
#      freeze). Note a *parked* healthy pane is also static (the §3.2 shape),
#      which is why the adjacency in condition 1 must carry precision there.
# Also sets PFC_SHAPE=1 when condition 1 held regardless of stability, so the
# caller can hold the stall check off a prompt-shaped pane that is one INTERVAL
# away from a definitive diagnosis. Reads $PANE_TEXT/$PANE_STABLE, which the
# caller must set for this poll via wm_pane_snapshot before calling this (shared
# with the API-error check, so the pane is captured and hashed once per member
# per poll, not twice).
prompt_freeze_check() {
  PFC_SHAPE=0
  # Scans for either dialog shape in one pass (#23/#30): the ordinary
  # permission/trust/Bypass set, or the resume-from-summary menu - see
  # WM_RESUME_PROMPT_RE's own docstring in lib/common.sh for why this is a
  # second, distinctly-worded regex rather than folded permanently into
  # WM_PERM_PROMPT_RE's own default.
  prompt_shape_in "$(printf '%s\n' "$PANE_TEXT" | tail -n "$WM_PERM_TAIL")" \
    "${WM_PERM_PROMPT_RE}|${WM_RESUME_PROMPT_RE}" || return 1
  PFC_SHAPE=1
  [ "$PANE_STABLE" = 1 ]
}

# Fire the wake: the two channels carry distinct roles. Stdout is the terse
# trigger - the machine reason lines (one per member, "<status>: <id> <note>")
# plus an explicit directive to report the full roster. The wake file is the
# payload to report from - the new events plus the full roster snapshot for this
# cycle's owner scope, written at fire time so it is current.
#
# needs-attention emits tab-separated "id status updated note"; the `updated`
# column is the per-event version stamp we ack below.
fire() {
  _attention="$1"
  # Collapse a fleet-wide correlated batch (mass death, correlated API outage)
  # into one synthetic row for the two DISPLAY loops only (#22/#23, §3.3). This
  # is a pure, stateless filter - it never mutates any status file - so the ack
  # loop below deliberately keeps iterating $_attention (the real ids and their
  # real `updated` stamps), never $_grouped (whose synthetic ids ack nothing).
  _grouped="$(printf '%s\n' "$_attention" | wm_state group-attention \
    --owner "$OWNER" --mass-min-count "$MASS_MIN_COUNT" --mass-min-ratio "$MASS_MIN_RATIO" 2>/dev/null)"
  # Fold any pending outbox-abandonment notices (issue #169: the outbox
  # scan's `wake` mode appends here) into this fire, rename-aside rather than
  # read-then-truncate: a read-then-truncate loses any notice appended in the
  # gap between the read and the truncate; the rename-aside closes the
  # dominant loss mode (an appender's own fd, opened and written after the
  # rename, either lands in the removed inode - a narrow window - or
  # recreates a fresh file, picked up whole next poll). The payload and the
  # outbox-abandoned.log line are already durable by the time any notice is
  # composed, so what's at risk in that residual is a wake ANNOUNCEMENT
  # delay, never the message or its record.
  _notice_fold=""
  if mv "$NOTICEFILE" "$NOTICEFILE.reading" 2>/dev/null; then
    _notice_fold="$(cat "$NOTICEFILE.reading" 2>/dev/null)"
    rm -f "$NOTICEFILE.reading"
  fi
  {
    echo "# Crew need your attention"
    echo
    echo "## New events"
    echo
    printf '%s\n' "$_grouped" | while IFS=$'\t' read -r id st upd note; do
      [ -n "$id" ] && printf -- '- **%s** [%s] %s\n' "$id" "$st" "$note"
    done
    echo
    echo "## Abandoned messages"
    echo
    if [ -n "$_notice_fold" ]; then
      printf '%s\n' "$_notice_fold"
    else
      echo "(none this cycle)"
    fi
    echo
    echo "## Full roster (this owner's scope)"
    echo
    wm_state crew-list --owner "$OWNER" 2>/dev/null
  } > "$WAKEFILE"
  printf '%s\n' "$_grouped" | while IFS=$'\t' read -r id st upd note; do
    [ -n "$id" ] && printf '%s: %s %s\n' "$st" "$id" "$note"
  done
  # A notice-only fire (no genuine $_attention - see the needs-attention call
  # site below) still needs a real stdout line of its own: stdout is the
  # wake's own trigger channel, so without one a notice-only fire would
  # otherwise emit nothing on it at all.
  if [ -z "$_attention" ] && [ -n "$_notice_fold" ]; then
    printf 'abandoned-message: an outbox message was swept as abandoned and queued a notice - see %s\n' "$WAKEFILE"
  fi
  printf -- '--\n'
  printf 'The lines above are state-change deltas, not the full picture.\n'
  printf 'This record is not yet classified. If you are not already responding to a\n'
  printf '`bin/watch-fleet --classify` result, run that FIRST - never arm a bare cycle\n'
  printf 'while this one is unclassified; a bare arm now refuses rather than silently\n'
  printf 'discarding it (issue #197), but only --classify actually reports it. Read\n'
  printf '%s for the full roster (or run bin/crew-list), then report a compact\n' "$WAKEFILE"
  printf 'roster status to the pilot: who is on what, what is blocked, what is stalled,\n'
  printf 'what is ready for review. Then arm one fresh watch-fleet cycle before you stop.\n'
  # Firing IS the delivery, so ack each surfaced (id, updated). That suppresses
  # this exact event on subsequent arms while preserving gap-safety: a different
  # crew - or this crew with a new status (new updated) - is not acked and still
  # surfaces on the next arm's top-of-loop check. Acks the REAL ids from
  # $_attention, never the synthetic $_grouped rows (see the comment above).
  # This ack happens BEFORE $EXITFILE is written below - both #185's own
  # gap-safety claim ("a fresh cycle re-fires within one poll") and issue
  # #197 fix 2's rebuttal of it depend on that ordering, in opposite
  # directions. Reordering these two writes silently invalidates both
  # arguments at once.
  printf '%s\n' "$_attention" | while IFS=$'\t' read -r id st upd note; do
    [ -n "$id" ] && wm_state ack --id "$id" --updated "$upd" >/dev/null 2>&1
  done
  # Unconditional: the highest-priority writer. A `fire` record is the only
  # trace of an event that is already acked above - it must never lose to a
  # racing `healthy` write from a redundant arm evaluating the singleton guard
  # in the narrow window before this process's own $PIDFILE removal below.
  printf 'fire\n' > "$EXITFILE"
  rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
  exit 0
}

# --- the blocking loop ------------------------------------------------------
while :; do
  : > "$BEATFILE" || true   # liveness beacon for the singleton guard + Stop hook

  # Belt-and-braces self-ownership check (issue #237, nice-to-have): MF1+MF2
  # close the paths that made a subverted $OWNERLOCK matter in practice, but
  # this zero-subprocess check makes any future subversion self-limiting
  # rather than silent - if $OWNERLOCK no longer names this process (e.g. a
  # takeover raced past this process's own death), stop touching shared state
  # immediately rather than continuing to run alongside whatever now
  # legitimately owns the lock. Deliberately not classified via $EXITFILE:
  # this path should be unreachable given the claim-lock exclusivity argument
  # at claim time, so if it ever fires it is itself a symptom worth surfacing
  # as an ordinary unclassified exit rather than being laundered into a clean
  # `stopped`. Deliberately does not remove $PIDFILE/$OWNERLOCK either - by
  # the time this fires, they legitimately belong to whichever process does
  # own them now.
  _self_owner_pid=""
  IFS= read -r _self_owner_pid < "$OWNERLOCK/owner" 2>/dev/null
  [ "$_self_owner_pid" = "$$" ] || exit 0

  # Fleet-wide outage-state signal accumulators (#23, item 0), reset every
  # iteration regardless of owner scope or tmux-session liveness: only
  # mutated inside the tmux-session branch below, but always fed to
  # wm_state outage-update afterward (owner "" only) so the quiet-period
  # countdown advances in real time even on a poll with nothing to scan.
  _OUTAGE_API_SIGNALS=0
  _reconcile_died=""

  # The generic per-poll outbox scan (issue #169): runs in EVERY watcher,
  # unconditionally on $OWNER, every poll, before anything else can `exit 0`
  # this poll - fire()'s own exit 0 is below (see the needs-attention check at
  # the bottom of this loop) is the first; the worktree-removal self-check
  # (issue #237, Fix 2a) just below this is a second; the owner-status
  # self-check (Fix 2b) right after it is a third, independent one; and the
  # self-pane check just below THAT is a fourth - so this scan sits ahead of
  # all FOUR: a member's outbox must not go unswept for however many polls
  # those paths keep firing.
  # Placed before wm_tmux_adopt_strays/wm_state reconcile below, so a member
  # that dies during poll N first becomes visible to the scan on poll N+1 -
  # one extra poll of latency, still within the ~5s bound this design claims
  # throughout, but the scan never acts on the very poll that detects a death.
  #
  # A cheap glob-and-case check (no subprocess) runs first, collecting the
  # ids with at least one pending (non-sent-) file; only if it finds one does
  # the scan pay for one fleet-wide `wm_state crew-list --all --json` read
  # plus one wm_tmux_windows_csv snapshot for the WHOLE poll, classifying
  # every pending id's delivery-reachability in one python invocation rather
  # than one subprocess per id (measured: one `crew-get` costs 140ms, one
  # fleet-wide `crew-list --all --json` read costs 149ms constant regardless
  # of outbox count - a per-directory read is strictly worse and gets worse
  # with scale). A failed roster read skips the scan entirely for this poll -
  # fail closed (defer to next poll), never fail dangerous (sweep a live
  # member on a transient lookup failure).
  _ob_pending_ids=""
  for _ob_dir in "$WM_HOME"/outbox/*/; do
    [ -d "$_ob_dir" ] || continue
    for _ob_f in "$_ob_dir"*; do
      [ -e "$_ob_f" ] || continue
      case "$(basename "$_ob_f")" in sent-*) continue ;; esac
      _ob_pending_ids="$_ob_pending_ids$(basename "$_ob_dir")
"
      break
    done
  done
  if [ -n "$_ob_pending_ids" ] && _ob_roster_json="$(wm_state crew-list --all --json 2>/dev/null)"; then
    # The window-liveness read needs the identical fail-closed treatment as
    # the roster read (round-2 MF-1): wm_tmux_windows_csv carries no error
    # signal of its own, so on a poll where the tmux connection is in the
    # ambiguous-failure state, every done member would misread as having no
    # live window and get swept. wm_tmux_reachable draws exactly this line
    # (0 = a live server, or a definitively-absent one - either way trustable;
    # 1 = an ambiguous connection error), mirroring the wm_tmux_adopt_strays/
    # wm_state reconcile gate one screen below. _ob_windows_valid=0 defers
    # every pending done target's window judgment to the next poll rather
    # than guessing; the stood-down/died/missing-record clauses need no
    # window data at all and are unaffected (see
    # wm_outbox_delivery_terminal's own doc comment in lib/common.sh).
    if wm_tmux_reachable; then
      _ob_windows_csv="$(wm_tmux_windows_csv)"; _ob_windows_valid=1
    else
      _ob_windows_csv=""; _ob_windows_valid=0
    fi
    # Round-7 observation A: the window-liveness match is exact-field (a
    # python set, never a bash substring/case test) - the live roster already
    # contains a real collision shape for this (one id a strict prefix of
    # another's window name), and a substring match would read a dead window
    # as live for any such pair.
    _ob_terminal="$(printf '%s' "$_ob_roster_json" | wm_py -c '
import json, sys
ids = [l for l in sys.argv[1].splitlines() if l]
windows = set(w for w in sys.argv[2].split(",") if w)
windows_valid = sys.argv[3] == "1"
try:
    roster = json.load(sys.stdin)
except Exception:
    roster = []
by_id = dict((r.get("id"), r) for r in roster if isinstance(r, dict))
for tid in ids:
    rec = by_id.get(tid)
    if rec is None:
        print(tid + "\tits crew record is no longer in the roster")
        continue
    status = rec.get("status")
    if status in ("stood-down", "died"):
        print(tid + "\tits crew record is " + status)
        continue
    if status == "done" and windows_valid:
        win = rec.get("window") or ""
        if win not in windows:
            print(tid + "\tit is done with no live window")
' "$_ob_pending_ids" "$_ob_windows_csv" "$_ob_windows_valid")"
    if [ -n "$_ob_terminal" ]; then
      printf '%s\n' "$_ob_terminal" | while IFS=$'\t' read -r _ob_id _ob_reason; do
        [ -n "$_ob_id" ] || continue
        wm_outbox_sweep_abandoned "$_ob_id" "$_ob_reason" wake "$_ob_roster_json" "$_ob_windows_csv" "$_ob_windows_valid"
      done
    fi
  fi

  # Worktree-removal self-check (issue #237, part 1): a cycle armed from a
  # worktree that has since been removed (a developer's tree deleted at merge
  # time, independent of whether anyone ever stood the owner down) has nothing
  # left to watch from. Zero subprocess cost - a plain directory test - and
  # zero false positives: a cycle armed from $WINGMAN_BIN in the main repo
  # checkout can never trip it.
  if [ ! -d "$SELF_BIN_DIR" ]; then
    printf 'stopped\n' > "$EXITFILE"
    rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
    exit 0
  fi

  # Owner-status self-check (issue #237, part 1): a cycle scoped to a
  # non-empty $OWNER has nothing left to watch once that owner is stood down,
  # irrecoverably died, or done - or no longer in the roster at all. Owner ""
  # (wingman's own top-level cycle) is exempt: it has no roster record of
  # itself to check.
  if [ -n "$OWNER" ]; then
    _owner_json="$(wm_state crew-get --id "$OWNER" 2>/dev/null)"
    if [ -n "$_owner_json" ]; then
      _owner_status="$(printf '%s' "$_owner_json" | grep -m1 '"status"' \
        | sed -E 's/^[^:]*: *"([^"]*)".*/\1/')"
      _owner_resumable=0
      printf '%s' "$_owner_json" | grep -q '"resumable": true' && _owner_resumable=1
    else
      _owner_status=""
    fi
    case "$_owner_status" in
      stood-down|done)
        _owner_gone=1 ;;
      died)
        # died is reversible (#254 lets a resumable died member be taken
        # over) - only treat it as gone once it is no longer resumable, so a
        # transient window death does not permanently strand a recoverable
        # lead's watcher.
        if [ "$_owner_resumable" -eq 1 ]; then _owner_gone=0; else _owner_gone=1; fi ;;
      "")
        # Ambiguous: crew-get produced nothing, which is indistinguishable at
        # this point between "genuinely no longer in the roster" and a
        # transient failure (a uv/venv hiccup, a torn read, momentary OOM) -
        # cmd_crew_get prints nothing to stdout on every failure path alike.
        # Debounced below rather than acted on immediately.
        _owner_gone="" ;;
      *)
        _owner_gone=0 ;;   # working/blocked/review - still owned, definitely
    esac
    if [ "$_owner_gone" = 1 ]; then
      rm -f "$OWNERCHECKFILE" 2>/dev/null
      printf 'stopped\n' > "$EXITFILE"
      rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
      exit 0
    elif [ -z "$_owner_gone" ]; then
      _streak="$(cat "$OWNERCHECKFILE" 2>/dev/null)"
      case "$_streak" in ''|*[!0-9]*) _streak=0 ;; esac
      _streak=$((_streak + 1))
      if [ "$_streak" -ge "${WM_OWNER_MISSING_CONFIRMS:-3}" ]; then
        printf 'stopped\n' > "$EXITFILE"
        rm -f "$PIDFILE" "$OWNERCHECKFILE"; rm -rf "$OWNERLOCK"
        exit 0
      fi
      printf '%s\n' "$_streak" > "$OWNERCHECKFILE"
    else
      rm -f "$OWNERCHECKFILE" 2>/dev/null
    fi
  fi

  # Wingman's own Remote Control disconnect (ask 2, detect-only - see
  # self_pane_check's own docstring for why this never injects). Checked first,
  # every cycle, independent of $WM_TMUX_SESSION: wingman's own registered pane
  # need not be inside the crew tmux session at all. Fires the ordinary wake
  # contract (wake file + reason line + exit 0) exactly like a crew event below,
  # so wingman's very next turn reports it to the pilot immediately.
  if self_pane_check; then
    {
      echo "# Wingman's own Remote Control session disconnected"
      echo
      echo "This session's own Remote Control connection dropped and its automatic"
      echo "retry budget is exhausted. Run \`/remote-control\` in this session to restore it."
    } > "$WAKEFILE"
    echo "remote-control-dropped: wingman run /remote-control in this session to restore it"
    printf 'remote-control-dropped\n' > "$EXITFILE"
    rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
    exit 0
  fi

  # Reconcile liveness so a dead window becomes 'died'. Reconciled against
  # every window in the crew session's own prefix family (#209), not just
  # whether the crew session itself exists: the crew session is exactly
  # what a tmux-server crash takes down first, so gating reconcile on its
  # existence was the one case it exists to catch. Skipped only when the
  # tmux server itself is unreachable (wm_tmux_reachable) - never merely
  # because the crew session doesn't currently exist. Strays are adopted
  # first (a live window in a prefix-sibling session is moved home, never
  # flagged) - wm_tmux_adopt_strays' own has-session guard makes it a no-op
  # when the crew session is absent, which is safe here for the same reason
  # as bin/crew-list.
  if wm_tmux_reachable; then
    wm_tmux_adopt_strays
    # Pass this cycle's owner so the dead-owner re-adopt pass runs only under
    # wingman's watcher (--owner ""); a lead's cycle does the death-flip only (N4).
    # Captured (not discarded) this time: reconcile prints the ids it JUST
    # flipped to died this call, space-joined - the outage-state signal below
    # (#23, item 0) needs exactly this poll's own death count, not the
    # roster's full died population.
    _reconcile_died="$(wm_state reconcile --windows "$(wm_tmux_prefix_windows_csv)" --owner "$OWNER" 2>/dev/null)"
  fi

  # Pane capture / messaging below needs the crew session ITSELF, not just a
  # reachable server - a member's window is addressed inside it specifically
  # (wm_tmux_win_target). If the crew session doesn't (yet) exist - e.g. the
  # immediate aftermath of the tmux-server crash the block above just
  # reconciled away, before anything has recreated the session - there is
  # nothing here to capture or message; it resumes automatically the moment
  # the session reappears (bin/spawn-crew/bin/crew-resume recreate it as a
  # side effect, same as today).
  if wm_tmux has-session -t "$WM_TMUX_TARGET" 2>/dev/null; then
    # Pane backstop over every working OR already-blocked member: two failure
    # shapes never reach the status files on their own. A member frozen on an
    # interactive permission/trust prompt is flipped to blocked (independent of
    # the crew's permission mode, so it still catches freezes when bypass is
    # disabled) - this applies whether the member was "working" or already
    # "blocked" for an unrelated reason (a member can answer one blocker and walk
    # straight into a fresh confirmation dialog, which would otherwise be
    # invisible: the backstop below used to scan only "working" members, so a
    # dialog freeze on top of a pre-existing blocker never got a second look). A
    # member gone silently idle - agent errored, nothing executing - is flipped to
    # stalled by wm-state stall-check; that diagnosis only makes sense for a
    # member that claims to be "working", since a "blocked" member sitting idle
    # is already exactly where it is supposed to be. Both then flow through the
    # normal needs-attention/fire path below.
    #
    # A `working` member holding a late-started descendant (an armed watcher,
    # an in-flight tool shell) is skipped by both stages - it is demonstrably
    # alive, so neither the nudge nor the flip applies (issue #234).
    #
    # review and stalled are also pulled into this same pane-capture loop
    # (issue #96), but only for Remote Control connection-state tracking - see
    # the review|stalled continue below, which skips them past every
    # freeze/stall diagnostic in this paragraph unchanged.
    for _row in $(wm_state crew-list --owner "$OWNER" --json 2>/dev/null | wm_py -c '
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
for r in data:
    st = r.get("status", "")
    # review/stalled (issue #96): widened so bin/watch-fleet observes a
    # Remote Control connection drop for the actual population
    # bin/crew-standdown hits, not only the working/blocked pair the
    # freeze/stall diagnostics below were originally scoped to. remote_control
    # absent reads as True (see cmd_crew_add in bin/lib/wm-state.py).
    if st in ("working", "blocked", "review", "stalled"):
        rc = "1" if r.get("remote_control", True) else "0"
        print(r.get("id", "") + ":" + st + ":" + rc)
' 2>/dev/null); do
      _id="${_row%%:*}"; _rest="${_row#*:}"; _orig_status="${_rest%%:*}"; _rc_enabled="${_rest#*:}"
      _win="wm-$_id"
      wm_tmux_windows | grep -qx "$_win" || continue
      wm_pane_snapshot "$_id" "$_win"

      # Pane-tail cache (#23, item 1): the last WM_APIERR_TAIL lines of this
      # poll's capture, overwritten in place every poll for every member in
      # this loop's widened population - never a growing log. Once a window
      # dies, this is the last thing we know its pane showed; wm-state
      # reconcile reads it at the moment of the death flip to attribute
      # death_cause.
      printf '%s\n' "$PANE_TEXT" | tail -n "$WM_APIERR_TAIL" \
        > "$WM_HOME/pane-tail-$(printf '%s' "$_id" | tr -c 'A-Za-z0-9._-' '_').txt"

      # Outbox redelivery: bin/crew-say queues a message it could not confirm
      # delivered (a dialog-shaped pane, an unconfirmed submit, a contended
      # send lock) under outbox/<id>/, so a relayed answer is never simply
      # dropped. Retry the OLDEST queued message once per poll per member -
      # wm_tmux_send_message itself still refuses a dialog-shaped pane, so a
      # still-blocked pane just leaves the queue intact for a later poll. A
      # multi-line (or long single-line - issue #169, M5) payload is
      # redelivered as a one-line pointer to the queued file (the same
      # pointer-not-payload rule crew-say applies on send); a short
      # single-line one is retyped directly. Delivered files move to
      # outbox/<id>/sent- so the queue holds only what is still owed. Only
      # attempted on a stability-confirmed pane (two identical consecutive
      # polls - the same rule every other acting check here uses): a pane
      # mid-repaint is a member mid-turn, and typing into it both risks
      # interleaving with its own output and can't be confirmed anyway.
      # Extracted to wm_outbox_try_redeliver (lib/common.sh) so this loop and
      # the whole-fleet backstop below share one implementation, forensically
      # logged to $WM_HOME/outbox-retry.log (issue #169, M1).
      wm_outbox_try_redeliver "$_id" "$(wm_tmux_win_target "$_win")" "$PANE_STABLE"

      # Stability-gated drop detection, computed once and shared by the
      # connection-state persistence below and the working-only reconnect
      # attempt beneath it - the same "one more poll before acting" rule
      # prompt_freeze_check and the API-error nudge both use, so a banner
      # merely scrolling transiently through a member's own transcript is
      # never mistaken for a live drop.
      _rc_dropped=0
      [ "$PANE_STABLE" = 1 ] && remote_control_dropped_check && _rc_dropped=1

      # Remote Control connection-state tracking (issue #96): persist this
      # poll's stability-gated observation onto the roster record for every
      # status in the widened population above, so bin/crew-standdown can
      # later read a value already vetted by this same rigor instead of
      # taking its own single-shot, unguardable pane read at standdown time.
      # Deliberately not reset back to true here when no drop is observed -
      # the only writer of "true" after spawn is a successful reconnect send
      # just below, matching the plan's own scope exactly.
      if [ "$_rc_enabled" = 1 ] && [ "$_rc_dropped" = 1 ]; then
        wm_state crew-set --id "$_id" --remote-control-connected false >/dev/null 2>&1
      fi

      # Remote Control auto-recovery (ask 2, crew-side): a settled disconnect
      # banner gets one `/remote-control` retry per cooldown window - the
      # existing message-delivery primitive, aimed at a pane it already has a
      # target for. Purely self-healing: it never changes crew status, so it
      # stays quiet the overwhelming majority of the time. Working members
      # only: an already-blocked member's pane is not expected to be showing a
      # live agent to reconnect.
      if [ "$_orig_status" = working ] && [ "$_rc_dropped" = 1 ]; then
        _rcfile="$WM_HOME/rcdrop-$(printf '%s' "$_id" | tr -c 'A-Za-z0-9._-' '_').sent"
        _rc_age=$(( $(date +%s) - $(wm_py -c 'import os,sys;print(int(os.path.getmtime(sys.argv[1])))' "$_rcfile" 2>/dev/null || echo 0) ))
        if [ ! -f "$_rcfile" ] || [ "$_rc_age" -ge "$RC_DROPPED_COOLDOWN" ]; then
          # Only mark the cooldown when the retry actually went out: a refusal
          # (rc 2, dialog-shaped pane), a contended send lock (rc 4), or a
          # busy pane with a pending composer (rc 6, issue #214) means nothing
          # was typed, so the next cycle should try again rather than sit out
          # a cooldown for a retry that never happened. rc 3 (typed, submit
          # unconfirmed, idle) and rc 5 (typed, submit unconfirmed, busy -
          # issue #188) both mark the cooldown like a success - the
          # keystrokes landed either way, and hammering /remote-control every
          # poll into a pane that doesn't repaint adds nothing.
          wm_tmux_send_message "$(wm_tmux_win_target "$_win")" "/remote-control"
          _rcretry_rc=$?
          if [ "$_rcretry_rc" -eq 0 ] || [ "$_rcretry_rc" -eq 3 ] || [ "$_rcretry_rc" -eq 5 ]; then
            : > "$_rcfile"
            # Reflect the self-heal back into the persisted field the same way
            # a detected drop is (issue #96).
            wm_state crew-set --id "$_id" --remote-control-connected true >/dev/null 2>&1
          elif [ "$_rcretry_rc" -eq 6 ]; then
            # Busy with a composer already holding text (issue #214) - nothing
            # was typed, and no cooldown is marked, so this retries again next
            # cycle. Logged rather than silent, so a member stuck busy across
            # many consecutive cycles is visible instead of quietly retried
            # forever.
            wm_warn "'$_id' is mid-turn with a pending composer - could not retry its /remote-control reconnect this cycle; will retry next cycle."
          fi
        fi
      fi

      # Pane-liveness observations, computed here - ABOVE the review/stalled
      # skip just below - because they are now shared by THREE consumers: the
      # stalled re-evaluation immediately below (issue #235), wm-state
      # wedge-check (issue #202, needs them for both working and blocked
      # members), and the stall-check call further down (working only, once
      # the blocked skip has already `continue`d past this poll for a
      # blocked one). Moving the computation up (not just a call) costs
      # nothing extra - it is one `tmux list-windows` and one `list-panes`,
      # already paid for every 'working' member every poll before this
      # change.
      _idle="$(wm_tmux_window_activity_age "$_win")"
      _pid="$(wm_tmux_pane_pid "$_win")"

      # Stalled re-evaluation (#235): `stalled` is the one status the supervisor
      # imposes unilaterally (see LIVE_STATES in bin/lib/wm-state.py), and until
      # now the `continue` just below made it a one-way latch - no diagnostic
      # ever looked at the record again, so a member that resumed activity stayed
      # flagged until a human noticed. This re-runs the SAME detector's own
      # evidence (recorded on the record's `stall` object at flip time) and
      # reverts only on a sustained contradiction. Deliberately NOT a liveness
      # probe for every source: a wedge-stalled (#202) or forward-motion-stalled
      # (#199) member has a live process tree BY CONSTRUCTION, so a uniform
      # liveness revert would delete both of those mechanisms outright.
      if [ "$_orig_status" = stalled ]; then
        _pane_changed=1
        [ "$PANE_STABLE" = 1 ] && _pane_changed=0
        _recheck="$(wm_state stall-recheck --id "$_id" \
          --pane-pid "${_pid:-0}" --pane-changed "$_pane_changed" \
          --root-grace "$STALL_ROOT_GRACE" \
          --confirmations "$WM_STALL_RECHECK_CONFIRMS" 2>/dev/null)"
        # Logged, never fired: an auto-clear corrects the supervisor's OWN prior
        # conclusion, so it wakes nobody. Do NOT route this into fire()/$attention
        # or add a --classify outcome for it - the log line and the board render
        # are the whole surface. (The one thing that does still surface is a
        # revert to `blocked`, which re-announces its restored blocker through
        # the ordinary needs-attention path, not through anything here.)
        if [ -n "$_recheck" ]; then
          printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_recheck" \
            >> "$WM_HOME/stall-recheck.log"
        fi
      fi

      # review/stalled were widened into this loop above solely for the
      # Remote Control connection-state tracking just above; the stalled
      # re-evaluation just above is the one diagnostic that now runs for a
      # `stalled` record before this `continue` - every OTHER freeze/stall
      # diagnostic below still does not apply to either status (a review
      # member sitting idle is exactly where it's supposed to be, and
      # prompt_freeze_check's blocked-flip is scoped to the working/blocked
      # population this loop originally covered).
      case "$_orig_status" in
        review|stalled) continue ;;
      esac

      if prompt_freeze_check && ! liveness_veto "$_id"; then
        # Which of the two dialog shapes prompt_freeze_check actually matched
        # (#23/#30) decides the wording: the resume-from-summary menu is a
        # specific, well-understood freeze needing exactly one keypress, not
        # the generic "no one at its terminal" framing of an ordinary
        # permission/trust gate.
        if printf '%s\n' "$PANE_TEXT" | tail -n "$WM_PERM_TAIL" | grep -qE "$WM_RESUME_PROMPT_RE"; then
          _blocker="frozen on the resume-from-summary prompt (issue #30) after an auto-recovery attempt - needs one keypress via bin/crew-takeover $_id"
        else
          _blocker="frozen on a permission/trust prompt with no one at its terminal; approve it via bin/crew-takeover $_id, or relaunch the crew with bypass"
        fi
        wm_state crew-set --id "$_id" --status blocked --blocker "$_blocker" >/dev/null 2>&1
        continue   # the permission freeze is the more specific diagnosis, superseding any prior blocker reason
      fi

      # _idle/_pid are already computed above (hoisted ahead of the
      # review/stalled skip, issue #235 - see the comment up there).

      # wm-state wedge-check (issue #202, layer B): flips a member wedged
      # mid-turn on a foreground watch-fleet/pr-watch call to 'stalled' once
      # its pane has repainted continuously - never idle at a prompt - for
      # WM_WEDGE_SECS while its own record has gone unwritten for the same
      # window AND a matching descendant has been running that long. Sits
      # ABOVE the blocked skip on purpose (the opposite of stall-check below
      # it): the wedge signature applies to a 'blocked' member exactly as
      # much as a 'working' one - answering a blocker and then foregrounding
      # a watcher wedges a session just as surely as doing it mid-task - and
      # wedge-check itself gates on status internally (working/blocked only,
      # everything else a no-op), so nothing else in this loop needs to admit
      # blocked members on its behalf.
      [ -n "$_pid" ] && wm_state wedge-check --id "$_id" \
        --pane-idle "$_idle" --pane-pid "$_pid" --root-grace "$STALL_ROOT_GRACE" \
        --threshold "$WM_WEDGE_SECS" --pane-gap "$WM_WEDGE_PANE_GAP" >/dev/null 2>&1

      # An already-blocked member with no dialog freeze detected needs no further
      # diagnosis here: its existing blocker reason is left untouched, and the
      # stall/api-error checks below only make sense for a member that claims to
      # be actively working.
      [ "$_orig_status" = blocked ] && continue

      # A prompt-shaped pane whose stability is not yet confirmed (first sighting,
      # no prior hash) is one INTERVAL from a definitive diagnosis; hold the stall
      # check off it, or a dialog frozen longer than STALL_IDLE before our first
      # look would be flipped stalled on poll one and - having left the working
      # scan - never get its confirming second sighting as blocked.
      [ "$PFC_SHAPE" = 1 ] && continue

      # Silent-stall backstop: no pane repaint AND no status update for STALL_IDLE
      # seconds nominates the member; stall-check probes its process tree and flags
      # it stalled only if nothing there is executing or armed to wake it.

      # Stall self-heal nudge (#61, retry/confirm reworked by #236): every
      # stall-idle, pane-stable candidate gets a check-in nudge before
      # stall-check is even allowed to confirm+flip it - not only an api-error
      # match. The per-id marker ($WM_HOME/stall-<id>.nudged) now carries STATE
      # (confirmed|pending), not mere existence: it is stamped 'confirmed' only
      # on wm_tmux_send_message rc 0 (the composer went empty / the pane
      # advanced past its composed snapshot); rc 3/5 (typed, Enter pressed, but
      # the submit was never confirmed) burn one bounded attempt against
      # WM_STALL_NUDGE_TRIES and leave the marker 'pending', which keeps
      # --nudge-age at -1 and so keeps stall-check's flip gate closed for a
      # retry; every other rc (nothing was even typed) leaves the marker
      # untouched entirely, retried next qualifying poll - today's original
      # behavior for that class, unchanged. Once the retry budget is
      # exhausted, a best-effort composer clear is attempted (never verified -
      # see wm_tmux_clear_pending_composer) so the stray unsubmitted text
      # cannot later concatenate onto a human's next message, and --nudge-age
      # is finally reported (with --nudge-confirmed 0) so stall-check's reason
      # text tells the truth: a nudge was attempted, not that one landed. A
      # marker older than WM_STALL_NUDGE_TTL is deleted and treated as absent,
      # starting a fresh episode - the #101-closing property this preserves in
      # its new form is that clock_epoch, unlike a bare mtime, is never
      # advanced by a retry: it is set once, at the first composer-leaving
      # attempt of an episode (or at confirmation, for the confirmed case), so
      # a marker's reported age can only grow within one episode and the flip
      # can never be starved by a resend racing stall-check's own threshold.
      _api=0
      _nudge_age=-1
      _nudge_confirmed=1
      _nudge_attempts=0
      _just_nudged=0
      _nudge_undelivered=0
      if [ "$_idle" -ge "$STALL_IDLE" ]; then
        if [ "$PANE_STABLE" != 1 ]; then
          continue   # first sighting or still changing; one more poll before acting
        fi
        # Computed every poll, not only the one that sends the nudge: --api-error
        # feeds stall-check's reason-text choice on whichever poll eventually
        # flips it, which is almost never the same poll as the send.
        if api_error_check; then
          _api=1
          # Fleet-wide outage signal (#23, item 0): this poll's count of
          # working members currently showing the API-error signature, fed
          # to wm_state outage-update below (owner "" only) after this loop.
          _OUTAGE_API_SIGNALS=$((_OUTAGE_API_SIGNALS+1))
          _nudge_msg="An API/connectivity error appears to have interrupted your last turn (rate limit, network blip, or a brief Anthropic-side outage). This is usually transient - please retry your last action."
        else
          _nudge_msg="Checking in: if you're mid-task, keep going. If you're stuck, unstick yourself and continue."
        fi
        # issue #234: the check-in nudge below is stage 1 of an escalation that
        # wm_state stall-check (stage 2, at the bottom of this loop body) has
        # already declined for a member whose pane tree holds a late-started
        # descendant - an armed watcher, an in-flight tool shell. A lead parked
        # on its own watch-fleet/Stop-hook chain is exactly that shape, by
        # design, for as long as its delegates work. Nudging it types into a
        # correctly-parked session and burns one of its turns for an escalation
        # that cannot happen, so ask the same question stage 2 asks, before
        # typing rather than after, and skip the whole episode for this poll.
        #
        # Placed AFTER api_error_check on purpose: _OUTAGE_API_SIGNALS must
        # still count this member for the fleet-wide outage state machine (#23)
        # - only the keystroke is suppressed, never the observation. The probe
        # is branch (a) only (see cmd_liveness_probe), so it answers 'alive' for
        # a strict subset of what stage 2 refuses: this can never silence a
        # member that would otherwise have been escalated.
        #
        # `continue` also skips this poll's stall-check call, which would have
        # re-run the same probe and returned without flipping - so the net cost
        # for an exempt member is one subprocess swapped for another. (It saves
        # no sleep: _probe_execution returns at branch (a) before it ever
        # reaches its sampling sleep, so an exempt member's stall-check call
        # never slept either.)
        if [ -n "$_pid" ] && [ "$(wm_state liveness-probe --pane-pid "$_pid" \
             --root-grace "$STALL_ROOT_GRACE" 2>/dev/null)" = alive ]; then
          continue
        fi
        _idkey="$(printf '%s' "$_id" | tr -c 'A-Za-z0-9._-' '_')"
        _nudgefile="$WM_HOME/stall-$_idkey.nudged"
        _now=$(date +%s)

        # The undelivered-nudge escape hatch (issue #214) and the confirm/
        # retry marker (issue #236) track two genuinely different things and
        # are kept in two separate sidecars rather than overloading one:
        # .nudge-refused counts an UNBROKEN STREAK of sends that never even
        # typed a byte (rc 2 dialog, 4 lock-contended, 6 busy-with-pending-
        # composer), independent of whatever .nudged currently holds; .nudged
        # (below) only ever changes on a send that DID type something (rc
        # 0/3/5). "<count> <first_refusal_epoch>" - extended from #214's
        # original bare-count shape so this escape hatch's own --nudge-age can
        # be computed the same way the confirm/retry marker's is, rather than
        # by stamping a synthetic empty .nudged that #236's parser would
        # otherwise have to special-case. Invalid content (including a bare
        # pre-extension count with no clock) is read as a fresh count-0
        # streak rather than risk misreading a stale/foreign value as a real
        # clock.
        _refusedfile="$WM_HOME/stall-$_idkey.nudge-refused"
        _rf_rec="$(cat "$_refusedfile" 2>/dev/null)"
        _refused_count="${_rf_rec%% *}"
        _refused_clock="${_rf_rec#* }"
        case "$_refused_count" in ''|*[!0-9]*) _refused_count=0 ;; esac
        case "$_refused_clock" in ''|*[!0-9]*|"$_refused_count") _refused_clock="$_now" ;; esac

        # Parse the .nudged marker into scratch vars, promoting only after
        # validation (state must be exactly confirmed|pending; attempts/clock
        # must be non-empty and all-digits). A validation failure - including
        # the empty file every pre-#236 marker is - MUST set all three:
        # state=confirmed, attempts=0, clock=the marker's mtime, which is
        # exactly today's pre-#236 behavior and the deliberate migration path
        # (no member gets stuck, no re-nudge storm on upgrade). Leaving
        # _nudge_attempts empty here would silently kill the whole stall-check
        # call below (argparse type=int, swallowed by its 2>/dev/null at the
        # call site) with no diagnostic anywhere.
        _nudge_state=""
        _nudge_clock=""
        if [ -f "$_nudgefile" ]; then
          _nr_rec="$(cat "$_nudgefile" 2>/dev/null)"
          _nr_state="${_nr_rec%% *}"
          _nr_rest="${_nr_rec#* }"
          _nr_attempts="${_nr_rest%% *}"
          _nr_clock="${_nr_rest##* }"
          _nr_valid=1
          case "$_nr_state" in
            confirmed|pending) : ;;
            *) _nr_valid=0 ;;
          esac
          case "$_nr_attempts" in
            ""|*[!0-9]*) _nr_valid=0 ;;
          esac
          case "$_nr_clock" in
            ""|*[!0-9]*) _nr_valid=0 ;;
          esac
          if [ "$_nr_valid" -eq 1 ]; then
            _nudge_state="$_nr_state"
            _nudge_attempts="$_nr_attempts"
            _nudge_clock="$_nr_clock"
          else
            _nudge_state="confirmed"
            _nudge_attempts=0
            _nudge_clock="$(wm_py -c 'import os,sys;print(int(os.path.getmtime(sys.argv[1])))' "$_nudgefile" 2>/dev/null || echo "$_now")"
          fi
        fi

        # TTL expiry (Defect B fix, #236): a marker whose clock is older than
        # WM_STALL_NUDGE_TTL belongs to a concluded episode - reap it and
        # start fresh rather than let it gate a later, unrelated episode.
        if [ -n "$_nudge_state" ] && [ $(( _now - _nudge_clock )) -gt "$WM_STALL_NUDGE_TTL" ]; then
          rm -f "$_nudgefile"
          _nudge_state=""
        fi

        case "$_nudge_state" in
          confirmed)
            _nudge_age=$(( _now - _nudge_clock ))
            ;;
          pending)
            if [ "$_nudge_attempts" -ge "$WM_STALL_NUDGE_TRIES" ]; then
              _nudge_age=$(( _now - _nudge_clock ))
              _nudge_confirmed=0
            else
              wm_tmux_send_message "$(wm_tmux_win_target "$_win")" "$_nudge_msg"
              _nudge_rc=$?
              if [ "$_nudge_rc" -eq 0 ]; then
                printf 'confirmed %d %d\n' "$_nudge_attempts" "$_now" > "$_nudgefile"
                _just_nudged=1
                rm -f "$_refusedfile" 2>/dev/null
                _refused_count=0
              elif [ "$_nudge_rc" -eq 3 ] || [ "$_nudge_rc" -eq 5 ]; then
                _nudge_attempts=$(( _nudge_attempts + 1 ))
                printf 'pending %d %d\n' "$_nudge_attempts" "$_nudge_clock" > "$_nudgefile"
                if [ "$_nudge_attempts" -ge "$WM_STALL_NUDGE_TRIES" ]; then
                  wm_tmux_clear_pending_composer "$(wm_tmux_win_target "$_win")" || true
                fi
                rm -f "$_refusedfile" 2>/dev/null
                _refused_count=0
              elif [ "$_nudge_rc" -eq 2 ] || [ "$_nudge_rc" -eq 4 ] || [ "$_nudge_rc" -eq 6 ]; then
                _refused_count=$(( _refused_count + 1 ))
                printf '%d %d\n' "$_refused_count" "$_refused_clock" > "$_refusedfile"
              fi
              # rc 2/4/6 above burns no #236 retry budget (nothing was typed,
              # so .nudged is left untouched and retried next qualifying
              # poll) but DOES feed the #214 escape hatch above, so a
              # composer-leaving retry that keeps landing on a busy/dialog/
              # locked pane still eventually escalates instead of holding the
              # flip gate closed forever.
            fi
            ;;
          *)
            _nudge_clock="$_now"
            _nudge_attempts=0
            wm_tmux_send_message "$(wm_tmux_win_target "$_win")" "$_nudge_msg"
            _nudge_rc=$?
            if [ "$_nudge_rc" -eq 0 ]; then
              printf 'confirmed %d %d\n' "$_nudge_attempts" "$_now" > "$_nudgefile"
              _just_nudged=1
              rm -f "$_refusedfile" 2>/dev/null
              _refused_count=0
            elif [ "$_nudge_rc" -eq 3 ] || [ "$_nudge_rc" -eq 5 ]; then
              _nudge_attempts=$(( _nudge_attempts + 1 ))
              printf 'pending %d %d\n' "$_nudge_attempts" "$_nudge_clock" > "$_nudgefile"
              if [ "$_nudge_attempts" -ge "$WM_STALL_NUDGE_TRIES" ]; then
                wm_tmux_clear_pending_composer "$(wm_tmux_win_target "$_win")" || true
              fi
              rm -f "$_refusedfile" 2>/dev/null
              _refused_count=0
            elif [ "$_nudge_rc" -eq 2 ] || [ "$_nudge_rc" -eq 4 ] || [ "$_nudge_rc" -eq 6 ]; then
              _refused_count=$(( _refused_count + 1 ))
              printf '%d %d\n' "$_refused_count" "$_refused_clock" > "$_refusedfile"
            fi
            ;;
        esac

        # Derived from the persisted counter on EVERY qualifying poll, never
        # only on the poll that incremented it past the max - the poll that
        # crosses the max is never the poll that flips (--nudge-age must
        # still climb to STALL_IDLE across later polls first), so a flag set
        # only at that moment would not be set on the flipping poll and
        # stall-check's undelivered-nudge reason would never render. Takes
        # priority over the #236 confirm/retry age above (see wm-state.py):
        # if a nudge could never even be typed, that dominates whatever an
        # unrelated earlier attempt's own confirm state was.
        if [ "$_refused_count" -ge "$WM_NUDGE_REFUSED_MAX" ]; then
          _nudge_undelivered=1
          _nudge_age=$(( _now - _refused_clock ))
        fi
      fi

      # Surface the nudge on the crew record itself (#155 fix 1): the marker
      # file above is a private sidecar the watcher alone reads, so nothing on
      # the board or in crew-list ever showed that this 'working' member had
      # already been nominated and nudged - a member quietly mid-self-heal
      # looked identical to one that was simply healthy and busy. --just-
      # nudged rides on the SAME stall-check call this poll already makes for
      # every candidate (never a second subprocess spawned just to persist a
      # timestamp - that extra uv/python startup per nudged member per poll
      # was enough to visibly skew the tight multi-member timing the outage-
      # detection tests depend on). stall-check stamps nudged_at onto the
      # member's own status JSON without touching its summary/status;
      # cmd_crew_set clears it again the moment the member's own next self-
      # report comes in, and stall-check clears it itself on a genuine stall
      # flip (see wm-state.py). --just-nudged is now (#236) set only on a
      # CONFIRMED send (rc 0), so the nudged_at annotation can never again
      # describe an unconfirmed attempt as delivered.
      [ -n "$_pid" ] && wm_state stall-check --id "$_id" \
        --nudge-age "$_nudge_age" --just-nudged "$_just_nudged" \
        --nudge-confirmed "$_nudge_confirmed" --nudge-attempts "$_nudge_attempts" \
        --pane-idle "$_idle" --pane-pid "$_pid" --threshold "$STALL_IDLE" \
        --root-grace "$STALL_ROOT_GRACE" --probe-gap "$STALL_PROBE_GAP" \
        --cpu-eps "$STALL_CPU_EPS" --api-error "$_api" \
        --nudge-undelivered "$_nudge_undelivered" >/dev/null 2>&1
    done
  fi

  # The whole-fleet outbox backstop (issue #169, piece 1): wingman's own
  # top-level cycle only (owner "" - the one component the architecture
  # guarantees stays alive). The per-member loop above is owner-scoped (only
  # this cycle's own direct reports), so a nested member's outbox otherwise
  # depends entirely on ITS OWN lead's watcher being armed and current - real
  # latency hardening for the case where it is not. For every pending outbox
  # id NOT already covered by the loop above (i.e. not a direct report of
  # $OWNER) with a live wm-<id> window, take a separately NAMESPACED pane
  # snapshot (never the shared $WM_HOME/pane-<id>.hash the owner-scoped loop
  # above may also be reading for this same id at a different phase of its
  # own interval - round-1's M4) and attempt redelivery through the same
  # claim-protocol-governed helper. Concurrency is accepted, not engineered
  # around: a lead's own cycle and this backstop can both attempt the same
  # queued file's send within the same few seconds; the per-pane send lock
  # still serializes the actual keystrokes, so the worst case is an
  # occasional duplicate delivery, never a corruption (the same tradeoff
  # issue #188's own plan already accepts for its rc 5 path).
  if [ -z "$OWNER" ] && wm_tmux has-session -t "$WM_TMUX_TARGET" 2>/dev/null; then
    _bs_any_pending=0
    for _bs_dir in "$WM_HOME"/outbox/*/; do
      [ -d "$_bs_dir" ] || continue
      for _bs_f in "$_bs_dir"*; do
        [ -e "$_bs_f" ] || continue
        case "$(basename "$_bs_f")" in sent-*) continue ;; esac
        _bs_any_pending=1; break 2
      done
    done
    if [ "$_bs_any_pending" = 1 ] && _bs_roster_json="$(wm_state crew-list --all --json 2>/dev/null)"; then
      _bs_live_windows="$(wm_tmux_windows)"
      for _bs_dir in "$WM_HOME"/outbox/*/; do
        [ -d "$_bs_dir" ] || continue
        _bs_id="$(basename "$_bs_dir")"
        _bs_parent="$(printf '%s' "$_bs_roster_json" | wm_py -c '
import json, sys
tid = sys.argv[1]
try:
    roster = json.load(sys.stdin)
except Exception:
    roster = []
for r in roster if isinstance(roster, list) else []:
    if r.get("id") == tid:
        print(r.get("parent") or "")
        sys.exit(0)
' "$_bs_id")"
        [ "$_bs_parent" = "$OWNER" ] && continue   # already serviced by the owner-scoped loop above
        _bs_win="wm-$_bs_id"
        printf '%s\n' "$_bs_live_windows" | grep -qx "$_bs_win" || continue
        wm_pane_snapshot "$_bs_id" "$_bs_win" backstop
        wm_outbox_try_redeliver "$_bs_id" "$(wm_tmux_win_target "$_bs_win")" "$PANE_STABLE"
      done
    fi
  fi

  # Fleet-wide outage-state machine (#23, item 0): advanced every iteration,
  # wingman's own top-level cycle only (owner "" - concurrency/outage is
  # fleet-wide, not per-lead-team; a lead's cycle skips this entirely).
  # Unlike self_pane_check above, this is deliberately NOT a sixth/seventh
  # top-level --classify outcome: it writes $EXITFILE "fire" (the same token
  # the ordinary fire() path below writes) so outage-detected/outage-cleared
  # surface as ordinary fire reasons within the existing five-outcome
  # classification (healthy/fire/remote-control-dropped/spurious/spurious-
  # repeated) - structurally identical to a blocked/review/done/died/stalled
  # reason line today, just fleet-scoped (no per-member id to ack) rather
  # than routed through fire()'s needs-attention/group-attention machinery.
  if [ -z "$OWNER" ]; then
    _died_csv="$(printf '%s' "$_reconcile_died" | tr ' ' ',')"
    _outage_transition="$(wm_state outage-update --owner "" \
      --signal-working "$_OUTAGE_API_SIGNALS" --died "$_died_csv" \
      --mass-min-count "$MASS_MIN_COUNT" --mass-min-ratio "$MASS_MIN_RATIO" \
      --quiet-seconds "$WM_OUTAGE_QUIET" 2>/dev/null)"
    case "$_outage_transition" in
      outage-detected)
        {
          echo "# API outage detected (issue #23)"
          echo
          echo "Anthropic API-error signals (529/5xx/rate-limit/connection signatures) have"
          echo "crossed the fleet-wide mass threshold - treat this as a likely outage, not"
          echo "isolated incidents."
          echo
          echo "New spawns are now PAUSED: hooks/api-outage-spawn-guard.sh denies"
          echo "bin/spawn-crew while this state is active (override per-spawn with"
          echo "--force-during-outage if one is genuinely needed regardless)."
          echo
          echo "Already-running crew are NOT affected - only new spawns are held."
          echo
          echo "This clears automatically once the signal quiets down for ${WM_OUTAGE_QUIET}s;"
          echo "your next watch-fleet cycle fires outage-cleared the moment it does."
        } > "$WAKEFILE"
        echo "outage-detected: fleet-wide API-error signal crossed the mass threshold - new spawns paused (bin/spawn-crew denied by hooks/api-outage-spawn-guard.sh; override with --force-during-outage if truly needed). Already-running crew are untouched."
        printf 'fire\n' > "$EXITFILE"
        rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
        exit 0
        ;;
      outage-cleared)
        _outage_died_ids="$(wm_state crew-list --status died --json 2>/dev/null | wm_py -c '
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
print(" ".join(r.get("id", "") for r in data if r.get("death_cause") == "api-outage"))
' 2>/dev/null)"
        {
          echo "# API outage cleared (issue #23)"
          echo
          echo "The fleet-wide API-error signal has been quiet for ${WM_OUTAGE_QUIET}s. New"
          echo "spawns are unpaused."
          echo
          if [ -n "$_outage_died_ids" ]; then
            echo "Outage-tagged died member(s): $_outage_died_ids"
            echo
            echo "Per the pilot's pre-authorized auto-recovery for this case (CLAUDE.md,"
            echo "\"Mass death or correlated outage detected\"): run \`bin/crew-resume --all-died\`"
            echo "now, without asking for confirmation, then report the outcome."
          else
            echo "No member is currently died with death_cause=api-outage, so there is"
            echo "nothing to auto-resume."
          fi
        } > "$WAKEFILE"
        echo "outage-cleared: fleet-wide API-error signal has quieted for ${WM_OUTAGE_QUIET}s - new spawns unpaused.${_outage_died_ids:+ Outage-tagged died member(s) ($_outage_died_ids): pre-authorized auto-recovery, run bin/crew-resume --all-died now.}"
        printf 'fire\n' > "$EXITFILE"
        rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
        exit 0
        ;;
    esac
  fi

  # Proactive usage-limit-quota state machine (#24): advanced every
  # iteration, wingman's own top-level cycle only (owner "" - the account's
  # usage quota is shared fleet-wide, never per-lead-team). Aggregates every
  # $WM_HOME/usage/<session-id>.json (written by bin/lib/usage-statusline.py,
  # the installed statusLine command) into the max used_percentage/resets_at
  # per window among readings that are both fresh (captured_at within
  # WM_USAGE_STALE_SECS) and live (resets_at still in the future - see
  # wm_state usage-update's own docstring for why a frozen high reading
  # cannot be trusted on captured_at freshness alone). Dispatched as an
  # ordinary `fire` reason line within the existing five-outcome --classify
  # contract, exactly like outage-detected/outage-cleared above - no new
  # --classify outcome is introduced.
  #
  # The same pass also sweeps usage/*.json files whose session has long
  # since ended (#125, follow-up to #24): a file whose captured_at is more
  # than WM_USAGE_SWEEP_SECS old (default 24h - an order of magnitude past
  # WM_USAGE_STALE_SECS, so a live session's own file is never at risk) is
  # removed so the directory does not grow unboundedly for the lifetime of
  # $WM_HOME.
  if [ -z "$OWNER" ]; then
    _usage_agg="$(wm_py -c '
import datetime, glob, json, os, sys, time

home = os.environ.get("WINGMAN_HOME") or os.path.expanduser("~/.wingman")
stale_secs = float(sys.argv[1])
sweep_secs = float(sys.argv[2])
now = time.time()


def parse_iso(stamp):
    if not stamp:
        return None
    s = stamp[:-1] if stamp.endswith("Z") else stamp
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S"):
        try:
            dt = datetime.datetime.strptime(s, fmt).replace(tzinfo=datetime.timezone.utc)
            return dt.timestamp()
        except ValueError:
            continue
    return None


best = {}
for path in glob.glob(os.path.join(home, "usage", "*.json")):
    try:
        with open(path) as fh:
            rec = json.load(fh)
    except (OSError, ValueError):
        continue
    if not isinstance(rec, dict):
        continue
    captured = parse_iso(rec.get("captured_at"))
    if captured is None or (now - captured) > sweep_secs:
        try:
            os.remove(path)
        except OSError:
            pass
        continue
    if (now - captured) > stale_secs:
        continue
    for window in ("five_hour", "seven_day"):
        w = rec.get(window)
        if not isinstance(w, dict):
            continue
        pct = w.get("used_percentage")
        resets_at = w.get("resets_at")
        if not isinstance(pct, (int, float)) or not isinstance(resets_at, (int, float)):
            continue
        if resets_at <= now:
            continue
        cur = best.get(window)
        if cur is None or pct > cur[0]:
            best[window] = (pct, resets_at)

five = best.get("five_hour", ("", ""))
seven = best.get("seven_day", ("", ""))
print("%s\t%s\t%s\t%s" % (five[0], five[1], seven[0], seven[1]))
' "$WM_USAGE_STALE_SECS" "$WM_USAGE_SWEEP_SECS" 2>/dev/null)"
    IFS=$'\t' read -r _usage_five_pct _usage_five_reset _usage_seven_pct _usage_seven_reset <<EOF_USAGE
$_usage_agg
EOF_USAGE

    _usage_transition="$(wm_state usage-update --owner "" \
      ${_usage_five_pct:+--five-hour-pct "$_usage_five_pct" --five-hour-resets-at "$_usage_five_reset"} \
      ${_usage_seven_pct:+--seven-day-pct "$_usage_seven_pct" --seven-day-resets-at "$_usage_seven_reset"} \
      --warn-threshold "$WM_USAGE_WARN_THRESHOLD" 2>/dev/null)"
    case "$_usage_transition" in
      usage-limit-approaching)
        _usage_info="$(wm_py -c '
import json, os

home = os.environ.get("WINGMAN_HOME") or os.path.expanduser("~/.wingman")
try:
    with open(os.path.join(home, "usage-limit-state.json")) as fh:
        d = json.load(fh)
except (OSError, ValueError):
    d = {}
window_label = {"five_hour": "5-hour", "seven_day": "7-day"}.get(d.get("window"), d.get("window") or "usage")
pct = d.get("used_percentage")
pct_text = ("%.0f%%" % pct) if isinstance(pct, (int, float)) else "an unknown amount"
resets_at = d.get("resets_at")
print("%s\t%s\t%s" % (window_label, pct_text, resets_at if resets_at is not None else "an unknown time"))
' 2>/dev/null)"
        IFS=$'\t' read -r _usage_window_label _usage_pct_text _usage_resets_at <<EOF_USAGE
$_usage_info
EOF_USAGE
        {
          echo "# Usage-limit quota approaching (issue #24)"
          echo
          echo "The $_usage_window_label usage window is at $_usage_pct_text, resets at"
          echo "epoch $_usage_resets_at."
          echo
          echo "New spawns are now PAUSED: hooks/usage-limit-spawn-guard.sh denies"
          echo "bin/spawn-crew while this state is approaching/paused (override per-spawn"
          echo "with --force-during-usage-limit if one is genuinely needed regardless)."
          echo
          echo "Already-running crew are NOT affected by this pause - only new spawns are"
          echo "held. This does NOT park or checkpoint in-flight crew: a member already"
          echo "running keeps consuming quota and can still hit the hard limit mid-turn on"
          echo "its own, whichever way the pilot answers below."
          echo
          echo "Ask the pilot (wait for the reset, or continue anyway and accept the risk),"
          echo "then record the answer immediately with \`\$WINGMAN_STATE usage-decide"
          echo "--decision wait|continue\`."
        } > "$WAKEFILE"
        echo "usage-limit-approaching: $_usage_window_label usage window at $_usage_pct_text (resets at epoch $_usage_resets_at) - new spawns paused (bin/spawn-crew denied by hooks/usage-limit-spawn-guard.sh; override with --force-during-usage-limit if truly needed). Already-running crew are untouched and can still hit the hard limit on their own. Ask the pilot wait-vs-continue and record the answer with usage-decide."
        printf 'fire\n' > "$EXITFILE"
        rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
        exit 0
        ;;
      usage-limit-reset)
        {
          echo "# Usage-limit window reset (issue #24)"
          echo
          echo "The usage window has reset on its own. New spawns are unpaused again -"
          echo "nothing further to do."
        } > "$WAKEFILE"
        echo "usage-limit-reset: the usage window reset - new spawns unpaused again."
        printf 'fire\n' > "$EXITFILE"
        rm -f "$PIDFILE"; rm -rf "$OWNERLOCK"
        exit 0
        ;;
    esac
  fi

  # Structural forward-motion / logical-stall detection (issue #199, Gap B):
  # run BEFORE needs-attention, not merged into $attention afterward like
  # review-resurface-check below - this call performs the roster mutation
  # (a direct flip to 'stalled') itself, and needs-attention must see that
  # fresh status in the very same cycle it was written, exactly the same
  # ordering relationship the per-id stall-check loop above already has with
  # this same needs-attention call.
  #
  # Liveness-aware since issue #244: hand forward-motion-check a session-wide
  # pane-pid snapshot (one tmux call, no extra wm_state subprocess) so that,
  # ONLY for a candidate that has actually reached --window-secs this poll, it
  # can probe that candidate's working children's process trees for genuine
  # CPU spend over a sampling gap before flipping. A live probe resets the
  # anchor instead of flipping - the same treatment a genuine reported-state
  # change already gets. Deliberately CPU-delta evidence only (_probe_cpu_delta,
  # not _probe_execution and not the cheap liveness-probe used elsewhere in
  # this file for issue #234): a delegate merely parked on its own idle armed
  # watcher always has a late-started descendant, so anything that answers
  # branch (a)'s question would read it "alive" too and silently defeat this
  # detector for its most ordinary population - see bin/lib/wm-state.py's
  # cmd_forward_motion_check docstring. No --root-grace: that parameter is
  # branch (a)'s alone, and this call path never uses it.
  wm_tmux list-panes -s -t "$WM_TMUX_TARGET" -F '#{window_name} #{pane_pid}' 2>/dev/null \
    | wm_state forward-motion-check --owner "$OWNER" --window-secs "$WM_FORWARD_MOTION_SECS" \
        --probe-gap "$STALL_PROBE_GAP" --cpu-eps "$STALL_CPU_EPS" \
        --pane-pids-stdin >/dev/null 2>&1
  # Who needs this owner right now? Scoped to the owner's own direct reports, so a
  # lead's worker never wakes wingman and vice versa. Checked at the top of the loop
  # so an event already pending on arm fires immediately (at-least-once re-arms).
  # --suppress-on ack (the default, explicit here) is the watcher/fire gate: an
  # event already acked (surfaced and in flight) or handled does not re-fire, while
  # a new (id, updated) still surfaces. The Stop hook uses --suppress-on handled so
  # an acked-but-unhandled event still blocks once (Fix A / #8).
  attention="$(wm_state needs-attention --owner "$OWNER" --suppress-on ack 2>/dev/null)"
  # Bounded resurface for a `review` member with no live dependency watcher
  # (issue #187): one reminder per WM_REVIEW_RESURFACE_SECS window, only when
  # nothing (e.g. a bin/pr-watch cycle) is currently polling on the member's
  # behalf. Merged into $attention before fire() so it flows through the
  # identical fire -> $WAKEFILE/$EXITFILE -> harness-exit channel every other
  # event already uses; fire()'s own ack of each row is a harmless no-op here
  # since this event's own suppression lives entirely in its own on-disk
  # stamp, not acked.json.
  resurface="$(wm_state review-resurface-check --owner "$OWNER" \
    --window-secs "$WM_REVIEW_RESURFACE_SECS" --waker-grace "$WM_REVIEW_WAKER_GRACE" 2>/dev/null)"
  if [ -n "$resurface" ]; then
    attention="${attention:+$attention
}$resurface"
  fi
  # A pending outbox-abandonment notice (issue #169) fires this cycle too,
  # even with no genuine attention event of its own - see fire()'s own
  # notice-only handling above.
  { [ -n "$attention" ] || [ -s "$NOTICEFILE" ]; } && fire "$attention"

  sleep "$INTERVAL"
done
