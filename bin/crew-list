#!/usr/bin/env bash
# crew-list - print the roster (merged roster + live status), reconciled against
# the live tmux windows first so a crew member whose window died shows as 'died'.
#
# By default it scopes to the caller's own direct reports, so each layer sees only
# its crew: wingman ($WINGMAN_CREW_ID unset -> "") sees the top level, a lead sees
# its workers. Drill down with an explicit --owner, render the whole org with
# --tree, or flatten every layer with --all-owners.
#
# Usage:
#   crew-list                 the caller's direct reports (compact human roster)
#   crew-list --json          machine-readable merged roster
#   crew-list --active        only working/blocked/review
#   crew-list --status <s>    filter by a status
#   crew-list --owner <id>    a specific manager's team ("" = top level)
#   crew-list --tree          the whole hierarchy, indented
#   crew-list --all-owners    every layer, flat (no owner scoping)
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"

# Reconcile liveness before rendering (cheap, zero-token). Reconciled against
# every window in the crew session's own prefix family (#209), not just
# whether the crew session itself exists: the crew session is exactly what
# a tmux-server crash takes down first, so gating reconcile on its existence
# was the one case reconcile exists to catch. Skipped only when the tmux
# server itself is unreachable (wm_tmux_reachable) - never merely because
# the crew session doesn't currently exist. Strays are adopted first, so a
# member whose window sits in a prefix-sibling session is moved home rather
# than flagged died - wm_tmux_adopt_strays' own has-session guard makes it
# a no-op when the crew session is absent, which is safe here: the #44
# hazard it guards against is now avoided by reconcile's own prefix-scoped
# input regardless (see wm_tmux_prefix_windows_csv's own comment for why
# this is scoped to the prefix family rather than the whole server).
if wm_tmux_reachable; then
  wm_tmux_adopt_strays
  wm_state reconcile --windows "$(wm_tmux_prefix_windows_csv)" >/dev/null
fi
# Herdr inventory is read-only during reconciliation, and gathered from every
# session a live Herdr member actually names, not just this shell's own
# ambient $HERDR_SESSION. A session whose read fails is dropped from the
# gather (not the whole pass) and left un-judged this call via
# --inventory-sessions, so one broken session can never mask every other
# session's own deaths; a successful empty inventory is still authoritative
# for whichever sessions it did cover.
_herdr_roster="$(wm_state crew-list --all --json 2>/dev/null)"
if printf '%s' "$_herdr_roster" | grep -q '"backend": "herdr"'; then
  wm_backend_herdr_reconcile_inventory "$_herdr_roster"
  wm_state reconcile --inventory "$WM_HERDR_RECONCILE_INVENTORY" --inventory-backends herdr \
    --inventory-sessions "$WM_HERDR_RECONCILE_SESSIONS" >/dev/null
fi

# Default the owner scope to the caller (wingman = "", a lead = its own id) so a
# bare crew-list shows only direct reports. An explicit --owner/--tree overrides;
# --all-owners is a bin-only escape hatch that drops the scope for a flat view.
inject=1
pass=()
for a in "$@"; do
  case "$a" in
    --owner|--tree) inject=0; pass+=("$a") ;;
    --all-owners)   inject=0 ;;   # bin-only: show every layer, unscoped
    *)              pass+=("$a") ;;
  esac
done

# Build the final arg vector. Guard every array expansion with a length check:
# bash 3.2 errors on "${arr[@]}" for an empty array under `set -u`.
if [ "$inject" = 1 ]; then
  if [ "${#pass[@]}" -gt 0 ]; then
    set -- --owner "${WINGMAN_CREW_ID:-}" "${pass[@]}"
  else
    set -- --owner "${WINGMAN_CREW_ID:-}"
  fi
elif [ "${#pass[@]}" -gt 0 ]; then
  set -- "${pass[@]}"
else
  set --
fi

wm_state crew-list "$@"
