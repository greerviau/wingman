#!/usr/bin/env bash
# wingman - optional convenience launcher.
# cd into the wingman repo and start the resolved orchestrator agent (claude
# by default) with the discovered project roots added via --add-dir, so
# wingman's own occasional light cross-project reads don't prompt. Discovery
# and spawning work with or without this launcher.
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"
. "$WM_LIB/agent.sh"
. "$WM_LIB/guard-transport.sh"

# Ensure state home + a fresh-enough project cache exist.
wm_state init >/dev/null
"$WM_BIN/discover-projects" --quiet >/dev/null 2>&1 || true

# A fresh id per wingman run, stamped and exported so every crew member spawned
# during this run (bin/spawn-crew embeds it into the generated launch script,
# alongside WINGMAN_HOME) can tell whether a cached answer in
# preferences.json (the onboarding-preference store) was written during THIS
# run or a stale prior one. uuidgen if available (matches spawn-crew's own session-id
# generation), else a python uuid fallback - either way just needs to be unique
# per run, not cryptographically meaningful.
if wm_have uuidgen; then WINGMAN_RUN_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"; else
  WINGMAN_RUN_ID="$(wm_py -c 'import uuid;print(uuid.uuid4())')"
fi
export WINGMAN_RUN_ID

# Orchestrator CLI selection, separate from crew's $WM_AGENT/[harness.agent]
# so changing crew's default never changes the orchestrator's. Defaults to claude.
_orch_agent="${WM_ORCH_AGENT:-claude}"
# wm_agent_resolve's own wm_die would otherwise leave no durable trace under
# systemd (bin/wingman's stderr goes to a pane destroyed moments later).
if [ ! -f "$WM_LIB/agents/$_orch_agent.sh" ]; then
  _oaf_msg="unknown orchestrator agent '$_orch_agent' (from \$WM_ORCH_AGENT) - no descriptor at bin/lib/agents/$_orch_agent.sh."
  wm_launch_failure "orchestrator agent" "$_oaf_msg"
  wm_die "$_oaf_msg
Fix \$WM_ORCH_AGENT (or unset it to use claude), then start wingman again. This failure was also recorded in $WM_HOME/last-launch-failure."
fi
wm_agent_resolve "$_orch_agent"

# Registers this pane for watch-fleet's Remote-Control drop watch (see
# self_pane_check) only when the resolved adapter sets WM_AGENT_REMOTE_CONTROL_FLAG; clears any stale pane/hash/fired files from a prior adapter otherwise.
if [ -n "${TMUX_PANE:-}" ] && [ -n "$WM_AGENT_REMOTE_CONTROL_FLAG" ]; then
  printf '%s\n' "$TMUX_PANE" > "$WM_HOME/self-pane" 2>/dev/null
else
  rm -f "$WM_HOME/self-pane" "$WM_HOME/self-pane.hash" "$WM_HOME/self-pane.fired"
fi

# Start the tmux-server liveness guardian (issue #218): the shared tmux
# server behind $TMUX_PANE above has twice died with its whole cgroup scope
# torn down and zero preceding journal trace, taking wingman-main and every
# crew window down with it in the same instant (they are all just sessions
# on the one shared server socket). Nothing that lives inside that same
# server can be the safety net for its own death, so this is launched
# scope-wrapped exactly like wm_tmux_scoped already wraps the tmux server
# itself - a one-off transient-unit invocation, not an installed systemd
# unit - so it survives in a cgroup genuinely separate from whatever just
# died. bin/lib/tmux-guardian.sh is idempotent (it exits immediately if a
# live instance is already running for this $WINGMAN_HOME), so calling it
# unconditionally on every startup - a deliberate restart, a crash recovery,
# or the very first boot - never spawns a duplicate. Best-effort, like the
# self-pane registration above: no systemd-run available just means weaker
# (but still better than nothing) protection, never a launch failure.
#
# `setsid` is not optional here: a bare `systemd-run --user --scope -- CMD &`
# puts CMD in a separate cgroup but leaves it in the SAME terminal session as
# this pane, still a member of the controlling tty's foreground process
# group. When the tmux server dies, its ptys close and the kernel sends
# SIGHUP to that foreground group - the guardian would die with zero events
# written, exactly the failure it exists to catch, with the cgroup isolation
# doing nothing to prevent it (cgroups and terminal sessions are unrelated
# kernel concepts; only setsid detaches the latter). Reproduced directly:
# without setsid, killing the tracked server produces zero server-died
# events; with it, one. The daemon's own HUP trap (tmux-guardian.sh) is
# defense in depth, not a substitute for this.
if [ -n "${TMUX_PANE:-}" ] && wm_have tmux; then
  if wm_have systemd-run && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -e "${XDG_RUNTIME_DIR}/systemd/private" ]; then
    systemd-run --user --scope --collect --quiet -- setsid "$WM_LIB/tmux-guardian.sh" --daemon >/dev/null 2>&1 &
  else
    setsid "$WM_LIB/tmux-guardian.sh" --daemon >/dev/null 2>&1 < /dev/null &
  fi
fi

# Collect --add-dir args from the discovered roots.
adddirs=""
while IFS= read -r root; do
  [ -n "$root" ] && adddirs="$adddirs --add-dir $root"
done <<EOF
$("$WM_BIN/discover-projects" --roots 2>/dev/null)
EOF

# Exported so the orchestrator's own documented arm command
# ($WINGMAN_BIN/watch-fleet) is cwd-independent exactly like a lead's
# (bin/spawn-crew and bin/crew-resume already export both into every crew
# launch) - without this, a bare `bin/watch-fleet` resolves against whatever
# cwd this session happens to be in after any earlier `cd`, which is exactly
# the drift issue #214's Defect C reports. $CLAUDE_PROJECT_DIR is not a fix
# for this: it is hook-only and unset in an ordinary session's own tool
# calls (verified directly - see the plan this fixes).
export WINGMAN_BIN="$WM_BIN"
export WINGMAN_REPO="$WM_REPO"

cd "$WM_REPO" || wm_die "cannot cd into wingman repo: $WM_REPO"

# --- the second capability gate: fleet continuity (the orchestrator-guard-
# transports plan, §5.5) -------------------------------------------------
# Deterministic, reads only descriptor state, and has no side effects - run
# BEFORE the guard install below, which writes to the operator's home
# directory. Running the install first would mean a single curious
# WM_ORCH_AGENT=codex run permanently registers wingman's guards in the
# human's own global codex/grok/opencode config even though the launch
# always refuses right after - and no-watcher-kill/no-foreground-watcher/
# no-foreground-poll-loop have no crew-id gating, so they would start
# denying that human's own while/sleep loops in unrelated repos, forever,
# from a launch that never once succeeded.
#
# Named at its true strength: for every one of the four non-Claude adapters,
# wingman's wake loop (asyncRewake on a Stop-hook entry, run_in_background
# on a Bash tool call) has no wired equivalent - this is a capability that
# has not been built, not one that was shown to be impossible (pi's own
# extension API demonstrably has the underlying primitives for one -
# docs/analysis/2026-08-17-pi-wake-loop-probe/ - building it is deliberately
# out of this effort's scope).
if [ -z "$WM_AGENT_CONTINUITY_TRANSPORT" ]; then
  _ct_msg="the resolved orchestrator agent '$WM_AGENT_DISPLAY_NAME' (WM_ORCH_AGENT=${WM_ORCH_AGENT:-claude}) has a guard transport ('$WM_AGENT_GUARD_TRANSPORT'), but wingman has no fleet-continuity transport built for it: nothing re-invokes the session after a blocking wait, so the wake loop cannot run and this orchestrator could not wake itself. This is a capability that has not been built, not one that was shown to be impossible. Unset WM_ORCH_AGENT (or set it to claude) to run the orchestrator on Claude Code."
  wm_launch_failure "continuity transport" "$_ct_msg"
  wm_die "$_ct_msg"
fi

# --- reconcile and verify guard hooks for the resolved orchestrator adapter --
# A merged guard hook is only active once it is registered through the
# resolved orchestrator adapter's own guard-hook dispatch mechanism
# (WM_AGENT_GUARD_TRANSPORT), and only PROVEN active once the shared self-
# test (bin/lib/guard-transport.sh) has executed it against a known-deny and
# known-allow fixture and observed both verdicts. Fail-closed and pre-exec:
# the orchestrator's own guards must bind before ITS first tool call, not
# merely before it spawns its first crew member. The failure sink makes the
# refusal observable even under systemd, where bin/wingman's own stderr
# never reaches anyone (see wm_launch_failure's own comment).
#
# The refusal claims only that a guard transport EXISTS, never that the
# agent "has working guard enforcement" - for codex and grok this proves
# registration plus an executed guard command; for opencode a parsed plugin
# file plus an executed guard command; none of that alone proves the CLI
# invokes it on a real tool call (the registration-versus-enforcement
# distinction bin/lib/sync-user-hooks.py's own module docstring warns
# about). Hands-on verification against each real CLI (recorded per
# transport in bin/lib/agents/*.sh) is what closes that gap.
_gt_err="$(wm_guard_transport_sync "$WM_AGENT_GUARD_TRANSPORT" "$WM_REPO")" || {
  wm_launch_failure "guard transport" "$_gt_err"
  wm_die "could not wire wingman's guard hooks for '$WM_AGENT_DISPLAY_NAME' (guard transport '$WM_AGENT_GUARD_TRANSPORT'): $_gt_err
Fix the reported problem, or run 'bin/doctor -y' if this is the claude-json transport, then start wingman again. This failure was also recorded in $WM_HOME/last-launch-failure."
}

rm -f "$WM_HOME/last-launch-failure"   # both gates passed; the file means "last attempt refused"

# --- checkout-freshness advisory (issue #241) ---------------------------------
# Registration drift (above) is now impossible; deployment drift - this
# checkout itself lagging origin/main - is not, and nothing here should ever
# auto-pull a checkout a human may be mid-edit on. Advisory only: gated on the
# "stale:" prefix in stdout, never on exit status, since the script also exits
# non-zero (printing "error:...") when offline or detached - neither of which
# is something this warning should ever fire for.
_gfc_out="$(REPO_DIR="$WM_REPO" timeout 15 "$WM_LIB/git-freshness-check.sh" 2>/dev/null)"
case "$_gfc_out" in
  stale:*)
    wm_warn "this wingman checkout is behind origin/main - guard fixes that have merged are not running here. Run: git -C $WM_REPO pull --ff-only && systemctl --user restart wingman.service"
    ;;
esac

# $CLAUDE_PROJECT_DIR's own generic equivalent (plan §5.3) - the field every
# guard dialect's own GuardInput prefers, since cwd/workspaceRoot drift the
# moment a session cd's. bin/wingman already knows the value and has already
# cd'd there above, so it exports this unconditionally, for every adapter -
# claude's own branch exports (and reads) $CLAUDE_PROJECT_DIR unaffected.
export WINGMAN_PROJECT_DIR="$WM_REPO"

# Applies the resolved adapter's own guard-transport environment
# (WM_AGENT_GUARD_ENV - e.g. GROK_CLAUDE_HOOKS_ENABLED=0 for grok) and unsets
# whatever WM_AGENT_ENV_UNSET names (e.g. CLAUDECODE for every non-claude
# adapter), in THIS process, right before exec - see bin/lib/agent.sh's own
# wm_agent_apply_guard_env for why this one deliberately does not apply
# WM_AGENT_ENV_PREFIX (that field carries crew-side settings this launch
# must not inherit as a side effect).
wm_agent_apply_guard_env

# shellcheck disable=SC2086
exec $WM_AGENT_BIN $adddirs $WM_AGENT_GUARD_LAUNCH_FLAGS "$@"
