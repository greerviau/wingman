#!/usr/bin/env bash
# pr-watch - the crew-level wake loop: the build crew's analog of watch-fleet.
#
# A crew Claude session, once its turn ends, is idle and cannot rouse itself - the
# same constraint wingman solves for itself with watch-fleet. So a build member,
# after opening its PR, arms THIS script as a harness-tracked background task (e.g.
# Bash run_in_background, never detached). It BLOCKS - polling the PR via the forge
# CLI, absorbing benign no-change polls for free - and EXITS with one reason line
# the instant an actionable PR event occurs. Because the harness tracks it, that
# exit re-invokes the crew session, which acts on the reason (fix CI, address +
# reply to review, or clean up on merge/close) and arms exactly one fresh cycle.
#
# NEVER in the foreground of the arming Bash call, and never detached (nohup/
# setsid/a trailing &): this script blocks until an event fires - that is its
# entire wake mechanism - so a foreground arm wedges the calling session
# indefinitely (issue #202), the same failure watch-fleet itself is exposed
# to. If you cannot arm it as a harness-tracked background task, arm nothing:
# no watcher at all is strictly better than a foreground one. hooks/
# no-foreground-watcher-guard.sh mechanically enforces this at the tool-call
# boundary.
#
# Events (one per exit, highest priority first):
#   merged: <pr>                  PR merged            -> crew cleans up, sets done
#   closed: <pr>                  PR closed unmerged   -> crew cleans up, sets done
#   changes-requested: <pr>       a review requested changes
#   ci-failed: <pr> <checks>      a required check concluded failure
#   conflict: <pr>                the base branch moved and the PR now conflicts
#   comment: <pr> <n> new         new review/issue comment(s) since last handled
#   merge-ready: <pr>             PR settled green and mergeable (or no CI) AND
#                                 this session's own crew record carries
#                                 allow_merge:true -> attempt the merge now (see
#                                 playbooks/_delivery.md, "Merge authorization").
#                                 An empty statusCheckRollup only counts as
#                                 "settled" when this checkout has no
#                                 .github/workflows/ file at all (issue #274) -
#                                 for a repo known to have CI, an empty rollup
#                                 on an already-confirmed head means checks
#                                 exist but are degraded/not reporting, not
#                                 resolved. Independent of that local heuristic,
#                                 when the forge confirms a NON-zero checkSuite
#                                 count for the exact head commit, an empty
#                                 rollup is never settled either, even without
#                                 --has-ci-config - checks are registered for
#                                 this commit but have not reported yet
#                                 (issue #259).
#   checks-passed: <pr>           the same settle, but WITHOUT allow_merge -> crew
#                                 moves to review instead
#
# A cursor at $WINGMAN_HOME/pr/<crew-id>.json records what has already been
# surfaced, so a persistently-red build or an already-seen comment does not
# re-fire, and THIS session's own replies never wake it - identified by an
# anchored `<!-- wingman-crew:<id> -->` marker matching its own
# $WINGMAN_CREW_ID, not by login alone (every crew session shares one forge
# login, issue #50; login alone would also drop the operator's own genuine
# comments, issue #118, and a different crew member's own genuine review,
# issue #59). Firing advances only the fired dimension, so a co-occurring
# lower-priority event still surfaces next cycle.
#
# A defensive re-arm on the same PR is a no-op, not a second rival loop: the
# pidfile+beacon shape `bin/crew-ask await` already uses guards this loop too
# (issue #180), keyed by $WINGMAN_CREW_ID (a member watches at most one PR at
# a time). A second arm that finds the first cycle's pid alive and its beacon
# fresh prints `healthy` and exits immediately.
#
# Each poll also re-reads this session's OWN crew.json record (`wm_state
# crew-get`) for its live `allow_merge` value, so a mid-flight grant (the
# ordinary way merge autonomy actually gets granted - after a human or lead
# already sees the PR sitting green and approved) is picked up on the very
# next poll, with no dependency on any further PR-side event ever occurring.
#
# Forge boundary: everything forge-specific is the `gh` calls below, isolated here
# exactly as the agent launch line is isolated in spawn-crew. Point WM_GH at another
# binary (or a wrapper) to retarget; swap this whole script for a non-GitHub forge.
# bash-3.2-safe.
#
# Usage:
#   pr-watch --pr <url-or-number>   arm one cycle: block until an actionable PR
#                                   event, then print the reason and exit. Run as a
#                                   harness-tracked background task.
#   pr-watch --pr <n> --once        poll exactly once (for testing); print an event
#                                   if one is pending, else nothing, and exit.
set -u
. "$(dirname "$0")/lib/common.sh"

GH="${WM_GH:-gh}"
PR=""; ONCE=0
INTERVAL="${WM_PR_WATCH_INTERVAL:-30}"   # CI/reviews move in minutes, not seconds
while [ $# -gt 0 ]; do
  case "$1" in
    --pr)    PR="$2"; shift 2 ;;
    --once)  ONCE=1; shift ;;
    -h|--help) sed -n '2,53p' "$0"; exit 0 ;;
    *)       wm_die "unknown arg: $1" ;;
  esac
done
[ -n "$PR" ] || wm_die "usage: pr-watch --pr <url-or-number>"
[ -n "${WINGMAN_CREW_ID:-}" ] || wm_die "WINGMAN_CREW_ID must be set (pr-watch runs inside a crew session)"
wm_have "$GH" || wm_die "'$GH' not found (set WM_GH to your forge CLI)"

wm_state init >/dev/null
CURDIR="$WM_HOME/pr"
mkdir -p "$CURDIR"
CURSOR="$CURDIR/$WINGMAN_CREW_ID.json"
PR_EVAL="$WM_LIB/pr-eval.py"

# The authenticated login. Combined with $WINGMAN_CREW_ID (below) and each
# comment/review's `<!-- wingman-crew:<id> -->` marker, identifies THIS
# session's own replies so they never wake it - see pr-eval.py's --my-crew-id
# doc. Best effort: an empty login just means no self-filtering.
ME="$($GH api user --jq .login 2>/dev/null || true)"

# Repo-level static fact (issue #274): does this checkout have ANY GitHub
# Actions workflow file at all? Computed once per arm (not per poll - a
# structural fact, not something that changes on a 30s cadence; each
# re-arm after handling an event re-reads it fresh, so a workflow file
# added mid-effort is picked up on the very next arm, not never).
# Overridable via WM_PR_WATCH_WORKFLOWS_DIR so a test harness can point
# this at an isolated fixture directory instead of the ambient checkout's
# own .github/workflows (see tests/pr-watch.test.sh).
_wf_dir="${WM_PR_WATCH_WORKFLOWS_DIR:-}"
if [ -z "$_wf_dir" ]; then
  _toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$_toplevel" ] && _wf_dir="$_toplevel/.github/workflows"
fi
HAS_CI=0
if [ -n "$_wf_dir" ] && [ -d "$_wf_dir" ] \
    && find "$_wf_dir" -maxdepth 1 \( -name '*.yml' -o -name '*.yaml' \) -print -quit 2>/dev/null | grep -q .; then
  HAS_CI=1
fi

# Once-per-arm latch (issue #259) for the checkSuite forge-signal warning
# below - a marker FILE, not a shell variable: poll_once() is invoked via
# command substitution (`if reason="$(poll_once)"`), which runs the whole
# function body in a subshell, so a plain variable assignment made inside it
# is discarded the instant that subshell exits. A file write is real
# filesystem state and survives the subshell exiting exactly the way
# $_pr_file/$_cs_file already do.
CS_WARNFILE="$CURDIR/$WINGMAN_CREW_ID.cs-warned"
rm -f "$CS_WARNFILE"

# One poll: fetch PR state + inline review comments, ask pr-eval for an event.
# Prints the reason line (and returns 0) iff there is a fresh actionable event.
poll_once() {
  _pr_json="$($GH pr view "$PR" \
    --json state,mergedAt,statusCheckRollup,reviews,comments,number,url,mergeable,mergeStateStatus,headRefOid \
    2>/dev/null)" || return 1
  [ -n "$_pr_json" ] || return 1

  # Inline (code-thread) review comments live in the REST API, not `gh pr view`.
  # Resolve owner/repo from the checkout and the PR number, then fetch them; a
  # failure here degrades gracefully to issue-comments + reviews only.
  _rc_file=""
  _nwo="$($GH repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
  _meta="$(printf '%s' "$_pr_json" | wm_py -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("number") or "")
print("1" if not (d.get("statusCheckRollup") or []) else "")
' 2>/dev/null)"
  _num="$(printf '%s\n' "$_meta" | sed -n 1p)"
  _empty_rollup="$(printf '%s\n' "$_meta" | sed -n 2p)"
  if [ -n "$_nwo" ] && [ -n "$_num" ]; then
    _rc="$($GH api "repos/$_nwo/pulls/$_num/comments" --paginate 2>/dev/null || true)"
    if [ -n "$_rc" ]; then
      _rc_file="$CURDIR/$WINGMAN_CREW_ID.rc.json"
      printf '%s' "$_rc" > "$_rc_file"
    fi
  fi

  _pr_file="$CURDIR/$WINGMAN_CREW_ID.pr.json"
  printf '%s' "$_pr_json" > "$_pr_file"

  # This session's OWN crew.json record, read fresh every poll so a mid-flight
  # allow_merge grant (the ordinary way it actually gets granted - after the PR
  # is already sitting green) is picked up on the very next cycle, not just at
  # arm time. Best effort: a lookup failure (record not found, e.g. the very
  # first poll of a fresh spawn racing crew-add) just means no grant is visible
  # yet - pr-eval.py already treats a missing/unreadable --crew-record as
  # allow_merge:false, the safe default.
  _crew_file=""
  _crew_json="$(wm_state crew-get --id "$WINGMAN_CREW_ID" 2>/dev/null || true)"
  if [ -n "$_crew_json" ]; then
    _crew_file="$CURDIR/$WINGMAN_CREW_ID.crew.json"
    printf '%s' "$_crew_json" > "$_crew_file"
  fi

  _has_ci_flag=""
  [ "$HAS_CI" = 1 ] && _has_ci_flag="--has-ci-config"

  # checkSuite forge signal (issue #259): only fetch when the rollup is
  # empty - the only case where it can change the outcome. gh pr view --json
  # has no checkSuites field, so this needs its own GraphQL call; the raw
  # response is handed to pr-eval.py unparsed (same shape as
  # --review-comments/--crew-record) so the oid cross-check against this
  # poll's own headRefOid lives in one place, in Python, next to the rest of
  # the settle-gate logic. A failed/empty/skipped call just omits the flag -
  # pr-eval.py already treats a missing --check-suites-json as "forge signal
  # unavailable" and falls back to --has-ci-config (issue #274), the safe
  # pre-#259 default. A durably-failing call is warned about once per arm
  # cycle (not every poll) so it is never a silent, permanent no-op - see
  # $CS_WARNFILE above, a marker FILE (not a shell variable - poll_once()
  # is invoked via command substitution, `if reason="$(poll_once)"`, which
  # runs the whole function body in a subshell; any plain variable
  # assignment made inside it is discarded the instant that subshell exits,
  # so a would-be `_cs_warned=1` set here would never be visible on the next
  # poll and this would warn every 30s for the watcher's whole life instead
  # of once. A file write is real filesystem state and survives the
  # subshell exiting exactly the way $_pr_file/$_cs_file already do below).
  _cs_file=""
  if [ -n "$_empty_rollup" ] && [ -n "$_nwo" ] && [ -n "$_num" ]; then
    _cs_json="$($GH api graphql -f query='
      query($owner:String!,$repo:String!,$number:Int!){
        repository(owner:$owner,name:$repo){
          pullRequest(number:$number){
            commits(last:1){nodes{commit{oid checkSuites(first:1){totalCount}}}}
          }
        }
      }' -f owner="${_nwo%%/*}" -f repo="${_nwo#*/}" -F number="$_num" 2>/dev/null || true)"
    if [ -n "$_cs_json" ]; then
      _cs_file="$CURDIR/$WINGMAN_CREW_ID.checksuites.json"
      printf '%s' "$_cs_json" > "$_cs_file"
    elif [ ! -f "$CS_WARNFILE" ]; then
      wm_warn "pr-watch: checkSuite forge signal unavailable (gh api graphql failed or returned nothing this poll) - falling back to --has-ci-config; will keep retrying silently on later polls (this warning fires once per arm cycle)"
      : > "$CS_WARNFILE"
    fi
  fi

  _reason="$(wm_py "$PR_EVAL" --pr-json "$_pr_file" \
    ${_rc_file:+--review-comments "$_rc_file"} \
    ${_crew_file:+--crew-record "$_crew_file"} \
    ${_cs_file:+--check-suites-json "$_cs_file"} \
    --cursor "$CURSOR" --me "$ME" --my-crew-id "$WINGMAN_CREW_ID" $_has_ci_flag 2>/dev/null)"
  [ -n "$_reason" ] || return 1
  printf '%s\n' "$_reason"
  return 0
}

if [ "$ONCE" = 1 ]; then
  poll_once || true
  exit 0
fi

# --- the blocking loop ------------------------------------------------------
# Liveness beacon (issue #187): touched every iteration of the REAL blocking
# loop only, never in --once mode above, so watch-fleet's bounded-resurface
# check (wm_state review-resurface-check) can tell "a pr-watch cycle is
# actively polling this member's PR right now" from "nothing is" - a member
# with a fresh beacon keeps today's once-only review announcement, while one
# with none (or a stale one, the loop having exited or died) becomes eligible
# for a bounded reminder. Same sanitization idiom as pane-tail-<id>.txt et al.
_key="$(printf '%s' "$WINGMAN_CREW_ID" | tr -c 'A-Za-z0-9._-' '_')"
BEATFILE="$WM_HOME/pr-watch-$_key.beat"
PIDFILE="$WM_HOME/pr-watch-$_key.pid"

# --- singleton guard (issue #180) -------------------------------------------
# A live cycle (pid alive + beacon touched within grace) already covers this
# PR, so a second arm stands down instead of starting a rival loop - the same
# pidfile+beacon shape bin/crew-ask await already uses (:198-215), keyed by
# $WINGMAN_CREW_ID (a member watches at most one PR at a time, so the PR
# number is not part of the key). Unlike watch-fleet's identity-verified,
# atomically-claimed guard (issue #237), this has no atomic mkdir claim and no
# takeover: pr-watch is armed and re-armed by the SAME crew session, never
# adopted across a run boundary, so that machinery would solve a problem this
# loop doesn't have. See the plan's "Why the lighter shape" section for the
# residual TOCTOU window this accepts, and why it's an accepted tradeoff here.
WM_PR_WATCH_GRACE="${WM_PR_WATCH_GRACE:-90}"   # comfortably above one poll_once() + one INTERVAL (default 30s)
if [ -f "$PIDFILE" ] && [ -f "$BEATFILE" ]; then
  _p="$(cat "$PIDFILE" 2>/dev/null)"
  if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
    _bm="$(wm_py -c 'import os,sys;print(int(os.path.getmtime(sys.argv[1])))' "$BEATFILE" 2>/dev/null)"
    if [ -n "$_bm" ] && [ $(( $(date +%s) - _bm )) -lt "$WM_PR_WATCH_GRACE" ]; then
      wm_ok "pr-watch: healthy pid=$_p (crew $WINGMAN_CREW_ID already watching PR $PR) - one cycle is live; nothing to do. This pid is the EXISTING watcher, never a target to stop or kill."
      exit 0
    fi
  fi
fi
echo $$ > "$PIDFILE"
: > "$BEATFILE" || true
trap 'rm -f "$PIDFILE"; exit 0' INT TERM
wm_ok "pr-watch: armed pid=$$ (crew $WINGMAN_CREW_ID, pr $PR, polling every ${INTERVAL}s until an event fires)"

# Forensics only - prevents nothing (issue #202: a foreground and a
# backgrounded Bash call are indistinguishable from inside this process, so
# nothing here can detect or refuse either way - only hooks/
# no-foreground-watcher-guard.sh, at the tool-call boundary, can). Written to
# stderr (wm_warn) so a caller capturing this script's stdout output (the
# eventual reason line) never sees it. If you are reading this line in a
# FOREGROUND tool result, this session is already wedged: this script blocks
# until an event fires, so nothing after this line will ever run.
wm_warn "pr-watch: if you are seeing this line in a FOREGROUND tool result, this session is already wedged (issue #202) - re-arm as a harness-tracked background task (run_in_background: true) instead. This line is forensics only and prevents nothing."

# Top-of-loop check: an event already pending the instant a fresh cycle is armed
# fires immediately (at-least-once across the crew's re-arms), mirroring watch-fleet.
while :; do
  : > "$BEATFILE"
  if reason="$(poll_once)"; then
    printf '%s\n' "$reason"
    rm -f "$PIDFILE"
    exit 0
  fi
  sleep "$INTERVAL"
done
