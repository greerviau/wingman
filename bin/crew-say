#!/usr/bin/env bash
# crew-say - send a follow-up message (an answer to a blocker, a course
# correction, a peer hand-off) into a crew member's live claude session via tmux.
# The session resumes with full context.
#
# Delivery can be refused (exit 1, via wm_die) rather than guessed: if the
# target's pane looks like a permission/confirmation dialog rather than an idle
# chat input, wm_tmux_send_message (lib/common.sh) sends nothing rather than risk
# the message/Enter being consumed as an answer to that dialog. Resolve the dialog
# (bin/crew-takeover <id>) and retry.
#
# Team guardrail: collaboration stays within a team. The caller (identified by its
# own $WINGMAN_CREW_ID; empty for wingman) may message only:
#   - its own direct reports        (wingman -> its top level; a lead -> its workers)
#   - a sibling under the same lead  (worker <-> worker peer collaboration)
#   - its own lead                   (a worker talking up its chain)
# Anything else is refused so a worker cannot reach arbitrary crew elsewhere in the
# tree. Discover legitimate siblings with `crew-list --owner <your-own-parent>`.
# The verdict logic lives in wm_team_guardrail (lib/common.sh), shared with
# crew-ask so both honour one policy. Pass --force (or set WM_TEAM_FORCE=1, or the
# legacy WM_CREW_SAY_FORCE=1) to override, e.g. for a human operator.
#
# Pilot-constraint acknowledgment (issue #192): if the target's crew record
# carries one or more entries in `constraints` (wm_state crew-add
# --constraint, or a later crew-set --add-constraint), this call is refused
# unless --ack-constraints is also passed - the refusal reprints every
# recorded constraint. This does not try to judge whether THIS message
# actually relaxes a constraint (that would require judging arbitrary
# natural language); it gates messaging a constrained target at all, so the
# constraint text is unavoidably back in view before the message is sent, on
# every single call, not just remembered from whenever it was first given.
# Unlike --force, there is no env-var bypass - see CLAUDE.md, "A pilot
# constraint is not yours to relax."
#
# Usage: crew-say [--force] [--ack-constraints] <id> "<message>"
# bash-3.2-safe.
set -u
. "$(dirname "$0")/lib/common.sh"
. "$(dirname "$0")/lib/agent.sh"

FORCE=0
ACK_CONSTRAINTS=0
while [ "${1:-}" = "--force" ] || [ "${1:-}" = "--ack-constraints" ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --ack-constraints) ACK_CONSTRAINTS=1 ;;
  esac
  shift
done

ID="${1:-}"; MSG="${2:-}"
[ -n "$ID" ] || wm_die "usage: crew-say [--force] [--ack-constraints] <id> \"<message>\""
[ -n "$MSG" ] || wm_die "usage: crew-say [--force] [--ack-constraints] <id> \"<message>\""

# --- team guardrail ---------------------------------------------------------
if [ "$FORCE" != 1 ] && [ -z "${WM_TEAM_FORCE:-}" ] && [ -z "${WM_CREW_SAY_FORCE:-}" ]; then
  CALLER="${WINGMAN_CREW_ID:-}"
  verdict="$(wm_team_guardrail "$CALLER" "$ID")"
  who="${CALLER:-wingman}"
  case "$verdict" in
    deny)
      wm_die "team guardrail: '$who' may only message its own reports, a sibling under the same lead, or its lead (refused '$ID'). Find siblings with crew-list --owner <your-parent>; pass --force to override." ;;
    ok|no-target) ;;
    *)
      # `error` or empty: the roster could not be read, so the policy could
      # not run. Refuse loudly (fail closed) rather than silently skipping
      # the guardrail; a human can still override with --force.
      wm_die "team guardrail could not run: the roster is unreadable (state engine or crew.json broken), so '$who' -> '$ID' cannot be checked. Fix the state engine (try: \$WINGMAN_STATE crew-list), or pass --force to override as a human." ;;
  esac
fi

# --- pilot-constraint acknowledgment gate (issue #192) ----------------------
if [ "$ACK_CONSTRAINTS" != 1 ]; then
  CONSTRAINTS_TEXT="$(wm_state crew-get --id "$ID" 2>/dev/null | wm_py -c '
import sys, json
try:
    r = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for c in (r.get("constraints") or []):
    t = c.get("text")
    if t:
        print("  - %s (recorded %s)" % (t, c.get("set_at") or "unknown time"))
' 2>/dev/null)"
  if [ -n "$CONSTRAINTS_TEXT" ]; then
    wm_die "'$ID' has standing constraint(s) the human personally stated for this effort:
$CONSTRAINTS_TEXT
A follow-up message must not relax any of these - only the human can (CLAUDE.md, \"A pilot constraint is not yours to relax\"). An instruction about budget, spend, speed, or a deadline is never itself authority to change working method. If this message does not touch them, resend with --ack-constraints. If the human's own words changed the constraint, first run: \$WINGMAN_STATE crew-set --id $ID --clear-constraints --confirm-clear [--add-constraint \"<new text>\"] (clearing a non-empty record without --confirm-clear is itself refused, reprinting what would be erased) - then resend with --ack-constraints."
  fi
fi

BACKEND="$(wm_backend_for_record "$ID")"
ENDPOINT="$(wm_backend_endpoint_for_member "$ID")"
_ENDPOINT_STATE="$(wm_backend_endpoint_state "$BACKEND" "$ENDPOINT")"
[ "$_ENDPOINT_STATE" = alive ] || wm_die "no live $BACKEND endpoint for '$ID' (state: $_ENDPOINT_STATE; see: bin/crew-takeover $ID)"

# Pointer, not payload: a multi-line message, or one past WM_SAY_INLINE_MAX
# chars, is written to a file and only a single-line pointer is typed into the
# pane. tmux typing is the least reliable channel here - embedded newlines
# depend on the CLI's paste heuristics to not submit early, and a partial
# submit silently truncates the message with no way to detect it. A one-line
# pointer has no such failure mode, and the payload file survives for
# re-reading. (This is wingman's own "relay the pointer, not the payload"
# principle applied to its own messaging.)
DELIVER="$MSG"
if wm_needs_pointer "$MSG"; then
  mkdir -p "$WM_HOME/say"
  _msgfile="$WM_HOME/say/$ID-$(date +%s)-$$.md"
  printf '%s\n' "$MSG" > "$_msgfile"
  DELIVER="Message from ${WINGMAN_CREW_ID:-wingman}: read $_msgfile and act on it now - it is a direct message to you, not background material."
fi

wm_backend_send_message "$BACKEND" "$ENDPOINT" "$DELIVER" "$(wm_crew_agent_name "$ID")"
_rc=$?
if [ "$_rc" -eq 0 ]; then
  # Confirmed delivery into $ID's own pane (issue #194): record it so
  # cmd_needs_attention's muffle-window check can later tell an answered
  # blocker from a live one. Best-effort - never gates or fails the send,
  # which has already succeeded by this point.
  wm_state record-delivery --to "$ID" --from "${WINGMAN_CREW_ID:-}" >/dev/null 2>&1
  wm_ok "delivered to $ID"
  exit 0
fi

# Delivery did not confirm (2 = dialog-shaped refusal, 3 = typed but never
# confirmed, 4 = another delivery held the pane's send lock too long, 5 =
# typed but unconfirmed and the pane was busy, 6 = busy pane with a pending
# composer, 7 = the send-lock helper itself failed - not contention, 8 = a
# reentrant send-lock acquisition bug). Queue the message so it is not
# simply dropped: bin/watch-fleet retries the oldest
# queued message per member each poll once the pane looks deliverable again,
# so a pilot answer relayed into a briefly-blocked pane arrives without anyone
# having to remember to retry. The sidecar (sender id, empty for wingman) is
# written BEFORE the payload so a sweep can never observe a payload with no
# sender record (issue #169).
mkdir -p "$WM_HOME/outbox/$ID" "$WM_HOME/outbox-meta/$ID"
_qfile="$WM_HOME/outbox/$ID/$(date +%s)-$$.msg"
printf '%s\n' "${WINGMAN_CREW_ID:-}" > "$WM_HOME/outbox-meta/$ID/$(basename "$_qfile")"
printf '%s\n' "$MSG" > "$_qfile"
_retry_note="the watcher will retry it automatically; if '$ID' ends before that happens, you'll be notified instead of the message silently vanishing."
case "$_rc" in
  2) wm_die "refused: '$ID's pane looks like it is showing a permission/confirmation dialog, not the chat input - typing here risks the message (and Enter) being consumed as an answer to that dialog instead of being submitted as chat text. The message is QUEUED at $_qfile; $_retry_note (or resolve the dialog yourself first: bin/crew-takeover $ID)." ;;
  3) wm_die "unconfirmed: the message was typed into '$ID's pane but the submit never visibly registered - treat it as NOT delivered. The message is QUEUED at $_qfile; $_retry_note" ;;
  5) wm_die "unconfirmed: the message was typed into '$ID's pane but the submit never visibly registered, and the pane was busy (still repainting on its own clock) - likely queued behind its current turn rather than lost outright. The message is QUEUED at $_qfile; $_retry_note" ;;
  6) wm_die "'$ID' is mid-turn with a message already composed in its input box, so nothing was typed. QUEUED at $_qfile; the watcher retries it once the pane clears." ;;
  7) wm_die "not sent: the send-lock helper for '$ID's pane failed unexpectedly (a broken local 'uv'/python 'fcntl' toolchain, not contention) - nothing was typed. The message is QUEUED at $_qfile; $_retry_note (this is worth investigating directly - an ordinary contention refusal would clear on its own; a broken helper will not)." ;;
  8) wm_die "not sent: an internal bug attempted a reentrant send-lock acquisition for '$ID's pane - nothing was typed. The message is QUEUED at $_qfile; $_retry_note (this indicates a programming error, not ordinary contention - please report it)." ;;
  *) wm_die "not sent: another delivery is holding '$ID's pane. The message is QUEUED at $_qfile; $_retry_note" ;;
esac
